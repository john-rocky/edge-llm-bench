# Per-model split of matrices/dashboard-npu-v1-android-s26.cells
# (Qwen3-4B): the session anchor and this model's long-context-1024-gen256 (context 2048) rows on the NPU
# and the GPU only — every row byte-identical to the plan file, which stays the source of the rows. A
# campaign of its own with a 300 s cooldown: one such launch took the S26's battery up 2.1 to 2.9 C on
# 2026-10-08 (past 38 C, the round's stop condition, after three of them 120 s apart). Round mode of
# android/bench/run_campaign.py, one 45-minute device slot:
#   ROUNDS=3 COOLDOWN=300 BENCH_ANDROID_SERIAL=RFGL80R6A6H BENCH_CPU_MASK= BENCH_TEXT_CHECK=1 \
#     ./bench matrix matrices/dashboard-npu-v1-android-s26-qwen4b-1k.cells --platform android \
#     --campaign 2026-10-08-dashboard-npu-v1-s26-qwen4b-1k

android llama.cpp unsloth/Qwen3-0.6B-GGUF short-chat anchor=1 runs=3 file=Qwen3-0.6B-Q4_K_M.gguf

android llama.cpp unsloth/Qwen3-4B-GGUF long-context-1024-gen256 backend=npu engine-build=b11469-snapdragon cooldown=300 file=Qwen3-4B-Q4_K_M.gguf context-tokens=2048
android llama.cpp unsloth/Qwen3-4B-GGUF long-context-1024-gen256 backend=gpu engine-build=b11469-snapdragon cooldown=300 file=Qwen3-4B-Q4_K_M.gguf context-tokens=2048
