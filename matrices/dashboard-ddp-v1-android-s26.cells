# The weekly Developer Device Platform (DDP) slot of the dashboard job (docs/dashboard-autopilot-v1.md
# section 9): the weekly set's Android LiteRT-LM rows on Google's lab Galaxy S26 units (android/ddp/devices.json
# m1q-36, a pool of SM-S942U1 phones; ops/dashboard-v1/schedule.json device s26-ddp), run as Device Run
# sessions by `./bench matrix <this file> --ddp m1q-36` (android/ddp/run_ddp.py: one row = one job of runs=
# launches on one unit, at most 8 jobs a session).
#
# Rows: every `android litert-lm` row of matrices/dashboard-text-v1.cells, byte for byte and in its order
# (the storage halves matrices/dashboard-text-v1-android-{a,b1,b2}.cells carry the same 20 rows byte for
# byte); a change to one of those rows is made here too. Left out, as the DDP route reads them:
# - the session anchor rows (matrices/anchors.cells, and the weekly set's llama.cpp anchor=1 row): DDP has
#   no session anchor (run_ddp skips anchor=1 rows: no-session-anchor-on-ddp); a DDP sitting is admitted on
#   its runs' own marks, the CPU-cap marks and the text check (SESSION.json reason)
# - the llama.cpp, ONNX Runtime GenAI and NPU side-build rows: not wired on DDP (runtime-not-wired-on-ddp,
#   side-build-not-wired-on-ddp)
# Since 2026-10-19 the four Qwen3 0.6B rows run Qwen3-0.6B_dynamic_wi4b32_afp32.litertlm (dynamic INT4, block-32
# weights, FP32 act) without the exclude-on=pixel8a,s26 they carried for qwen3_0_6b_mixed_int4.litertlm (its
# template drops the user turn on LiteRT-LM v0.18.0, google-ai-edge/LiteRT-LM#3688): the route runs them on m1q-36
# (its scheduleKey is s26), as the attached Galaxy S26 does.
# The CPU rows run and are recorded but give no number: the lab units hold their CPU clock ceilings below
# the cpu-cap-rule line from the start (devices.json m1q-36 _note), so the team page takes the GPU rows
# only (litert-bench-dashboard build.py STAND_IN).

android litert-lm litert-community/Qwen3-0.6B short-chat backend=cpu file=Qwen3-0.6B_dynamic_wi4b32_afp32.litertlm
android litert-lm litert-community/Qwen3-0.6B short-chat backend=gpu file=Qwen3-0.6B_dynamic_wi4b32_afp32.litertlm
android litert-lm litert-community/Qwen3-0.6B long-context-1024-gen256 backend=cpu file=Qwen3-0.6B_dynamic_wi4b32_afp32.litertlm context-tokens=2048
android litert-lm litert-community/Qwen3-0.6B long-context-1024-gen256 backend=gpu file=Qwen3-0.6B_dynamic_wi4b32_afp32.litertlm context-tokens=2048
android litert-lm litert-community/Qwen3-1.7B short-chat backend=cpu file=Qwen3_1.7B.litertlm
android litert-lm litert-community/Qwen3-1.7B short-chat backend=gpu file=Qwen3-1.7B_dynamic_wi4b32_afp32.litertlm
android litert-lm litert-community/Qwen3-1.7B long-context-1024-gen256 backend=cpu file=Qwen3_1.7B.litertlm context-tokens=2048
android litert-lm litert-community/Qwen3-1.7B long-context-1024-gen256 backend=gpu file=Qwen3-1.7B_dynamic_wi4b32_afp32.litertlm context-tokens=2048
android litert-lm litert-community/gemma-4-E2B-it-litert-lm short-chat backend=cpu cooldown=300 file=gemma-4-E2B-it.litertlm
android litert-lm litert-community/gemma-4-E2B-it-litert-lm short-chat backend=gpu cooldown=300 file=gemma-4-E2B-it.litertlm
android litert-lm litert-community/gemma-4-E2B-it-litert-lm long-context-1024-gen256 backend=cpu cooldown=300 file=gemma-4-E2B-it.litertlm context-tokens=2048
android litert-lm litert-community/gemma-4-E2B-it-litert-lm long-context-1024-gen256 backend=gpu cooldown=300 file=gemma-4-E2B-it.litertlm context-tokens=2048
android litert-lm litert-community/Qwen3-4B short-chat backend=cpu cooldown=300 file=qwen3_4b_mixed_int4.litertlm exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/Qwen3-4B short-chat backend=gpu cooldown=300 file=qwen3_4b_mixed_int4.litertlm exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/Qwen3-4B long-context-1024-gen256 backend=cpu cooldown=300 file=qwen3_4b_mixed_int4.litertlm context-tokens=2048 exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/Qwen3-4B long-context-1024-gen256 backend=gpu cooldown=300 file=qwen3_4b_mixed_int4.litertlm context-tokens=2048 exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/gemma-4-E4B-it-litert-lm short-chat backend=cpu cooldown=300 file=gemma-4-E4B-it.litertlm exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/gemma-4-E4B-it-litert-lm short-chat backend=gpu cooldown=300 file=gemma-4-E4B-it.litertlm exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/gemma-4-E4B-it-litert-lm long-context-1024-gen256 backend=cpu cooldown=300 file=gemma-4-E4B-it.litertlm context-tokens=2048 exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
android litert-lm litert-community/gemma-4-E4B-it-litert-lm long-context-1024-gen256 backend=gpu cooldown=300 file=gemma-4-E4B-it.litertlm context-tokens=2048 exclude-on=pixel8a:pixel8a-8gb-4b-class-does-not-fit-swap-thrash
