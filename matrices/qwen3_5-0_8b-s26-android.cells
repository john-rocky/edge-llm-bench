# Qwen3.5-0.8B competitive benchmark matrix for Samsung Galaxy S26 (DDP m1q-36), CPU & GPU
# The side builds named here (engine-build= / --engine-build / BENCH_EXECUTORCH_TAG) are not in
# android/engine-pins.json: they are registered by the Google3 competitive-analysis harness, which
# passes its registry with BENCH_EXTRA_PINS (android/bench/run_cell.load_pins).
# - litert-lm (CPU YNNPACK & GPU OpenCL): Google3 build google3-630752d0-ynnpack, run with
#   `run_ddp.py --engine-build google3-630752d0-ynnpack`; XNNPACK hangs on this model's prefill.
#   The export is not on the Hub yet (litert-local id, local=1; models/litert/<file>).
# - llama.cpp: CPU = the pinned flat build; GPU = src-ff5a23376725-snapdragon (OpenCL, a source
#   build of b11721): unsloth/Qwen3.5-0.8B-GGUF Qwen3.5-0.8B-Q4_0.gguf
# - executorch (CPU XNNPACK & GPU Vulkan; BENCH_EXECUTORCH_TAG=v1.5.1-rebuild-648bad71 for the
#   2026-10-27 campaigns): 8da4w group 128, emb 8-bit, ctx 2048

# --- Android: short-chat (context-tokens=2048) ---
android litert-lm litert-local/Qwen3.5-0.8B-wi4b32-afp32-gpu-cpu short-chat backend=cpu engine-build=google3-630752d0-ynnpack ynnpack=1 file=Qwen3.5-0.8B_wi4b32_afp32_gpu_cpu.litertlm context-tokens=2048 local=1
android litert-lm litert-local/Qwen3.5-0.8B-wi4b32-afp32-gpu-cpu short-chat backend=gpu engine-build=google3-630752d0-ynnpack file=Qwen3.5-0.8B_wi4b32_afp32_gpu_cpu.litertlm context-tokens=2048 local=1
android llama.cpp unsloth/Qwen3.5-0.8B-GGUF short-chat file=Qwen3.5-0.8B-Q4_0.gguf context-tokens=2048
android llama.cpp unsloth/Qwen3.5-0.8B-GGUF short-chat backend=gpu engine-build=src-ff5a23376725-snapdragon file=Qwen3.5-0.8B-Q4_0.gguf context-tokens=2048
android executorch own-export/Qwen3.5-0.8B-ET1.5.1-xnnpack-8da4w-emb8-ctx2048 short-chat backend=xnnpack local=1 file=Qwen3.5-0.8B-ET1.5.1-xnnpack-8da4w-emb8-ctx2048.pte recipe=et1.5.1-xnnpack-8da4w-g128-emb8 context-tokens=2048
android executorch own-export/Qwen3.5-0.8B-ET1.5.1-vulkan-8da4w-emb8-ctx2048 short-chat backend=vulkan local=1 file=Qwen3.5-0.8B-ET1.5.1-vulkan-8da4w-emb8-ctx2048.pte recipe=et1.5.1-vulkan-8da4w-g128-emb8 context-tokens=2048

