ios litert-lm litert-community/Ministral-3-3B-Instruct-2512 native-benchmark-1024x256 backend=gpu cooldown=300 context-tokens=2048 cool-wait=120

# ---- i8: Nanbeige4.2-3B, Qwen3.5 4B ----
ios litert-lm litert-community/Nanbeige4.2-3B short-chat backend=gpu runs=2 cooldown=300
ios litert-lm litert-community/Nanbeige4.2-3B native-benchmark-1024x256 backend=gpu cooldown=300 context-tokens=2048 cool-wait=120
ios litert-lm litert-community/Qwen3.5-4B short-chat backend=gpu runs=2 cooldown=300
ios litert-lm litert-community/Qwen3.5-4B native-benchmark-1024x256 backend=gpu cooldown=300 context-tokens=2048 cool-wait=120

# ---- i9: Gemma 4 12B ----
ios litert-lm litert-community/gemma-4-12B-it-litert-lm short-chat backend=gpu runs=2 cooldown=300
ios litert-lm litert-community/gemma-4-12B-it-litert-lm native-benchmark-1024x256 backend=gpu cooldown=300 context-tokens=2048 cool-wait=120
