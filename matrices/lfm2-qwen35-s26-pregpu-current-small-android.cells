android litert-lm litert-community/LFM2.5-350M/int8 native-benchmark-1024x256 backend=gpu engine-build=v0.19.0-pregpu file=./.dashboard/lfm2-qwen35-models/LFM2.5-350M_int8.litertlm context-tokens=2048
