# D-547 (2026-11-04): the check sitting after the iPhone 18 Pro's weekly app was rebuilt on LiteRT-LM v0.19.0 — the
# iPhone's two session-anchor rows of matrices/anchors.cells, byte for byte, as the payload of one dashboard-job
# sitting (`./bench dashboard-job iphone18pro --cells matrices/d547-iphone18pro-anchor-ios.cells --suffix d547check`):
# its anchor phase and its payload both run them, so the records stamp the new app's engines and the next weekly
# sitting has a committed admission reference on the new build.

ios mlx-swift mlx-community/Qwen3-0.6B-4bit short-chat anchor=1 runs=3
ios litert-lm litert-community/Qwen3-0.6B/dynamic_int8 short-chat anchor=1 runs=3
