# Per-model split of matrices/dashboard-npu-v1-android-s26.cells
# (Qwen3-4B): the session anchor and this model's short-chat rows on the NPU and the GPU only —
# every row byte-identical to the plan file, which stays the source of the rows. Its
# long-context-1024-gen256 rows are not in this file: one such launch took the S26's battery past
# 38 C (2026-10-08, Qwen3 4B: +2.1 to +2.9 C per launch), the round's stop condition. One campaign per
# file (one 45-minute device slot), in the round mode of android/bench/run_campaign.py:
#   ROUNDS=3 COOLDOWN=120 BENCH_ANDROID_SERIAL=RFGL80R6A6H BENCH_CPU_MASK= BENCH_TEXT_CHECK=1 \
#     ./bench matrix matrices/dashboard-npu-v1-android-s26-qwen4b-short.cells --platform android \
#     --campaign 2026-10-08-dashboard-npu-v1-s26-qwen4b-short

android llama.cpp unsloth/Qwen3-0.6B-GGUF short-chat anchor=1 runs=3 file=Qwen3-0.6B-Q4_K_M.gguf

android llama.cpp unsloth/Qwen3-4B-GGUF short-chat backend=npu engine-build=b11469-snapdragon cooldown=300 file=Qwen3-4B-Q4_K_M.gguf
android llama.cpp unsloth/Qwen3-4B-GGUF short-chat backend=gpu engine-build=b11469-snapdragon cooldown=300 file=Qwen3-4B-Q4_K_M.gguf
