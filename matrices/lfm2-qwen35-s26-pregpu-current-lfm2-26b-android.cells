android litert-lm litert-community/LFM2-2.6B/int8 native-benchmark-1024x256 backend=gpu engine-build=v0.19.0-pregpu cooldown=300 file=./.dashboard/lfm2-qwen35-models/LFM2-2.6B_int8.litertlm context-tokens=2048
