# Vision-language response-time cells, v1 (2026-09-24) — the second non-LLM task
# family. Task `vl-describe-catcouch-gen64`: ONE pinned CC0 photograph
# (evaldata/vl/cc0-cat-couch-1024/, 1024x682 JPEG, sha256 in manifest.json) plus
# the fixed prompt "Describe this image in one sentence.", answered with at most
# 64 output tokens, through LiteRT-LM's own CLI (`litert_lm_advanced_main`, the
# engine behind the Kotlin / Swift / Python surfaces) with `--benchmark` on so the
# engine reports its own phase clocks while still printing the reply. Everything
# else is the CLI default. The headline is `vlResponseSeconds` — the seconds one
# image costs from request to the last reply byte (image encoding + prefill +
# decode) — with the engine's TTFT and prefill / decode splits beside it, and the
# manifest's keyword rule over the reply as the text check (a rate whose reply
# nobody read is not a measurement). Design and how to build the instrument:
# docs/vl-response-v1.md.
#
# Arms: litert backend is arm identity (litert-lm-cpu / litert-lm-gpu never pool).
# file= names the bundle; the recipe is stated per row from the file name plus
# the repo's litertlm_manifest.json (quant-per-arm-rule / quant-label-rule).
# Order light -> heavy, cpu / gpu interleaved per model (interleave-arms). The
# Qwen3-0.6B MLX short-chat row is the Mac session anchor (anchors.cells).
#
# The instrument is built from LiteRT-LM main@1dadd00c (the asr-rtf-v1 worktree;
# the released macOS CLI binaries carry no image flags). Mac:
# `./bench matrix matrices/vl-response-v1.cells --platform mac`.

mac mlx-swift mlx-community/Qwen3-0.6B-4bit short-chat anchor=1 runs=3

# --- SmolVLM2-500M (SigLIP 512 -> 64 image tokens, SmolLM2-360M decoder; 0.36 GB) ---
mac litert-lm litert-community/SmolVLM2-500M vl-describe-catcouch-gen64 backend=cpu runs=3 file=SmolVLM2-500M.litertlm
mac litert-lm litert-community/SmolVLM2-500M vl-describe-catcouch-gen64 backend=gpu runs=3 file=SmolVLM2-500M.litertlm

# --- LFM2.5-VL-450M int4 (fixB: full image visible on 0.16.x/0.17; SigLIP2 512 -> 256 tokens; 0.41 GB) ---
mac litert-lm litert-community/LFM2.5-VL-450M vl-describe-catcouch-gen64 backend=cpu runs=3 file=LFM2.5-VL-450M_int4_fixB.litertlm
mac litert-lm litert-community/LFM2.5-VL-450M vl-describe-catcouch-gen64 backend=gpu runs=3 file=LFM2.5-VL-450M_int4_fixB.litertlm

# --- InternVL3-1B (InternViT-300M 448 -> 256 tokens, Qwen2.5-0.5B decoder; 0.74 GB) ---
mac litert-lm litert-community/InternVL3-1B vl-describe-catcouch-gen64 backend=cpu runs=3 file=InternVL3-1B.litertlm
mac litert-lm litert-community/InternVL3-1B vl-describe-catcouch-gen64 backend=gpu runs=3 file=InternVL3-1B.litertlm

# --- LFM2.5-VL-1.6B int4 (fixB; 1.3 GB) ---
mac litert-lm litert-community/LFM2.5-VL-1.6B vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=LFM2.5-VL-1.6B_int4_fixB.litertlm
mac litert-lm litert-community/LFM2.5-VL-1.6B vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=LFM2.5-VL-1.6B_int4_fixB.litertlm

# --- Qwen2-VL-2B (1.8 GB) ---
mac litert-lm litert-community/Qwen2-VL-2B vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=Qwen2-VL-2B.litertlm
mac litert-lm litert-community/Qwen2-VL-2B vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=Qwen2-VL-2B.litertlm

# --- Gemma 4 E2B it (the dashboard's LiteRT bundle; multimodal .litertlm; 2.6 GB) ---
mac litert-lm litert-community/gemma-4-E2B-it-litert-lm vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=gemma-4-E2B-it.litertlm
mac litert-lm litert-community/gemma-4-E2B-it-litert-lm vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=gemma-4-E2B-it.litertlm

# Android (2026-09-26): the same CLI built with the NDK (`--config=android_arm64`)
# and driven over adb by scripts/vl_response_android.py, which reads the android
# rows of this file itself (`scripts/vl_response_android.py
# matrices/vl-response-v1.cells --campaign <date>-vl-response-v1-s26`); the
# session anchor is the android rows of anchors.cells, run right before as
# `./bench matrix matrices/anchors.cells --platform android --campaign
# <date>-vl-response-v1-s26-anchor` and judged with the dashboard's admission
# rule. Same image, prompt, budget and flags; GPU = the ML Drift OpenCL
# accelerator from LiteRT-LM main's prebuilt/android_arm64/. Order light ->
# heavy, cpu / gpu interleaved per model.
android litert-lm litert-community/SmolVLM2-500M vl-describe-catcouch-gen64 backend=cpu runs=3 file=SmolVLM2-500M.litertlm
android litert-lm litert-community/SmolVLM2-500M vl-describe-catcouch-gen64 backend=gpu runs=3 file=SmolVLM2-500M.litertlm
android litert-lm litert-community/LFM2.5-VL-450M vl-describe-catcouch-gen64 backend=cpu runs=3 file=LFM2.5-VL-450M_int4_fixB.litertlm
android litert-lm litert-community/LFM2.5-VL-450M vl-describe-catcouch-gen64 backend=gpu runs=3 file=LFM2.5-VL-450M_int4_fixB.litertlm
android litert-lm litert-community/InternVL3-1B vl-describe-catcouch-gen64 backend=cpu runs=3 file=InternVL3-1B.litertlm
android litert-lm litert-community/InternVL3-1B vl-describe-catcouch-gen64 backend=gpu runs=3 file=InternVL3-1B.litertlm
android litert-lm litert-community/LFM2.5-VL-1.6B vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=LFM2.5-VL-1.6B_int4_fixB.litertlm
android litert-lm litert-community/LFM2.5-VL-1.6B vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=LFM2.5-VL-1.6B_int4_fixB.litertlm
android litert-lm litert-community/Qwen2-VL-2B vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=Qwen2-VL-2B.litertlm
android litert-lm litert-community/Qwen2-VL-2B vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=Qwen2-VL-2B.litertlm
android litert-lm litert-community/gemma-4-E2B-it-litert-lm vl-describe-catcouch-gen64 backend=cpu runs=3 cooldown=60 file=gemma-4-E2B-it.litertlm
android litert-lm litert-community/gemma-4-E2B-it-litert-lm vl-describe-catcouch-gen64 backend=gpu runs=3 cooldown=60 file=gemma-4-E2B-it.litertlm
