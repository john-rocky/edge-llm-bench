# Perfetto config for one LLM benchmark process / app run on the Galaxy S26 (Android 16).
# CPU scheduling + frequencies + idle, GPU frequency (kgsl), thermal zones, per-process stats,
# memory, battery/power rails (if the HAL exposes them), and the main + system log buffers.
buffers: { size_kb: 131072 fill_policy: RING_BUFFER }
buffers: { size_kb: 8192 fill_policy: RING_BUFFER }
write_into_file: true
file_write_period_ms: 2000
flush_period_ms: 5000
data_sources: {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/cpu_frequency_limits"
      ftrace_events: "power/gpu_frequency"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "thermal/thermal_temperature"
      ftrace_events: "thermal/cdev_update"
      ftrace_events: "thermal/thermal_zone_trip"
      buffer_size_kb: 32768
      drain_period_ms: 500
      compact_sched { enabled: true }
    }
  }
}
data_sources: {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      proc_stats_poll_ms: 1000
    }
  }
}
data_sources: {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      meminfo_period_ms: 1000
      meminfo_counters: MEMINFO_MEM_AVAILABLE
      meminfo_counters: MEMINFO_MEM_FREE
      meminfo_counters: MEMINFO_CACHED
      meminfo_counters: MEMINFO_SWAP_FREE
      stat_period_ms: 500
      stat_counters: STAT_CPU_TIMES
      cpufreq_period_ms: 500
    }
  }
}
data_sources: {
  config {
    name: "android.power"
    target_buffer: 1
    android_power_config {
      battery_poll_ms: 1000
      battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
      battery_counters: BATTERY_COUNTER_CHARGE
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_VOLTAGE
      collect_power_rails: true
    }
  }
}
data_sources: {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      log_ids: LID_DEFAULT
      log_ids: LID_SYSTEM
      min_prio: PRIO_INFO
    }
  }
}
