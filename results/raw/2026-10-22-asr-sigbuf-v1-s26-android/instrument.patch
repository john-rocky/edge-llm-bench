+package com.google.ai.edge.examples.asr
+
+import android.util.Log
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.google.ai.edge.litert.Accelerator
+import java.io.File
+import java.io.FileInputStream
+import kotlin.time.Duration
+import kotlin.time.Duration.Companion.milliseconds
+import kotlin.time.Duration.Companion.seconds
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * asr-sigbuf-v1 (edge-llm-bench docs/asr-sigbuf-v1.md): the app's file path over WAV files, with the
+ * token ids, time indices and step times of every window. MainActivity.preparePipeline for a "-tdt"
+ * entry (MelSpectroProcessor, HuggingfaceTokenizer, LiteRtRunner with TdtDecoder) and
+ * MainActivity.processFileAudio's steps (FileAudioSource -> AudioPreprocessor.process ->
+ * LiteRtRunner.recognize -> the token sequence -> LevenshteinTokenMerger), one after the other per
+ * window on the test thread (the activity overlaps them in three coroutines). A window's decode time
+ * is the time spent in the token sequence's iterator calls.
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - model: a "-tdt" key of model_metadata.json
+ * - accelerator: cpu, gpu or npu
+ * - manifest: TSV on the phone (id, WAV path relative to the manifest, seconds)
+ * - every, limit: the rows at index 0, every, 2 * every, ..., the first [limit] of them (0 = all)
+ * - warmup_id: a manifest id transcribed once after the load, before the rows (written, marked warmup)
+ * - max_tokens: tokens taken from one window's sequence before the test stops reading it (the
+ *   window is marked capped); default 2000
+ * - pace: none (default) or ceiling (SigbufIo.ceilingWait before every row)
+ * - foreground: front keeps BenchFrontActivity in front while the test runs
+ * - tag: output stem in <external files dir>/sigbuf: <tag>.jsonl (a header line, one line per row),
+ *   <tag>.log.txt (SigbufIo.LogcatTap), <tag>.done
+ */
+@RunWith(AndroidJUnit4::class)
+class SigbufBenchTest {
+
+  private data class Row(val id: String, val wav: File, val seconds: Double)
+
+  @Test
+  fun transcribeFiles() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val modelKey = requireNotNull(args.getString("model")) { "model is required" }
+    require(modelKey.contains("-tdt")) { "$modelKey is not a -tdt entry (TdtDecoder)" }
+    val acceleratorName = (args.getString("accelerator") ?: "cpu").lowercase()
+    val accelerator = SigbufIo.accelerator(acceleratorName)
+    val manifest = File(requireNotNull(args.getString("manifest")) { "manifest is required" })
+    val every = args.getString("every")?.toInt() ?: 1
+    val limit = args.getString("limit")?.toInt() ?: 0
+    val warmupId = args.getString("warmup_id")
+    val maxTokens = args.getString("max_tokens")?.toInt() ?: 2000
+    val pace = args.getString("pace") ?: "none"
+    require(pace == "none" || pace == "ceiling") { "pace must be none or ceiling, got $pace" }
+    val tag = requireNotNull(args.getString("tag")) { "tag is required" }
+    val out = SigbufIo.outDir(context, args)
+    val jsonl = File(out, "$tag.jsonl").apply { delete() }
+    val done = File(out, "$tag.done").apply { delete() }
+
+    val rows =
+      manifest.readLines().filter { it.isNotBlank() }.map { line ->
+        val f = line.split('\t')
+        Row(f[0], File(manifest.parentFile, f[1]), f.getOrNull(2)?.toDoubleOrNull() ?: -1.0)
+      }
+    val selected = rows.filterIndexed { i, _ -> i % every == 0 }.let { if (limit > 0) it.take(limit) else it }
+    val warmup = warmupId?.let { id -> requireNotNull(rows.firstOrNull { it.id == id }) { "$id is not in the manifest" } }
+
+    val metadata =
+      ModelMetadataManager(context.assets.open("model_metadata.json").bufferedReader().use { it.readText() })
+    val config = SigbufIo.localConfig(metadata.getModelConfig(modelKey), accelerator, null)
+    val modelFile =
+      SigbufIo.requireFile(context, if (accelerator == Accelerator.NPU) config.npuModelPath else config.modelPath)
+    SigbufIo.requireFile(context, config.tokenizerPath)
+
+    val tap = SigbufIo.LogcatTap(File(out, "$tag.log.txt"))
+    val scenario = if (args.getString("foreground") == "front") SigbufIo.launchFront() else null
+
+    // MainActivity.preparePipeline for a "-tdt" entry.
+    val logMelSpectro = config.logMelSpectro
+    val preprocessor =
+      if (logMelSpectro != null) MelSpectroProcessor(SAMPLING_RATE, logMelSpectro) else DummyAudioProcessor()
+    val tokenizer = HuggingfaceTokenizer(context, config)
+    val t0 = SigbufIo.nowNs()
+    var separateBuffers: Boolean? = null
+    val recognizer =
+      LiteRtRunner(context, config, accelerator) { model, cfg ->
+        SigbufIo.tdtDecoder(model, cfg, accelerator).let { (decoder, separate) ->
+          separateBuffers = separate
+          decoder
+        }
+      }
+    val loadMs = SigbufIo.msSince(t0)
+    val interval = config.inputMilliseconds.milliseconds
+
+    jsonl.appendText(
+      JSONObject()
+        .put("type", "header")
+        .put("tag", tag)
+        .put("model", modelKey)
+        .put("accelerator", acceleratorName)
+        .put("model_file", modelFile.path)
+        .put("model_bytes", modelFile.length())
+        .put("litert_version", BuildConfig.LITERT_VERSION)
+        .put("tdt_decoder_blob", BuildConfig.TDT_DECODER_BLOB)
+        .put("tdt_separate_buffers", separateBuffers ?: JSONObject.NULL)
+        .put("application_id", BuildConfig.APPLICATION_ID)
+        .put("load_ms", loadMs)
+        .put("manifest", manifest.path)
+        .put("every", every)
+        .put("limit", limit)
+        .put("rows", selected.size)
+        .put("warmup_id", warmupId ?: JSONObject.NULL)
+        .put("max_tokens", maxTokens)
+        .put("pace", pace)
+        .put("foreground_state", scenario?.state?.name ?: JSONObject.NULL)
+        .put("device", SigbufIo.deviceFacts(context))
+        .toString() + "\n"
+    )
+
+    var prevEndNs = SigbufIo.nowNs()
+    val plan = listOfNotNull(warmup?.let { Pair(it, true) }) + selected.map { Pair(it, false) }
+    for ((row, isWarmup) in plan) {
+      val wait = if (pace == "ceiling" && !isWarmup) SigbufIo.ceilingWait(prevEndNs) else null
+      val line = transcribe(context, row, isWarmup, recognizer, preprocessor, tokenizer, interval, maxTokens)
+      if (wait != null) line.put("pace_wait", wait)
+      jsonl.appendText(line.toString() + "\n")
+      prevEndNs = SigbufIo.nowNs()
+    }
+
+    val foregroundState = scenario?.state?.name
+    recognizer.close()
+    tokenizer.close()
+    preprocessor.close()
+    scenario?.close()
+    val logCounts = tap.finish()
+    jsonl.appendText(
+      JSONObject()
+        .put("type", "end")
+        .put("foreground_state", foregroundState ?: JSONObject.NULL)
+        .put("log", logCounts)
+        .put("device", SigbufIo.deviceFacts(context))
+        .toString() + "\n"
+    )
+    done.writeText("done rows=${plan.size}\n")
+    Log.i(SigbufIo.TAG, "done tag=$tag rows=${plan.size}")
+  }
+
+  /** One WAV through the activity's file path; the row's JSON line. */
+  private fun transcribe(
+    context: android.content.Context,
+    row: Row,
+    isWarmup: Boolean,
+    recognizer: SpeechRecognizer,
+    preprocessor: AudioPreprocessor,
+    tokenizer: Tokenizer,
+    interval: Duration,
+    maxTokens: Int,
+  ): JSONObject {
+    val windows = JSONArray()
+    var confirmed = ""
+    var unconfirmed = ""
+    var error: String? = null
+    val thermalBefore = SigbufIo.thermalStatus(context)
+    val start = SigbufIo.nowNs()
+    try {
+      FileInputStream(row.wav).use { input ->
+        FileAudioSource(input, SAMPLING_RATE, interval, FILE_AUDIO_CHUNK_OVERLAP_DURATION).use { source ->
+          LevenshteinTokenMerger(
+              tokenizer,
+              (FILE_AUDIO_CHUNK_OVERLAP_DURATION / interval).toFloat(),
+              maxLevenshteinDistance = FILE_MAX_LEVENSHTEIN_DISTANCE,
+            )
+            .use { merger ->
+              for (chunk in source.getAudioData()) {
+                var t = SigbufIo.nowNs()
+                val features = preprocessor.process(chunk)
+                val melMs = SigbufIo.msSince(t)
+                t = SigbufIo.nowNs()
+                val sequence = recognizer.recognize(features)
+                val encodeMs = SigbufIo.msSince(t)
+                val ids = ArrayList<Int>()
+                val timeIndices = ArrayList<Int>()
+                var ended = false
+                var capped = false
+                var decodeNs = 0L
+                val iterator = sequence.iterator()
+                while (true) {
+                  t = SigbufIo.nowNs()
+                  val next = if (iterator.hasNext()) iterator.next() else null
+                  decodeNs += SigbufIo.nowNs() - t
+                  if (next == null) break
+                  val decoded = merger.decode(next.first, next.second)
+                  if (decoded != null) {
+                    confirmed = listOf(confirmed, decoded.confirmedText).filter { it.isNotEmpty() }.joinToString(" ")
+                    unconfirmed = decoded.unconfirmedText
+                  }
+                  if (next.first == SpeechRecognizer.END_OF_SEQUENCE) {
+                    ended = true
+                    break
+                  }
+                  ids.add(next.first)
+                  timeIndices.add(next.second)
+                  if (ids.size >= maxTokens) {
+                    capped = true
+                    break
+                  }
+                }
+                windows.put(
+                  JSONObject()
+                    .put("mel_ms", melMs)
+                    .put("encode_ms", encodeMs)
+                    .put("decode_ms", decodeNs / 1e6)
+                    .put("tokens", JSONArray(ids))
+                    .put("time_indices", JSONArray(timeIndices))
+                    .put("ended", ended)
+                    .put("capped", capped)
+                )
+              }
+            }
+        }
+      }
+    } catch (e: Exception) {
+      error = "${e.javaClass.simpleName}: ${e.message}"
+      Log.e(SigbufIo.TAG, "${row.id} failed", e)
+    }
+    return JSONObject()
+      .put("type", "utterance")
+      .put("id", row.id)
+      .put("warmup", isWarmup)
+      .put("seconds", row.seconds)
+      .put("wall_s", SigbufIo.msSince(start) / 1e3)
+      .put("windows", windows)
+      .put("text", listOf(confirmed, unconfirmed).filter { it.isNotEmpty() }.joinToString(" "))
+      .put("error", error ?: JSONObject.NULL)
+      .put("thermal_before", thermalBefore)
+      .put("thermal_after", SigbufIo.thermalStatus(context))
+  }
+
+  private companion object {
+    // MainActivity's file path constants.
+    const val SAMPLING_RATE = 16000
+    val FILE_AUDIO_CHUNK_OVERLAP_DURATION = 2.seconds
+    const val FILE_MAX_LEVENSHTEIN_DISTANCE = 5
+  }
+}
