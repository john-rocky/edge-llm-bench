+
+package com.google.ai.edge.examples.asr
+
+import android.util.Log
+import android.widget.AutoCompleteTextView
+import android.widget.Button
+import androidx.test.core.app.ActivityScenario
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import java.io.File
+import java.io.FileInputStream
+import kotlin.time.Duration.Companion.milliseconds
+import kotlin.time.Duration.Companion.seconds
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * asr-sigbuf-v1 (edge-llm-bench docs/asr-sigbuf-v1.md): the TdtDecoder MainActivity itself builds. The
+ * test launches MainActivity, writes the model and the backend into its two selectors and calls its
+ * preparePipeline (what picking an item calls), waits until the activity holds a new speech recognizer,
+ * and reads the decoder MainActivity's factory built (LiteRtRunner.decoder) and its separateBuffers
+ * flag through reflection. The activity's own speech recognizer, audio preprocessor and tokenizer then
+ * take WAV files through MainActivity's file steps (as SigbufBenchTest, one step after the other).
+ * MainActivity reads the entry's own files from the files dir; the test stops before the activity is
+ * asked to load when a file is missing (the activity would download it).
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - model: a "-tdt" key of model_metadata.json; default parakeet-tdt-0.6b-v3
+ * - accelerators: comma-separated cpu / gpu / npu, loaded in that order
+ * - manifest, every, rows: the WAV rows (index 0, every, ...; the first [rows]); default rows 1
+ * - max_tokens: tokens taken from one window before the test stops reading it; default 630
+ * - tag: output stem in <external files dir>/sigbuf: <tag>.json, <tag>.log.txt (SigbufIo.LogcatTap),
+ *   <tag>.done
+ */
+@RunWith(AndroidJUnit4::class)
+class SigbufMainActivityTest {
+
+  @Test
+  fun mainActivityBuildsTheDecoder() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val modelKey = args.getString("model") ?: "parakeet-tdt-0.6b-v3"
+    require(modelKey.contains("-tdt")) { "$modelKey is not a -tdt entry (TdtDecoder)" }
+    val accelerators =
+      requireNotNull(args.getString("accelerators")) { "accelerators is required" }
+        .split(',')
+        .map { it.trim().lowercase() }
+        .filter { it.isNotEmpty() }
+    val manifest = File(requireNotNull(args.getString("manifest")) { "manifest is required" })
+    val every = args.getString("every")?.toInt() ?: 1
+    val rowCount = args.getString("rows")?.toInt() ?: 1
+    val maxTokens = args.getString("max_tokens")?.toInt() ?: 630
+    val tag = requireNotNull(args.getString("tag")) { "tag is required" }
+    val out = SigbufIo.outDir(context, args)
+    val report = File(out, "$tag.json").apply { delete() }
+    val done = File(out, "$tag.done").apply { delete() }
+
+    val metadata =
+      ModelMetadataManager(context.assets.open("model_metadata.json").bufferedReader().use { it.readText() })
+    val config = metadata.getModelConfig(modelKey)
+    for (name in accelerators) {
+      SigbufIo.requireFile(context, if (name == "npu") config.npuModelPath else config.modelPath)
+    }
+    SigbufIo.requireFile(context, config.tokenizerPath)
+    val wavs =
+      manifest
+        .readLines()
+        .filter { it.isNotBlank() }
+        .map { it.split('\t') }
+        .filterIndexed { i, _ -> i % every == 0 }
+        .take(rowCount)
+        .map { Pair(it[0], File(manifest.parentFile, it[1])) }
+
+    val tap = SigbufIo.LogcatTap(File(out, "$tag.log.txt"))
+    val scenario = ActivityScenario.launch(MainActivity::class.java)
+    val results = JSONArray()
+    var previous: Any? = null
+    for (name in accelerators) {
+      val backend =
+        context.getString(
+          when (name) {
+            "cpu" -> R.string.cpu
+            "gpu" -> R.string.gpu
+            "npu" -> R.string.npu
+            else -> throw IllegalArgumentException("accelerator must be cpu, gpu or npu, got $name")
+          }
+        )
+      var activity: MainActivity? = null
+      val t0 = SigbufIo.nowNs()
+      scenario.onActivity {
+        it.findViewById<AutoCompleteTextView>(R.id.model_selector).setText(modelKey, false)
+        it.findViewById<AutoCompleteTextView>(R.id.backend_selector).setText(backend, false)
+        MainActivity::class.java.getDeclaredMethod("preparePipeline").apply { isAccessible = true }.invoke(it)
+        activity = it
+      }
+      val main = requireNotNull(activity)
+      var recognizer: Any? = null
+      while (SigbufIo.msSince(t0) < 120_000) {
+        val now = field(main, "speechRecognizer")
+        if (now != null && now !== previous) {
+          recognizer = now
+          break
+        }
+        Thread.sleep(200)
+      }
+      val entry =
+        JSONObject()
+          .put("accelerator", name)
+          .put("backend_text", backend)
+          .put("loaded", recognizer != null)
+          .put("load_wait_ms", SigbufIo.msSince(t0))
+      if (recognizer == null) {
+        var buttonText = ""
+        scenario.onActivity { buttonText = it.findViewById<Button>(R.id.transcribe_button).text.toString() }
+        entry.put("button_text", buttonText)
+      } else {
+        previous = recognizer
+        val decoder = requireNotNull(field(recognizer, "decoder"))
+        val separate =
+          try {
+            field(decoder, "separateBuffers") as Boolean
+          } catch (e: NoSuchFieldException) {
+            null
+          }
+        entry
+          .put("recognizer_class", recognizer.javaClass.simpleName)
+          .put("decoder_class", decoder.javaClass.simpleName)
+          .put("separate_buffers", separate ?: JSONObject.NULL)
+        val preprocessor = field(main, "audioPreprocessor") as AudioPreprocessor
+        val tokenizer = field(main, "tokenizer") as Tokenizer
+        val rows = JSONArray()
+        for ((id, wav) in wavs) {
+          rows.put(transcribe(id, wav, recognizer as SpeechRecognizer, preprocessor, tokenizer, config, maxTokens))
+        }
+        entry.put("rows", rows)
+      }
+      results.put(entry)
+      Log.i(SigbufIo.TAG, "$name: loaded=${recognizer != null} ${entry.opt("separate_buffers")}")
+    }
+    val foregroundState = scenario.state.name
+    scenario.close()
+    val logCounts = tap.finish()
+    report.writeText(
+      JSONObject()
+        .put("tag", tag)
+        .put("model", modelKey)
+        .put("litert_version", BuildConfig.LITERT_VERSION)
+        .put("tdt_decoder_blob", BuildConfig.TDT_DECODER_BLOB)
+        .put("main_activity_blob", BuildConfig.MAIN_ACTIVITY_BLOB)
+        .put("application_id", BuildConfig.APPLICATION_ID)
+        .put("max_tokens", maxTokens)
+        .put("foreground_state", foregroundState)
+        .put("accelerators", results)
+        .put("log", logCounts)
+        .put("device", SigbufIo.deviceFacts(context))
+        .toString(1) + "\n"
+    )
+    done.writeText("done accelerators=${accelerators.size}\n")
+    Log.i(SigbufIo.TAG, "done tag=$tag")
+  }
+
+  /** One WAV through MainActivity's file steps on the activity's own objects; the row's JSON. */
+  private fun transcribe(
+    id: String,
+    wav: File,
+    recognizer: SpeechRecognizer,
+    preprocessor: AudioPreprocessor,
+    tokenizer: Tokenizer,
+    config: ModelConfig,
+    maxTokens: Int,
+  ): JSONObject {
+    val interval = config.inputMilliseconds.milliseconds
+    val windows = JSONArray()
+    var confirmed = ""
+    var unconfirmed = ""
+    var error: String? = null
+    try {
+      FileInputStream(wav).use { input ->
+        FileAudioSource(input, SAMPLING_RATE, interval, OVERLAP).use { source ->
+          val merger = LevenshteinTokenMerger(tokenizer, (OVERLAP / interval).toFloat(), maxLevenshteinDistance = 5)
+          merger.use {
+            for (chunk in source.getAudioData()) {
+              val ids = ArrayList<Int>()
+              var ended = false
+              var capped = false
+              for ((tokenId, timestamp) in recognizer.recognize(preprocessor.process(chunk))) {
+                val decoded = merger.decode(tokenId, timestamp)
+                if (decoded != null) {
+                  confirmed = listOf(confirmed, decoded.confirmedText).filter { it.isNotEmpty() }.joinToString(" ")
+                  unconfirmed = decoded.unconfirmedText
+                }
+                if (tokenId == SpeechRecognizer.END_OF_SEQUENCE) {
+                  ended = true
+                  break
+                }
+                ids.add(tokenId)
+                if (ids.size >= maxTokens) {
+                  capped = true
+                  break
+                }
+              }
+              windows.put(JSONObject().put("tokens", ids.size).put("ended", ended).put("capped", capped))
+            }
+          }
+        }
+      }
+    } catch (e: Exception) {
+      error = "${e.javaClass.simpleName}: ${e.message}"
+      Log.e(SigbufIo.TAG, "$id failed", e)
+    }
+    return JSONObject()
+      .put("id", id)
+      .put("windows", windows)
+      .put("text", listOf(confirmed, unconfirmed).filter { it.isNotEmpty() }.joinToString(" "))
+      .put("error", error ?: JSONObject.NULL)
+  }
+
+  private companion object {
+    // MainActivity's file path constants.
+    const val SAMPLING_RATE = 16000
+    val OVERLAP = 2.seconds
+
+    /** A declared field of [target]'s class or a superclass, read through reflection. */
+    fun field(target: Any, name: String): Any? {
+      var c: Class<*>? = target.javaClass
+      while (c != null) {
+        try {
+          return c.getDeclaredField(name).apply { isAccessible = true }.get(target)
+        } catch (e: NoSuchFieldException) {
+          c = c.superclass
+        }
+      }
+      throw NoSuchFieldException(name)
+    }
+  }
+}
