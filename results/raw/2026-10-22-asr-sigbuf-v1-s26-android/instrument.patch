+package com.google.ai.edge.examples.asr
+
+import android.app.Activity
+import android.content.Context
+import android.os.Build
+import android.os.Bundle
+import android.os.PowerManager
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+import androidx.test.core.app.ActivityScenario
+import com.google.ai.edge.litert.Accelerator
+import com.google.ai.edge.litert.CompiledModel
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import org.json.JSONObject
+
+/** Helpers of the asr-sigbuf-v1 check tests (edge-llm-bench docs/asr-sigbuf-v1.md). */
+internal object SigbufIo {
+  const val TAG = "Sigbuf"
+  private const val FRONT_ACTIVITY = "com.google.ai.edge.examples.asr.BenchFrontActivity"
+  private val ERR_6004 = Regex("(err|failed|error)\\s+6004|0x1774")
+
+  fun nowNs() = SystemClock.elapsedRealtimeNanos()
+
+  fun msSince(startNs: Long) = (nowNs() - startNs) / 1e6
+
+  fun accelerator(name: String): Accelerator =
+    when (name.lowercase()) {
+      "cpu" -> Accelerator.CPU
+      "gpu" -> Accelerator.GPU
+      "npu" -> Accelerator.NPU
+      else -> throw IllegalArgumentException("accelerator must be cpu, gpu or npu, got $name")
+    }
+
+  /**
+   * The TdtDecoder MainActivity builds for [accelerator]: with the change, the separateBuffers
+   * argument is true on the NPU only (MainActivity's factory); upstream main's TdtDecoder takes the
+   * model and the config only. The second value says which form was built (null = no such argument).
+   */
+  fun tdtDecoder(model: CompiledModel, config: ModelConfig, accelerator: Accelerator): Pair<TdtDecoder, Boolean?> {
+    val withFlag =
+      try {
+        TdtDecoder::class.java.getConstructor(CompiledModel::class.java, ModelConfig::class.java, java.lang.Boolean.TYPE)
+      } catch (e: NoSuchMethodException) {
+        null
+      }
+    if (withFlag == null) return Pair(TdtDecoder(model, config), null)
+    val separate = accelerator == Accelerator.NPU
+    return Pair(withFlag.newInstance(model, config, separate), separate)
+  }
+
+  /** The bench build's front window, so the process runs in the top-app cpuset. */
+  @Suppress("UNCHECKED_CAST")
+  fun launchFront(): ActivityScenario<Activity> =
+    ActivityScenario.launch(Class.forName(FRONT_ACTIVITY) as Class<Activity>)
+
+  fun outDir(context: Context, args: Bundle): File =
+    File(args.getString("out") ?: File(context.getExternalFilesDir(null), "sigbuf").path).apply {
+      mkdirs()
+    }
+
+  /**
+   * The entry's config with every remote URL emptied, so a missing file stops the run instead of
+   * a download; [modelFile] replaces the model path of [accelerator] when given.
+   */
+  fun localConfig(config: ModelConfig, accelerator: Accelerator, modelFile: String?): ModelConfig {
+    val local = config.copy(modelRemoteUrl = "", npuModelRemoteUrlPattern = "", tokenizerRemoteUrl = "")
+    return when {
+      modelFile == null -> local
+      accelerator == Accelerator.NPU -> local.copy(npuModelPath = modelFile)
+      else -> local.copy(modelPath = modelFile)
+    }
+  }
+
+  fun requireFile(context: Context, path: String): File =
+    File(context.filesDir, path).also { require(it.isFile) { "missing ${it.path}" } }
+
+  fun readF32(file: File): FloatArray {
+    val bytes = file.readBytes()
+    require(bytes.size % 4 == 0) { "${file.name}: ${bytes.size} bytes is not whole float32 values" }
+    val out = FloatArray(bytes.size / 4)
+    ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer().get(out)
+    return out
+  }
+
+  fun thermalStatus(context: Context): Int =
+    (context.getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus
+
+  private fun procStatus(key: String): String =
+    try {
+      File("/proc/self/status").readLines().firstOrNull { it.startsWith("$key:") }?.substringAfter(':')?.trim()
+        ?: ""
+    } catch (e: Exception) {
+      ""
+    }
+
+  private fun readText(file: File): String =
+    try {
+      file.readText().trim()
+    } catch (e: Exception) {
+      ""
+    }
+
+  /** The run's device facts for a header. */
+  fun deviceFacts(context: Context): JSONObject =
+    JSONObject()
+      .put("model", Build.MODEL)
+      .put("soc_model", Build.SOC_MODEL)
+      .put("sdk_int", Build.VERSION.SDK_INT)
+      .put("pid", Process.myPid())
+      .put("cpus_allowed", procStatus("Cpus_allowed_list"))
+      .put("cpuset", readText(File("/proc/self/cpuset")))
+      .put("thermal_status", thermalStatus(context))
+
+  private fun readKhz(file: File): Long? = readText(file).toLongOrNull()
+
+  /**
+   * Waits from [sinceNs] (the end of the previous row) at least [minGapMs], then until every cpufreq
+   * policy's ceiling (scaling_max_freq) is back at its hardware maximum (cpuinfo_max_freq), read
+   * every 100 ms, for at most [maxWaitMs]: the waited time and whether it ran out.
+   */
+  fun ceilingWait(sinceNs: Long, minGapMs: Long = 500, maxWaitMs: Long = 60_000): JSONObject {
+    val policies =
+      File("/sys/devices/system/cpu/cpufreq")
+        .listFiles { f -> f.name.startsWith("policy") }
+        ?.sortedBy { it.name.removePrefix("policy").toIntOrNull() ?: Int.MAX_VALUE }
+        .orEmpty()
+    val hwKhz = policies.map { readKhz(File(it, "cpuinfo_max_freq")) }
+    val gapEndNs = sinceNs + minGapMs * 1_000_000
+    val deadlineNs = sinceNs + maxWaitMs * 1_000_000
+    val left = (gapEndNs - nowNs()) / 1_000_000
+    if (left > 0) Thread.sleep(left)
+    while (true) {
+      val ceilings = policies.map { readKhz(File(it, "scaling_max_freq")) }
+      val atMax =
+        hwKhz.indices.all { i ->
+          val hw = hwKhz[i]
+          val now = ceilings[i]
+          hw == null || now == null || now >= hw
+        }
+      if (atMax || nowNs() >= deadlineNs) {
+        return JSONObject()
+          .put("waited_ms", (nowNs() - sinceNs) / 1e6)
+          .put("timed_out", !atMax)
+          .put("ceilings_khz", ceilings.joinToString(" "))
+      }
+      Thread.sleep(100)
+    }
+  }
+
+  /**
+   * Streams this process's log (`logcat -v threadtime --pid=<this pid>`) while a run goes on: every
+   * E / F line and every line naming a memory handle or error 6004 goes to [file]; the QNN memory
+   * registrations, deregistrations and finished graph executions are counted. Read as it is written,
+   * so the phone's log ring cannot drop the lines that matter before the end of the run.
+   */
+  class LogcatTap(private val file: File) : AutoCloseable {
+    private val process =
+      ProcessBuilder("logcat", "-v", "threadtime", "--pid=${Process.myPid()}")
+        .redirectErrorStream(true)
+        .start()
+    private val counts = linkedMapOf(
+      "lines" to 0,
+      "e_lines" to 0,
+      "failed_to_find_memhandle" to 0,
+      "err_6004" to 0,
+      "qnnmem_register_started" to 0,
+      "qnnmem_deregister_started" to 0,
+      "qnngraph_execute_done" to 0,
+    )
+    private val reader =
+      Thread {
+          try {
+            file.bufferedWriter().use { out ->
+              process.inputStream.bufferedReader().forEachLine { line ->
+                synchronized(counts) {
+                  bump("lines")
+                  val level = line.split(Regex("\\s+")).getOrNull(4)
+                  val memHandle = line.contains("Failed to find memHandle")
+                  // QNN's error 6004 ("... failed 6004", "... with err 6004", status 0x1774), not a
+                  // pid / tid / timestamp that happens to contain the digits.
+                  val err6004 = SigbufIo.ERR_6004.containsMatchIn(line)
+                  if (level == "E" || level == "F") bump("e_lines")
+                  if (memHandle) bump("failed_to_find_memhandle")
+                  if (err6004) bump("err_6004")
+                  if (line.contains("QnnMem_register started")) bump("qnnmem_register_started")
+                  if (line.contains("QnnMem_deRegister started")) bump("qnnmem_deregister_started")
+                  if (line.contains("QnnGraph_execute done")) bump("qnngraph_execute_done")
+                  if (level == "E" || level == "F" || memHandle || err6004 ||
+                    line.contains("memHandle")) {
+                    out.write(line)
+                    out.newLine()
+                  }
+                }
+              }
+            }
+          } catch (e: Exception) {
+            Log.w(SigbufIo.TAG, "logcat tap stopped", e)
+          }
+        }
+        .apply {
+          isDaemon = true
+          start()
+        }
+
+    private fun bump(key: String) {
+      counts[key] = (counts[key] ?: 0) + 1
+    }
+
+    /** Stops the tap after [settleMs] (the last lines of the run reach the log) and returns the counts. */
+    fun finish(settleMs: Long = 1500): JSONObject {
+      Thread.sleep(settleMs)
+      process.destroy()
+      reader.join(3000)
+      return synchronized(counts) { JSONObject(counts as Map<*, *>) }
+    }
+
+    override fun close() {
+      process.destroy()
+    }
+  }
+}
