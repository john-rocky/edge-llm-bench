+package com.google.ai.edge.examples.asr
+
+import android.util.Log
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.google.ai.edge.litert.Accelerator
+import com.google.ai.edge.litert.CompiledModel
+import java.io.File
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * asr-sigbuf-v1 (edge-llm-bench docs/asr-sigbuf-v1.md): the app's TdtDecoder on encoder outputs read
+ * from files, without the encoder. LiteRtRunner builds the model as the app does for the accelerator;
+ * before each window the encode signature runs on an all-zero input into output buffers of its own
+ * (as the app runs encode before each decode; run_encode), the file's encoder output is written into
+ * that output buffer, and TdtDecoder.decode runs from it, as from LiteRtRunner's.
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - model: a "-tdt" key of model_metadata.json
+ * - accelerator: cpu or npu
+ * - model_file: a file under the files dir in place of the entry's own (e.g. the f32 file on the CPU)
+ * - enc_inputs: comma-separated raw float32 encoder outputs [1, 1024, T] under the files dir
+ * - passes: how many times the windows are decoded in order; default 3
+ * - max_tokens: tokens taken from one window before the test stops reading it; default 2000
+ * - run_encode: true (default) or false
+ * - foreground: front keeps BenchFrontActivity in front while the test runs
+ * - tag: output stem in <external files dir>/sigbuf: <tag>.json (one entry per window), <tag>.log.txt
+ *   (SigbufIo.LogcatTap), <tag>.done
+ */
+@RunWith(AndroidJUnit4::class)
+class SigbufDecoderTest {
+
+  @Test
+  fun decodeFromFiles() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val modelKey = requireNotNull(args.getString("model")) { "model is required" }
+    require(modelKey.contains("-tdt")) { "$modelKey is not a -tdt entry (TdtDecoder)" }
+    val acceleratorName = (args.getString("accelerator") ?: "cpu").lowercase()
+    val accelerator = SigbufIo.accelerator(acceleratorName)
+    val inputs =
+      requireNotNull(args.getString("enc_inputs")) { "enc_inputs is required" }
+        .split(',')
+        .map { it.trim() }
+        .filter { it.isNotEmpty() }
+        .map { SigbufIo.requireFile(context, it) }
+    val passes = args.getString("passes")?.toInt() ?: 3
+    val maxTokens = args.getString("max_tokens")?.toInt() ?: 2000
+    val runEncode = args.getString("run_encode") != "false"
+    val tag = requireNotNull(args.getString("tag")) { "tag is required" }
+    val out = SigbufIo.outDir(context, args)
+    val report = File(out, "$tag.json").apply { delete() }
+    val done = File(out, "$tag.done").apply { delete() }
+
+    val metadata =
+      ModelMetadataManager(context.assets.open("model_metadata.json").bufferedReader().use { it.readText() })
+    val config =
+      SigbufIo.localConfig(metadata.getModelConfig(modelKey), accelerator, args.getString("model_file"))
+    val modelFile =
+      SigbufIo.requireFile(context, if (accelerator == Accelerator.NPU) config.npuModelPath else config.modelPath)
+
+    val tap = SigbufIo.LogcatTap(File(out, "$tag.log.txt"))
+    val scenario = if (args.getString("foreground") == "front") SigbufIo.launchFront() else null
+
+    var compiled: CompiledModel? = null
+    var decoder: TdtDecoder? = null
+    var separateBuffers: Boolean? = null
+    val t0 = SigbufIo.nowNs()
+    val recognizer =
+      LiteRtRunner(context, config, accelerator) { model, cfg ->
+        SigbufIo.tdtDecoder(model, cfg, accelerator).let { (built, separate) ->
+          compiled = model
+          decoder = built
+          separateBuffers = separate
+          built
+        }
+      }
+    val loadMs = SigbufIo.msSince(t0)
+    val model = requireNotNull(compiled)
+    val tdtDecoder = requireNotNull(decoder)
+    val encodeIn = model.createInputBuffers()
+    val encodeOut = model.createOutputBuffers()
+    val zeros = FloatArray(model.getInputTensorType("args_0", "encode").layout!!.dimensions.fold(1, Int::times))
+
+    val windows = JSONArray()
+    var failed = 0
+    for (pass in 0 until passes) {
+      for ((w, input) in inputs.withIndex()) {
+        val floats = SigbufIo.readF32(input)
+        val ids = ArrayList<Int>()
+        val timeIndices = ArrayList<Int>()
+        var ended = false
+        var capped = false
+        var error: String? = null
+        val t = SigbufIo.nowNs()
+        try {
+          if (runEncode) {
+            encodeIn[0].writeFloat(zeros)
+            model.run(encodeIn, encodeOut)
+          }
+          encodeOut[0].writeFloat(floats)
+          for ((tokenId, timeIndex) in tdtDecoder.decode(encodeOut)) {
+            if (tokenId == SpeechRecognizer.END_OF_SEQUENCE) {
+              ended = true
+              break
+            }
+            ids.add(tokenId)
+            timeIndices.add(timeIndex)
+            if (ids.size >= maxTokens) {
+              capped = true
+              break
+            }
+          }
+        } catch (e: Exception) {
+          error = "${e.javaClass.simpleName}: ${e.message}"
+          failed++
+          Log.e(SigbufIo.TAG, "pass $pass window $w failed", e)
+        }
+        windows.put(
+          JSONObject()
+            .put("pass", pass)
+            .put("window", w)
+            .put("input", input.name)
+            .put("ms", SigbufIo.msSince(t))
+            .put("tokens", JSONArray(ids))
+            .put("time_indices", JSONArray(timeIndices))
+            .put("ended", ended)
+            .put("capped", capped)
+            .put("error", error ?: JSONObject.NULL)
+        )
+        Log.i(SigbufIo.TAG, "pass $pass window $w: ${ids.size} tokens, ended=$ended, error=$error")
+      }
+    }
+
+    val foregroundState = scenario?.state?.name
+    (encodeIn + encodeOut).forEach { it.close() }
+    recognizer.close()
+    scenario?.close()
+    val logCounts = tap.finish()
+    report.writeText(
+      JSONObject()
+        .put("tag", tag)
+        .put("model", modelKey)
+        .put("accelerator", acceleratorName)
+        .put("model_file", modelFile.path)
+        .put("model_bytes", modelFile.length())
+        .put("litert_version", BuildConfig.LITERT_VERSION)
+        .put("tdt_decoder_blob", BuildConfig.TDT_DECODER_BLOB)
+        .put("tdt_separate_buffers", separateBuffers ?: JSONObject.NULL)
+        .put("application_id", BuildConfig.APPLICATION_ID)
+        .put("load_ms", loadMs)
+        .put("run_encode", runEncode)
+        .put("passes", passes)
+        .put("max_tokens", maxTokens)
+        .put("foreground_state", foregroundState ?: JSONObject.NULL)
+        .put("windows_run", windows.length())
+        .put("windows_failed", failed)
+        .put("windows", windows)
+        .put("log", logCounts)
+        .put("device", SigbufIo.deviceFacts(context))
+        .toString(1) + "\n"
+    )
+    done.writeText("done failed=$failed\n")
+    Log.i(SigbufIo.TAG, "done tag=$tag failed=$failed")
+  }
+}
