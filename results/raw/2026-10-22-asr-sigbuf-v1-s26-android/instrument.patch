+package com.google.ai.edge.examples.asr
+
+import android.app.Activity
+import android.os.Bundle
+import android.view.WindowManager
+import android.widget.TextView
+
+/**
+ * The bench build's front window (asr-sigbuf-v1 check build): the tests start it so the app process
+ * runs as the top app while they run. It shows over the keyguard and turns the screen on, so a
+ * locked phone needs no unlock; it loads nothing and draws one static line.
+ */
+class BenchFrontActivity : Activity() {
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+    setShowWhenLocked(true)
+    setTurnScreenOn(true)
+    window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+    setContentView(
+      TextView(this).apply {
+        text = "asr-sigbuf check running"
+        textSize = 20f
+        setPadding(48, 96, 48, 48)
+      }
+    )
+  }
+}
