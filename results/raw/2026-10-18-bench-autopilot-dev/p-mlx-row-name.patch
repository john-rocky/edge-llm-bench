+# The MLX Gemma 4 builds' class (owner decision 2026-10-19; the bench's docs/dashboard-cells-v1.md "MLX Gemma 4 file
+# (2026-10-19)"): the page carries both MLX builds of each Gemma 4 model, QAT OptiQ and PTQ 4bit, in the model's one
+# group (render_dashboard.model_row keys it), and names a cell's build by class in the words of the bench's
+# bench_common.LOGICAL_MODELS: cells.json `build`, shown with the runtime wherever a cell is named (cellName).
+MLX_GEMMA4_CLASS = (("qat-optiq", "QAT OptiQ"), ("-it-4bit", "PTQ 4bit"))
+
+
+def mlx_class(model_id):
+    """An MLX Gemma 4 build's class (MLX_GEMMA4_CLASS), else ""."""
+    mid = model_id.lower()
+    if mid.startswith("mlx-community/gemma-4-"):
+        for pat, name in MLX_GEMMA4_CLASS:
+            if pat in mid:
+                return name
+    return ""
+
