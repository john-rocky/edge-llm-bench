+package com.google.ai.edge.examples.asr
+
+import com.google.ai.edge.examples.asr.bench.validSamples
+import java.io.File
+import java.io.FileInputStream
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.security.MessageDigest
+import kotlin.math.log10
+import kotlin.math.sqrt
+import kotlin.time.Duration.Companion.milliseconds
+import kotlin.time.Duration.Companion.seconds
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+
+/**
+ * Writes the encoder input the app builds for every window of a WAV file (FileAudioSource with the
+ * app's 2 s overlap -> MelSpectroProcessor -> LiteRtRunner's pad / truncate) as raw float32, for the
+ * fixed inputs of NpuCompareTest (asr-npu-v1, edge-llm-bench docs/asr-npu-v1.md).
+ *
+ * Runs only when the system property npucheck.melDump names a job file (Gradle property
+ * -Pnpucheck.melDump=<file>); otherwise it is skipped. The job file:
+ * {"jobs": [{"wav": <path>, "model": <model_metadata.json key>, "expected_floats": <encode input
+ * floats>, "out": <dir>, "prefix": <file stem>}]}. Each job writes <prefix>.w<k>.f32 for window k and
+ * <prefix>.windows.json (per window: the samples up to the last non-zero one, the share of 10 ms
+ * frames under -40 dBFS, the feature floats before padding, the file's sha256).
+ */
+class MelDumpTest {
+  @Test
+  fun dumpWindows() {
+    val jobFile = System.getProperty("npucheck.melDump")
+    assumeTrue(!jobFile.isNullOrEmpty())
+    val metadata = ModelMetadataManager(File("src/main/assets/model_metadata.json").readText())
+    val jobs = JSONObject(File(jobFile!!).readText()).getJSONArray("jobs")
+    for (j in 0 until jobs.length()) {
+      val job = jobs.getJSONObject(j)
+      val config = metadata.getModelConfig(job.getString("model"))
+      val expected = job.getInt("expected_floats")
+      val out = File(job.getString("out")).apply { mkdirs() }
+      val prefix = job.getString("prefix")
+      val processor = MelSpectroProcessor(SAMPLING_RATE, config.logMelSpectro!!)
+      val windows = JSONArray()
+      FileInputStream(job.getString("wav")).use { input ->
+        FileAudioSource(input, SAMPLING_RATE, config.inputMilliseconds.milliseconds, OVERLAP).use { source ->
+          for ((k, window) in source.getAudioData().withIndex()) {
+            val valid = validSamples(window)
+            val quiet = quietShare(window)
+            val features = processor.process(window)
+            val padded = LiteRtRunner.padOrTruncateFeatures(features, expected)
+            val file = File(out, "$prefix.w$k.f32")
+            val bytes = ByteBuffer.allocate(padded.size * 4).order(ByteOrder.LITTLE_ENDIAN)
+            bytes.asFloatBuffer().put(padded)
+            file.writeBytes(bytes.array())
+            windows.put(
+              JSONObject()
+                .put("window", k)
+                .put("start_s", k * (config.inputMilliseconds - OVERLAP.inWholeMilliseconds) / 1000.0)
+                .put("valid_samples", valid)
+                .put("quiet_frame_share", quiet)
+                .put("feature_floats", features.size)
+                .put("written_floats", padded.size)
+                .put("file", file.name)
+                .put("sha256", sha256(file))
+            )
+          }
+        }
+      }
+      File(out, "$prefix.windows.json")
+        .writeText(
+          JSONObject()
+            .put("wav", job.getString("wav"))
+            .put("model", job.getString("model"))
+            .put("expected_floats", expected)
+            .put("windows", windows)
+            .toString(1) + "\n"
+        )
+    }
+  }
+
+  private companion object {
+    const val SAMPLING_RATE = 16000
+    val OVERLAP = 2.seconds // MainActivity's FILE_AUDIO_CHUNK_OVERLAP_DURATION
+    const val FRAME = 160 // 10 ms
+
+    /** The share of the window's 10 ms frames (its zero padding counted too) whose RMS is under -40 dBFS. */
+    fun quietShare(window: FloatArray): Double {
+      var quiet = 0
+      val frames = window.size / FRAME
+      for (f in 0 until frames) {
+        var sum = 0.0
+        for (i in f * FRAME until (f + 1) * FRAME) sum += window[i].toDouble() * window[i]
+        val rms = sqrt(sum / FRAME)
+        if (rms <= 0.0 || 20 * log10(rms) < -40.0) quiet++
+      }
+      return if (frames > 0) quiet.toDouble() / frames else 0.0
+    }
+
+    fun sha256(file: File): String =
+      MessageDigest.getInstance("SHA-256").digest(file.readBytes()).joinToString("") { "%02x".format(it) }
+  }
