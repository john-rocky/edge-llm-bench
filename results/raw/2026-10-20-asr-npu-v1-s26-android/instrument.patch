+package com.google.ai.edge.examples.asr
+
+import android.app.Activity
+import android.content.Context
+import android.os.Build
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+import androidx.test.core.app.ActivityScenario
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.google.ai.edge.litert.Accelerator
+import com.google.ai.edge.litert.BuiltinNpuAcceleratorProvider
+import com.google.ai.edge.litert.CompiledModel
+import com.google.ai.edge.litert.Environment
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.security.MessageDigest
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * Runs the signatures of one .tflite file on the CPU or the NPU over fixed input files and writes
+ * every output as raw float32, so that the same inputs can be compared across accelerators
+ * (asr-npu-v1, edge-llm-bench docs/asr-npu-v1.md). It uses the LiteRT Kotlin API only, with the
+ * options LiteRtRunner builds for the accelerator (CPU in the accelerator set, 4 CPU threads, the
+ * Qualcomm HTP performance mode HIGH_PERFORMANCE on the NPU).
+ *
+ * For each input file: encode, [repeats] times on the same buffers (the repeats are compared bit for
+ * bit), the first run's outputs written. For each file of decode_from and, with decode_self, each
+ * window's own encoder output: decode (tokens [blank, 0, 0, 0], zero LSTM states) and decode_1
+ * (token [blank], zero states) once each on buffers of their own signature, outputs written.
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - model: the .tflite file (absolute, or relative to the files dir)
+ * - accelerator: cpu or npu
+ * - inputs: comma-separated raw float32 little-endian files for encode's input args_0, one window
+ *   each (absolute, or relative to the files dir)
+ * - repeats: encode runs per input; default 2
+ * - decode_from: comma-separated raw float32 encoder outputs to decode (TDT models)
+ * - decode_self: true decodes each window's own encoder output too (TDT models)
+ * - blank: the blank token id fed to decode / decode_1; default 8192
+ * - foreground: front keeps the bench build's BenchFrontActivity in front during the run
+ * - out: output directory; default <external files dir>/npucheck
+ * - tag: output file stem; <tag>.json (report), <tag>.<part>.f32 (outputs), <tag>.load-logcat.txt,
+ *   <tag>.done
+ */
+@RunWith(AndroidJUnit4::class)
+class NpuCompareTest {
+
+  @Test
+  fun compare() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val model = resolve(context, requireNotNull(args.getString("model")) { "model is required" })
+    val acceleratorName = (args.getString("accelerator") ?: "cpu").lowercase()
+    val accelerator =
+      when (acceleratorName) {
+        "cpu" -> Accelerator.CPU
+        "npu" -> Accelerator.NPU
+        else -> throw IllegalArgumentException("accelerator must be cpu or npu, got $acceleratorName")
+      }
+    val inputs = list(args.getString("inputs")).map { resolve(context, it) }
+    val decodeFrom = list(args.getString("decode_from")).map { resolve(context, it) }
+    val decodeSelf = args.getString("decode_self") == "true"
+    val repeats = args.getString("repeats")?.toInt() ?: 2
+    require(repeats >= 1) { "repeats must be at least 1" }
+    val blank = args.getString("blank")?.toInt() ?: 8192
+    val outDir =
+      File(args.getString("out") ?: File(context.getExternalFilesDir(null), "npucheck").path).apply { mkdirs() }
+    val tag = args.getString("tag") ?: "${model.nameWithoutExtension}-$acceleratorName"
+    val report = JSONObject()
+    report.put("tag", tag)
+    report.put("model", model.path)
+    report.put("model_bytes", model.length())
+    report.put("accelerator", acceleratorName)
+    report.put("repeats", repeats)
+    report.put("pid", Process.myPid())
+    report.put(
+      "device",
+      JSONObject()
+        .put("model", Build.MODEL)
+        .put("soc", Build.SOC_MODEL)
+        .put("android", Build.VERSION.RELEASE)
+        .put("build", Build.DISPLAY),
+    )
+    report.put("litert_version", BuildConfig.LITERT_VERSION)
+
+    val scenario =
+      if (args.getString("foreground") == "front") {
+        @Suppress("UNCHECKED_CAST")
+        ActivityScenario.launch(Class.forName(FRONT_ACTIVITY) as Class<Activity>)
+      } else {
+        null
+      }
+    report.put("foreground_state", scenario?.state?.name)
+
+    // The options LiteRtRunner builds for this accelerator.
+    val options = CompiledModel.Options(setOf(Accelerator.CPU, accelerator))
+    options.cpuOptions = CompiledModel.CpuOptions(numThreads = LiteRtRunner.CPU_NUM_THREADS)
+    if (accelerator == Accelerator.NPU) {
+      options.qualcommOptions =
+        CompiledModel.QualcommOptions(
+          htpPerformanceMode = CompiledModel.QualcommOptions.HtpPerformanceMode.HIGH_PERFORMANCE
+        )
+    }
+    val env =
+      if (accelerator == Accelerator.NPU) {
+        Environment.create(BuiltinNpuAcceleratorProvider(context))
+      } else {
+        Environment.create()
+      }
+    val t0 = SystemClock.elapsedRealtimeNanos()
+    val compiled = CompiledModel.create(model.path, options, env)
+    report.put("load_ms", msSince(t0))
+    dumpOwnLogcat(File(outDir, "$tag.load-logcat.txt"))
+    report.put("signatures", describe(compiled))
+
+    val encodeIn = compiled.createInputBuffers(ENCODE)
+    val encodeOut = compiled.createOutputBuffers(ENCODE)
+    val encodeInputFloats = compiled.getInputTensorType("args_0", ENCODE).layout!!.dimensions.fold(1, Int::times)
+    val windows = JSONArray()
+    val ownEncoderOutputs = ArrayList<Pair<String, File>>()
+    for ((w, file) in inputs.withIndex()) {
+      val floats = readF32(file)
+      require(floats.size == encodeInputFloats) { "${file.name}: ${floats.size} floats, encode takes $encodeInputFloats" }
+      encodeIn[0].writeFloat(floats)
+      val runs = JSONArray()
+      val repeatOutputs = ArrayList<List<FloatArray>>()
+      for (r in 0 until repeats) {
+        val t = SystemClock.elapsedRealtimeNanos()
+        compiled.run(encodeIn, encodeOut, ENCODE)
+        runs.put(msSince(t))
+        repeatOutputs.add(encodeOut.map { it.readFloat() })
+      }
+      val first = repeatOutputs.first()
+      val identical = repeatOutputs.all { outs -> outs.indices.all { sameBits(outs[it], first[it]) } }
+      val written = JSONArray()
+      first.forEachIndexed { o, out ->
+        val f = File(outDir, "$tag.enc.w$w.out$o.f32")
+        writeF32(f, out)
+        written.put(stats(out).put("file", f.name).put("sha256", sha256(f)))
+        if (o == 0) ownEncoderOutputs.add("w$w" to f)
+      }
+      windows.put(
+        JSONObject()
+          .put("input", file.path)
+          .put("input_sha256", sha256(file))
+          .put("input_stats", stats(floats))
+          .put("run_ms", runs)
+          .put("repeats_bit_identical", identical)
+          .put("outputs", written)
+      )
+      Log.i(TAG, "encode w$w ${file.name}: ${runs} ms, repeats identical=$identical")
+    }
+    report.put("encode", windows)
+
+    val decodeInputs = decodeFrom.map { it.nameWithoutExtension to it } + (if (decodeSelf) ownEncoderOutputs else emptyList())
+    if (decodeInputs.isNotEmpty()) {
+      val decodes = JSONArray()
+      for ((label, file) in decodeInputs) {
+        val encoded = readF32(file)
+        for ((signature, tokens) in listOf(DECODE to intArrayOf(blank, 0, 0, 0), DECODE_1 to intArrayOf(blank))) {
+          val ins = compiled.createInputBuffers(signature)
+          val outs = compiled.createOutputBuffers(signature)
+          ins[0].writeFloat(encoded)
+          ins[1].writeInt(tokens)
+          val states = FloatArray(compiled.getInputTensorType("args_2", signature).layout!!.dimensions.fold(1, Int::times))
+          ins[2].writeFloat(states)
+          ins[3].writeFloat(states)
+          val t = SystemClock.elapsedRealtimeNanos()
+          compiled.run(ins, outs, signature)
+          val ms = msSince(t)
+          val written = JSONArray()
+          outs.forEachIndexed { o, buffer ->
+            val out = buffer.readFloat()
+            val f = File(outDir, "$tag.$signature.$label.out$o.f32")
+            writeF32(f, out)
+            written.put(stats(out).put("file", f.name).put("sha256", sha256(f)))
+          }
+          decodes.put(
+            JSONObject()
+              .put("signature", signature)
+              .put("encoder_output", file.path)
+              .put("encoder_output_sha256", sha256(file))
+              .put("tokens", JSONArray(tokens.toList()))
+              .put("run_ms", ms)
+              .put("outputs", written)
+          )
+          Log.i(TAG, "$signature on $label: $ms ms")
+          (ins + outs).forEach { it.close() }
+        }
+      }
+      report.put("decode", decodes)
+    }
+
+    (encodeIn + encodeOut).forEach { it.close() }
+    compiled.close()
+    scenario?.close()
+    report.put("vmhwm_kb", procStatusKb("VmHWM"))
+    report.put(
+      "native_libs",
+      JSONObject().apply {
+        File(context.applicationInfo.nativeLibraryDir)
+          .listFiles { f -> f.name.endsWith(".so") }
+          .orEmpty()
+          .sortedBy { it.name }
+          .forEach { put(it.name, sha256(it)) }
+      },
+    )
+    report.put("model_sha256", sha256(model))
+    File(outDir, "$tag.json").writeText(report.toString(1) + "\n")
+    File(outDir, "$tag.done").writeText("done\n")
+    Log.i(TAG, "done tag=$tag")
+  }
+
+  private companion object {
+    const val TAG = "NpuCompare"
+    const val ENCODE = "encode"
+    const val DECODE = "decode"
+    const val DECODE_1 = "decode_1"
+    const val FRONT_ACTIVITY = "com.google.ai.edge.examples.asr.BenchFrontActivity"
+
+    fun list(arg: String?): List<String> = arg?.split(',')?.map { it.trim() }?.filter { it.isNotEmpty() }.orEmpty()
+
+    fun resolve(context: Context, path: String) = if (path.startsWith("/")) File(path) else File(context.filesDir, path)
+
+    fun msSince(startNs: Long) = (SystemClock.elapsedRealtimeNanos() - startNs) / 1e6
+
+    fun readF32(file: File): FloatArray {
+      val bytes = file.readBytes()
+      require(bytes.size % 4 == 0) { "${file.name}: ${bytes.size} bytes is not whole float32 values" }
+      val out = FloatArray(bytes.size / 4)
+      ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer().get(out)
+      return out
+    }
+
+    fun writeF32(file: File, values: FloatArray) {
+      val buffer = ByteBuffer.allocate(values.size * 4).order(ByteOrder.LITTLE_ENDIAN)
+      buffer.asFloatBuffer().put(values)
+      file.writeBytes(buffer.array())
+    }
+
+    fun sameBits(a: FloatArray, b: FloatArray) =
+      a.size == b.size && a.indices.all { java.lang.Float.floatToRawIntBits(a[it]) == java.lang.Float.floatToRawIntBits(b[it]) }
+
+    /** Count, NaN, ±Inf, exact zeros, and min / max / mean / mean |x| of the finite values. */
+    fun stats(values: FloatArray): JSONObject {
+      var nan = 0
+      var inf = 0
+      var zeros = 0
+      var finite = 0
+      var min = Double.POSITIVE_INFINITY
+      var max = Double.NEGATIVE_INFINITY
+      var sum = 0.0
+      var sumAbs = 0.0
+      for (v in values) {
+        when {
+          v.isNaN() -> nan++
+          v.isInfinite() -> inf++
+          else -> {
+            if (v == 0.0f) zeros++
+            finite++
+            min = minOf(min, v.toDouble())
+            max = maxOf(max, v.toDouble())
+            sum += v
+            sumAbs += kotlin.math.abs(v.toDouble())
+          }
+        }
+      }
+      return JSONObject()
+        .put("count", values.size)
+        .put("nan", nan)
+        .put("inf", inf)
+        .put("zeros", zeros)
+        .put("min", if (finite > 0) min else JSONObject.NULL)
+        .put("max", if (finite > 0) max else JSONObject.NULL)
+        .put("mean", if (finite > 0) sum / finite else JSONObject.NULL)
+        .put("mean_abs", if (finite > 0) sumAbs / finite else JSONObject.NULL)
+    }
+
+    /** Every signature's inputs and outputs as LiteRT reports them, with the buffer types it asks for. */
+    fun describe(compiled: CompiledModel): JSONObject {
+      val out = JSONObject()
+      for (signature in listOf(ENCODE, DECODE, DECODE_1)) {
+        // A missing signature throws here (TdtDecoder probes decode_1 the same way).
+        val counts =
+          (try {
+            val ins = compiled.createInputBuffers(signature)
+            val outs = compiled.createOutputBuffers(signature)
+            (ins + outs).forEach { it.close() }
+            ins.size to outs.size
+          } catch (e: Exception) {
+            null
+          }) ?: continue
+        val sig = JSONObject()
+        for ((kind, prefix) in listOf("inputs" to "args_", "outputs" to "output_")) {
+          val tensors = JSONArray()
+          for (i in 0 until (if (kind == "inputs") counts.first else counts.second)) {
+            val name = "$prefix$i"
+            val type =
+              if (kind == "inputs") compiled.getInputTensorType(name, signature) else compiled.getOutputTensorType(name, signature)
+            val requirements =
+              try {
+                val r = if (kind == "inputs") compiled.getInputBufferRequirements(name, signature) else compiled.getOutputBufferRequirements(name, signature)
+                "${r.supportedTypes} size=${r.bufferSize}"
+              } catch (e: Throwable) {
+                "unavailable: ${e.message}"
+              }
+            tensors.put(
+              JSONObject()
+                .put("name", name)
+                .put("type", type.elementType.name)
+                .put("dims", JSONArray(type.layout?.dimensions.orEmpty()))
+                .put("buffer_requirements", requirements)
+            )
+          }
+          if (tensors.length() > 0) sig.put(kind, tensors)
+        }
+        if (sig.length() > 0) out.put(signature, sig)
+      }
+      return out
+    }
+
+    fun procStatusKb(key: String): Long? =
+      try {
+        File("/proc/self/status").useLines { lines ->
+          lines.firstOrNull { it.startsWith("$key:") }?.substringAfter(':')?.trim()?.split(Regex("\\s+"))?.firstOrNull()?.toLongOrNull()
+        }
+      } catch (e: Exception) {
+        null
+      }
+
+    fun sha256(file: File): String {
+      val digest = MessageDigest.getInstance("SHA-256")
+      file.inputStream().use { input ->
+        val buffer = ByteArray(1 shl 20)
+        while (true) {
+          val n = input.read(buffer)
+          if (n < 0) break
+          digest.update(buffer, 0, n)
+        }
+      }
+      return digest.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    /** Appends `logcat -d --pid=<this process>` to [file]: the accelerator and delegate lines of the load. */
+    fun dumpOwnLogcat(file: File) {
+      try {
+        val process =
+          ProcessBuilder("logcat", "-d", "-v", "threadtime", "--pid=${Process.myPid()}").redirectErrorStream(true).start()
+        val text = process.inputStream.bufferedReader().use { it.readText() }
+        process.waitFor()
+        file.appendText("# logcat --pid=${Process.myPid()}\n$text")
+      } catch (e: Exception) {
+        Log.w(TAG, "logcat dump failed", e)
+      }
+    }
+  }
+}
