{"lang": "", "emotion": "", "event": "", "text": "Yesterday you were trembling for a health that is dear to you. To day you fear for your own. To morrow it will be anxiety about money the day after, to morrow the diatribe of a slanderer the day after that the misfortune of some friend then the prevailing weather then something that has been broken or lost, then a pleasure with which your conscience and your vertebral column reproach you. Again the course of public affairs.", "timestamps": [0.24, 0.48, 0.72, 0.88, 1.04, 1.28, 1.44, 1.60, 1.76, 1.92, 2.08, 2.32, 2.48, 2.64, 2.80, 2.88, 3.12, 3.28, 3.52, 3.76, 4.00, 4.40, 4.64, 4.88, 5.04, 5.20, 5.44, 5.68, 5.84, 6.08, 6.40, 6.64, 7.04, 7.28, 7.52, 7.76, 8.00, 8.24, 8.40, 8.64, 8.80, 8.96, 9.12, 9.52, 9.84, 10.08, 10.32, 10.64, 10.88, 11.04, 11.20, 11.36, 11.52, 11.68, 11.84, 12.00, 12.24, 12.48, 12.80, 13.12, 13.28, 13.44, 13.52, 13.68, 13.84, 14.32, 14.80, 14.96, 15.12, 15.28, 15.44, 15.68, 16.24, 16.40, 16.72, 16.88, 17.04, 17.20, 17.44, 17.76, 18.00, 18.72, 19.20, 19.36, 19.60, 19.76, 19.92, 20.08, 20.32, 20.48, 21.04, 21.44, 21.68, 21.84, 22.08, 22.24, 22.48, 22.72, 22.96, 23.20, 23.44, 23.76, 23.92, 24.40, 24.64, 24.88, 25.12, 25.44, 25.92, 26.32, 26.56, 26.80, 27.04, 27.28, 27.52, 28.08, 28.32, 28.64, 28.80, 28.96, 29.20, 29.44, 29.68, 29.92, 30.16, 30.48, 31.20, 31.44, 31.76, 32.40, 32.72, 32.88, 33.04, 33.20, 33.44, 33.92, 34.16, 34.40, 34.72], "durations": [0.24, 0.24, 0.16, 0.16, 0.24, 0.16, 0.16, 0.16, 0.16, 0.16, 0.24, 0.16, 0.16, 0.16, 0.08, 0.24, 0.16, 0.24, 0.24, 0.24, 0.32, 0.24, 0.24, 0.16, 0.08, 0.24, 0.24, 0.16, 0.24, 0.08, 0.24, 0.32, 0.24, 0.24, 0.24, 0.24, 0.24, 0.16, 0.24, 0.16, 0.16, 0.16, 0.16, 0.16, 0.24, 0.24, 0.08, 0.24, 0.16, 0.16, 0.16, 0.16, 0.16, 0.16, 0.08, 0.16, 0.24, 0.16, 0.16, 0.16, 0.16, 0.08, 0.16, 0.16, 0.24, 0.24, 0.16, 0.16, 0.16, 0.16, 0.24, 0.32, 0.16, 0.32, 0.16, 0.16, 0.16, 0.24, 0.32, 0.24, 0.32, 0.16, 0.16, 0.24, 0.16, 0.16, 0.16, 0.24, 0.16, 0.32, 0.16, 0.24, 0.16, 0.24