+  @Test
+  fun s16_isEveryEighthRowOfS4FromTheFirst() {
+    // LibriSpeech test-clean: 2620 rows -> S16 = 164 (index 0, 16, ..., 2608); W = row 1 is outside.
+    val rows = (0 until 2620).map { ManifestRow("utt-$it", "/sets/utt-$it.wav", 1.0) }
+    val s16 = BenchManifest.stride(rows, 16)
+    assertEquals(164, s16.size)
+    assertEquals(listOf("utt-0", "utt-16"), s16.take(2).map { it.id })
+    assertEquals("utt-2608", s16.last().id)
+    assertFalse(s16.any { it.id == "utt-1" })
+    assertTrue(BenchManifest.stride(rows, 4).map { it.id }.containsAll(s16.map { it.id }))
+    assertEquals(10, BenchManifest.stride(rows, 16).take(10).size)
+  }
