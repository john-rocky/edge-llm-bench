+    assertEquals(3.2, capDropPct(min, hw, only = setOf(0))!!, 0.0)
+    assertEquals(0.0, capDropPct(hw, hw)!!, 0.0)
+    assertNull(capDropPct(listOf(null, null), hw))
+    assertEquals(16.2, capDropPct(listOf(null, 3_974_400L), hw)!!, 0.0)
+    // 15.04 % rounds to 15.0, which is not past the line.
+    assertEquals(15.0, capDropPct(listOf(3_398_400L), listOf(4_000_000L))!!, 0.0)
+  }
