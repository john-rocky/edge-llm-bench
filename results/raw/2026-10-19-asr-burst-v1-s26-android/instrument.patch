+  /** What the loops add up; [burst] = the burst run's own footer fields. */
+  private class Totals {
+    var done = 0
+    var failed = 0
+    var sumAudio = 0.0
+    var sumWall = 0.0
+    val utteranceRtf = ArrayList<Double>()
+    val burst = LinkedHashMap<String, Any?>()
+
+    fun add(row: ManifestRow, attempted: Attempted) {
+      if (attempted.error == null) {
+        done++
+        sumAudio += row.seconds
+        sumWall += attempted.seconds
+        utteranceRtf.add(attempted.seconds / row.seconds)
+      } else {
+        failed++
+      }
+    }
+  }
