+  @Test
+  fun rule_retakesOnceAfterTheCeilingIsBackAndFiveSecondsMore() {
+    val clock = FakeClock()
+    var firstEndNs = Long.MAX_VALUE
+    // Capped from just after the first attempt ended until 2 s later.
+    val read = { if (clock.ns > firstEndNs && clock.ns < firstEndNs + 2_000_000_000L) low else hw }
+    val rule = BurstRule(pacer(clock, read), hw, read, clock::now, clock::sleep)
+    var calls = 0
+    val outcome =
+      rule.utterance(0) { min ->
+        calls++
+        if (calls == 1) {
+          clock.advanceMs(500)
+          min.add(listOf(hw[0], 3_793_920L)) // policy6 -20 %
+          clock.advanceMs(500)
+          firstEndNs = clock.ns
+          "first"
+        } else {
+          run(clock, 1000, hw)(min)
+          "second"
+        }
+      }
+    assertEquals(2, outcome.attempts.size)
+    assertEquals("first", outcome.attempts[0].value)
+    assertEquals(20.0, outcome.attempts[0].dropPct!!, 0.0)
+    assertEquals("second", outcome.final.value)
+    assertEquals(0.0, outcome.final.dropPct!!, 0.0)
+    assertFalse(outcome.excluded)
+    // Back at 2.1 s after the first attempt (polls at 0.5, 0.7, ..., 2.1 s), then 5 s more.
+    assertEquals(7100.0, outcome.final.wait.waitedMs, 0.0)
+    assertEquals(outcome.attempts[0].endNs + 7_100_000_000L, outcome.final.startNs)
+  }
