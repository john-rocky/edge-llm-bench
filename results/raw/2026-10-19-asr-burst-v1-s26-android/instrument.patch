+  @Test
+  fun rule_keepsAnAttemptAtTheLine() {
+    val clock = FakeClock()
+    val hw4 = listOf(4_000_000L)
+    val rule = BurstRule(BurstPacer(hw4, { hw4 }, clock::now, clock::sleep), hw4, { hw4 }, clock::now, clock::sleep)
+    val outcome = rule.utterance(0, run = run(clock, 800, listOf(3_400_000L))) // exactly -15.0 %
+    assertEquals(1, outcome.attempts.size)
+    assertEquals(15.0, outcome.final.dropPct!!, 0.0)
+    assertFalse(outcome.excluded)
+    assertEquals(3, outcome.final.reads) // at the start, the run's own, at the end
+    assertEquals(500.0, outcome.final.wait.waitedMs, 0.0)
+  }
