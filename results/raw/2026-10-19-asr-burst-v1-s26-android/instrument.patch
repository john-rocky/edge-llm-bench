+        decodingMethod = "greedy_search",
+      )
+    private val recognizer: OfflineRecognizer
+    override val loadMs: Double
+
+    init {
+      files.forEach { require(it.isFile) { "sherpa model file missing: ${it.path}" } }
+      // The first OfflineRecognizer loads libsherpa-onnx-jni.so (and libonnxruntime.so) in its
+      // companion's init, inside this time, as the LiteRT runtime loads inside LiteRtRunner's.
+      val t = SystemClock.elapsedRealtimeNanos()
+      recognizer = OfflineRecognizer(config = config)
+      loadMs = msSince(t)
+    }
+
+    override fun transcribe(wav: File, times: WindowTimes): Pair<String, Double> {
+      val start = SystemClock.elapsedRealtimeNanos()
+      var t = start
+      fun stage(name: String) {
+        val now = SystemClock.elapsedRealtimeNanos()
+        times.stageMs[name] = (now - t) / 1e6
+        t = now
+      }
+      val wave = WaveReader.readWave(wav.path)
+      stage("read")
+      val stream = recognizer.createStream()
+      stage("create_stream")
+      try {
+        stream.acceptWaveform(wave.samples, wave.sampleRate)
+        stage("accept_waveform") // the features (fbank + NeMo normalization) are computed here
+        recognizer.decode(stream)
+        stage("decode") // encoder + TDT greedy search
+        val text = recognizer.getResult(stream).text
+        stage("get_result")
+        return Pair(text, (SystemClock.elapsedRealtimeNanos() - start) / 1e9)
+      } finally {
+        stream.release()
+      }
