+  /** The burst rule (asr-burst-v1): wait, run, retake once past the line; one row per utterance. */
+  private fun burstLoop(
+    engine: Engine,
+    todo: List<ManifestRow>,
+    settings: BurstSettings,
+    policies: List<File>,
+    hwKhz: List<Long?>,
+    ceilingLog: File,
+    origin: Long,
+    emit: (String) -> Unit,
+  ): Totals {
+    val totals = Totals()
+    val names = policies.map { it.name }
+    val policyCpus = policies.map { parseCpuList(readText(File(it, "related_cpus"))) }
+    val log = CeilingLog(ceilingLog, origin, names, hwKhz)
+    fun read() = policies.map { readLong(File(it, "scaling_max_freq")) }
+    val now = { SystemClock.elapsedRealtimeNanos() }
+    val sleep = { ms: Long -> Thread.sleep(ms) }
+    val pacer =
+      BurstPacer(
+        hwKhz,
+        { read().also { log.add("wait", it) } },
+        now,
+        sleep,
+        settings.gapMs,
+        settings.pollMs,
+        settings.maxWaitS * 1000,
+      )
+    val rule =
+      BurstRule(pacer, hwKhz, { read().also { log.add("edge", it) } }, now, sleep, settings.linePct, settings.settleS * 1000)
+    val counted = ArrayList<Pair<ManifestRow, Attempted>>()
+    val waits = ArrayList<Double>()
+    var excluded = 0
+    var retaken = 0
+    var retakeTextDiffers = 0
+    var waitTimeouts = 0
+    var retakeWaitSum = 0.0
+    var prevEnd = SystemClock.elapsedRealtimeNanos()
+    for ((index, row) in todo.withIndex()) {
+      val cpusAtStart = procStatusText("Cpus_allowed_list")
+      val cpusetAtStart = cpusetOf(readText(File("/proc/self/cgroup")))
+      val engineIdx = policyCpus.indices.filter { policyCpus[it].intersect(parseCpuList(cpusAtStart)).isNotEmpty() }.toSet()
+      var attemptNo = 0
+      val outcome =
+        rule.utterance<Attempted>(prevEnd, retakeAllowed = { it.error == null }) { min ->
+          attemptNo++
+          log.context = "${row.id}\t$attemptNo"
+          val times = WindowTimes()
+          pollCeilings(min, settings.capPollMs, ::read, log) { attemptOne(engine, row, times) }
+        }
+      prevEnd = outcome.final.endNs
+      val first = outcome.attempts.first()
+      val last = outcome.final
+      val extra =
+        linkedMapOf<String, Any?>(
+          "attempts" to outcome.attempts.size,
+          "wait_s" to BenchJson.round3(first.wait.waitedMs / 1000.0),
+          "wait_timed_out" to first.wait.timedOut,
+          "wait_polls" to first.wait.polls,
+          "cap_drop_pct" to last.dropPct,
+          "cap_drop_engine_cpus_pct" to capDropPct(last.minKhz, hwKhz, engineIdx),
+          "cap_min_khz" to names.zip(last.minKhz).toMap(),
+          "cap_reads" to last.reads,
+          "excluded" to outcome.excluded,
+          "cpus_allowed" to cpusAtStart,
+          "cpuset" to cpusetAtStart,
+        )
+      if (outcome.attempts.size > 1) {
+        extra["retake"] =
+          linkedMapOf(
+            "first" to
+              linkedMapOf(
+                "processing_seconds" to BenchJson.round3(first.value.seconds),
+                "cap_drop_pct" to first.dropPct,
+                "cap_min_khz" to names.zip(first.minKhz).toMap(),
+                "cap_reads" to first.reads,
+                "text" to first.value.text,
+                "error" to first.value.error,
+              ),
+            "wait_s" to BenchJson.round3(last.wait.waitedMs / 1000.0),
+            "wait_timed_out" to last.wait.timedOut,
+            "text_same" to (first.value.text == last.value.text),
+          )
+        retaken++
+        retakeWaitSum += last.wait.waitedMs / 1000.0
+        if (first.value.text != last.value.text) retakeTextDiffers++
+      }
+      if (last.value.times.stageMs.isNotEmpty()) extra["stage_ms"] = last.value.times.stageMs
+      val times = last.value.times
+      emit(
+        BenchJson.utterance(
+          UtteranceResult(
+            row.id,
+            last.value.text,
+            row.seconds,
+            last.value.seconds,
+            times.melMs,
+            times.encodeMs,
+            times.decodeMs,
+            times.tokens,
+            last.value.error,
+            extra,
+          )
+        )
+      )
+      log.flush()
+      totals.add(row, last.value)
+      waits.add(first.wait.waitedMs / 1000.0)
+      if (first.wait.timedOut) waitTimeouts++
+      if (outcome.excluded && last.value.error == null) excluded++
+      if (!outcome.excluded && last.value.error == null) counted.add(row to last.value)
+      if ((index + 1) % 25 == 0 || index + 1 == todo.size) {
+        Log.i(TAG, "progress ${index + 1}/${todo.size} excluded=$excluded retaken=$retaken")
+      }
+    }
+    log.close()
+    val audio = counted.sumOf { it.first.seconds }
+    val wall = counted.sumOf { it.second.seconds }
+    totals.burst.putAll(
+      linkedMapOf(
+        "utterances_counted" to counted.size,
+        "utterances_excluded" to excluded,
+        "utterances_retaken" to retaken,
+        "retake_text_differs" to retakeTextDiffers,
+        "counted_audio_seconds" to audio,
+        "counted_processing_seconds" to wall,
+        "rtf_burst" to if (audio > 0) wall / audio else null,
+        "median_utterance_rtf_burst" to median(counted.map { it.second.seconds / it.first.seconds }),
+        "wait_sum_s" to waits.sum(),
+        "wait_median_s" to median(waits),
+        "wait_max_s" to waits.maxOrNull(),
+        "wait_timeouts" to waitTimeouts,
+        "retake_wait_sum_s" to retakeWaitSum,
+      )
+    )
+    return totals
+  }
