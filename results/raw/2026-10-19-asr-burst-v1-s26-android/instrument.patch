+  /** A run that takes [ms] and reads the ceilings [ceilings] once while it runs. */
+  private fun run(clock: FakeClock, ms: Long, ceilings: List<Long?>): (CeilingMin) -> String = { min ->
+    clock.advanceMs(ms / 2)
+    min.add(ceilings)
+    clock.advanceMs(ms - ms / 2)
+    "text"
+  }
