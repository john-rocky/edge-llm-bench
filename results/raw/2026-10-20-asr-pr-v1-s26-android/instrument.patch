+
+  /**
+   * sherpa-onnx's OfflineRecognizer from the release AAR, set up as the CLI arm A1 runs it
+   * (sherpa-onnx-offline-parallel --model-type=nemo_transducer --num-threads=4
+   * --decoding-method=greedy_search, the feature options at their defaults).
+   */
+  private class SherpaEngine(context: Context, dirName: String, debug: Boolean) : Engine {
+    private val dir = File(context.filesDir, dirName)
+    private val files = SHERPA_FILES.map { File(dir, it) }
+    val config =
+      OfflineRecognizerConfig(
+        featConfig = FeatureConfig(sampleRate = SAMPLING_RATE, featureDim = 80),
+        modelConfig =
+          OfflineModelConfig(
+            transducer =
+              OfflineTransducerModelConfig(
+                encoder = files[0].path,
+                decoder = files[1].path,
+                joiner = files[2].path,
+              ),
+            tokens = files[3].path,
+            numThreads = SHERPA_NUM_THREADS,
+            debug = debug,
+            provider = "cpu",
+            modelType = "nemo_transducer",
+          ),
+        decodingMethod = "greedy_search",
+      )
+    private val recognizer: OfflineRecognizer
+    override val loadMs: Double
+
+    init {
+      files.forEach { require(it.isFile) { "sherpa model file missing: ${it.path}" } }
+      // The first OfflineRecognizer loads libsherpa-onnx-jni.so (and libonnxruntime.so) in its
+      // companion's init, inside this time, as the LiteRT runtime loads inside LiteRtRunner's.
+      val t = SystemClock.elapsedRealtimeNanos()
+      recognizer = OfflineRecognizer(config = config)
+      loadMs = msSince(t)
+    }
+
+    override fun transcribe(wav: File, times: WindowTimes): Pair<String, Double> {
+      val start = SystemClock.elapsedRealtimeNanos()
+      var t = start
+      fun stage(name: String) {
+        val now = SystemClock.elapsedRealtimeNanos()
+        times.stageMs[name] = (now - t) / 1e6
+        t = now
+      }
+      val wave = WaveReader.readWave(wav.path)
+      stage("read")
+      val stream = recognizer.createStream()
+      stage("create_stream")
+      try {
+        stream.acceptWaveform(wave.samples, wave.sampleRate)
+        stage("accept_waveform") // the features (fbank + NeMo normalization) are computed here
+        recognizer.decode(stream)
+        stage("decode") // encoder + TDT greedy search
+        val text = recognizer.getResult(stream).text
+        stage("get_result")
+        return Pair(text, (SystemClock.elapsedRealtimeNanos() - start) / 1e9)
+      } finally {
+        stream.release()
+      }
+    }
+
+    override fun header(): Map<String, Any?> =
+      linkedMapOf(
+        "num_threads" to SHERPA_NUM_THREADS,
+        "sherpa_onnx_version" to versionOrNull { VersionInfo.version },
+        "sherpa_onnx_git_sha1" to versionOrNull { VersionInfo.gitSha1 },
+        "sherpa_onnx_git_date" to versionOrNull { VersionInfo.gitDate },
+        "onnxruntime_version" to versionOrNull { VersionInfo.onnxruntimeVersion },
+        "sherpa_config_kotlin" to config.toString(),
+        "model_file" to files[0].path,
+        "model_bytes" to files.sumOf { it.length() },
+        "model_files" to files.associate { it.name to it.length() },
+        "input_ms" to null,
+        "load_seconds" to loadMs / 1000.0,
+        "load_ms" to loadMs,
+        "load_scope" to
+          "OfflineRecognizer constructor (first use loads libsherpa-onnx-jni.so; newFromFile: the three ONNX Runtime sessions, tokens, config)",
+      )
+
+    override fun modelHashes(): Map<String, Any?> =
+      linkedMapOf("model_files_sha256" to files.associate { it.name to sha256(listOf(it)) })
+
+    override fun close() = recognizer.release()
+
+    private companion object {
+      fun versionOrNull(read: () -> String): String? =
+        try {
+          read()
+        } catch (e: Throwable) {
+          null
+        }
+    }
+  }
