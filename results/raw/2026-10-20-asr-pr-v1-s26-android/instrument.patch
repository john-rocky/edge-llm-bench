+package com.google.ai.edge.examples.asr.bench
+
+import com.google.ai.edge.examples.asr.Postprocessor
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** One utterance of a benchmark manifest: its id, its WAV (16 kHz mono PCM16) and its length. */
+data class ManifestRow(val id: String, val wavPath: String, val seconds: Double)
+
+/**
+ * The benchmark manifest: one line per utterance, `id<TAB>wav<TAB>seconds`, in the set's order. A
+ * relative wav path is resolved against the manifest's directory.
+ */
+object BenchManifest {
+  fun parse(text: String, baseDir: String? = null): List<ManifestRow> =
+    text
+      .lineSequence()
+      .mapIndexedNotNull { index, line ->
+        if (line.isBlank()) return@mapIndexedNotNull null
+        val cols = line.trimEnd('\r').split('\t')
+        require(cols.size == 3) {
+          "manifest line ${index + 1}: expected 3 tab-separated columns, got ${cols.size}"
+        }
+        val seconds =
+          requireNotNull(cols[2].toDoubleOrNull()) {
+            "manifest line ${index + 1}: seconds '${cols[2]}' is not a number"
+          }
+        val path = if (baseDir != null && !cols[1].startsWith("/")) "$baseDir/${cols[1]}" else cols[1]
+        ManifestRow(cols[0], path, seconds)
+      }
+      .toList()
+
+  /** The rows at index 0, every, 2 * every, ... in order (S4 = every 4th row from the first). */
+  fun stride(rows: List<ManifestRow>, every: Int): List<ManifestRow> {
+    require(every >= 1) { "every must be at least 1, got $every" }
+    return rows.filterIndexed { index, _ -> index % every == 0 }
+  }
+
+  /** The rows after the row with [id], to resume a run after a crash or a hang. */
+  fun after(rows: List<ManifestRow>, id: String): List<ManifestRow> {
+    val index = rows.indexOfFirst { it.id == id }
+    require(index >= 0) { "start_after id $id is not in the selection" }
+    return rows.subList(index + 1, rows.size)
+  }
+}
+
+/**
+ * The text MainActivity shows when a file transcription ends: every confirmed text merged in
+ * order, then the unconfirmed text of the last update (scheduleTokenPostprocessing and
+ * updateTranscriptionUI).
+ */
+class TranscriptAccumulator {
+  private var totalConfirmedText = ""
+  private var unconfirmedText = ""
+
+  fun add(decodedText: Postprocessor.DecodedText?) {
+    if (decodedText == null) return
+    totalConfirmedText = merge(totalConfirmedText, decodedText.confirmedText)
+    unconfirmedText = decodedText.unconfirmedText
+  }
+
+  fun text(): String = merge(totalConfirmedText, unconfirmedText)
+
+  private fun merge(prev: String, next: String) =
+    listOf(prev, next).filter { it.isNotEmpty() }.joinToString(separator = " ")
+}
+
+/**
+ * One transcribed utterance with the per-window times of the pipeline's three stages; [extra]
+ * holds what a burst run adds (waits, ceilings, attempts) and the sherpa stages, after the rest.
+ */
+data class UtteranceResult(
+  val id: String,
+  val text: String,
+  val audioSeconds: Double,
+  val processingSeconds: Double,
+  val melMs: List<Double> = emptyList(),
+  val encodeMs: List<Double> = emptyList(),
+  val decodeMs: List<Double> = emptyList(),
+  val tokens: List<Int> = emptyList(),
+  val error: String? = null,
+  val extra: Map<String, Any?> = emptyMap(),
+)
+
+/**
+ * JSONL rows in the shape tools/omni-eval/score.py reads (edge-llm-bench): a header and a footer
+ * with a `type` and no `id`, and one row per utterance with `id`, `text`, `audio_seconds` and
+ * `processing_seconds`.
+ */
+object BenchJson {
+  const val HARNESS = "asr-litert-app-v1"
+
+  /** The burst runs' harness name (docs/asr-burst-v1.md); the sustained runs keep [HARNESS]. */
+  const val BURST_HARNESS = "asr-burst-v1"
+
+  fun header(fields: Map<String, Any?>): String = typed("header", fields)
+
+  fun footer(fields: Map<String, Any?>): String = typed("footer", fields)
+
+  /** The warm-up utterance a burst run transcribes once before the set (no `id`: not scored). */
+  fun warmup(fields: Map<String, Any?>): String = typed("warmup", fields)
+
+  fun utterance(result: UtteranceResult): String {
+    val row = JSONObject()
+    row.put("type", "utterance")
+    row.put("id", result.id)
+    row.put("text", result.text)
+    row.put("audio_seconds", result.audioSeconds)
+    row.put("processing_seconds", round3(result.processingSeconds))
+    row.put("windows", result.encodeMs.size)
+    row.put("empty_windows", result.tokens.count { it == 0 })
+    row.put("tokens", JSONArray(result.tokens))
+    row.put("mel_ms", JSONArray(result.melMs.map(::round3)))
+    row.put("encode_ms", JSONArray(result.encodeMs.map(::round3)))
+    row.put("decode_ms", JSONArray(result.decodeMs.map(::round3)))
+    if (result.error != null) row.put("error", result.error)
+    for ((key, value) in result.extra) {
+      require(!row.has(key)) { "extra field $key would overwrite a row field" }
+      row.put(key, toJson(value))
+    }
+    return row.toString()
+  }
+
+  private fun typed(type: String, fields: Map<String, Any?>): String {
+    require("id" !in fields) { "a $type row must not carry an id (score.py reads rows with an id)" }
+    val row = JSONObject()
+    row.put("type", type)
+    for ((key, value) in fields) row.put(key, toJson(value))
+    return row.toString()
+  }
+
+  private fun toJson(value: Any?): Any =
+    when (value) {
+      null -> JSONObject.NULL
+      is Map<*, *> -> JSONObject().also { o -> value.forEach { (k, v) -> o.put(k.toString(), toJson(v)) } }
+      is Iterable<*> -> JSONArray().also { a -> value.forEach { a.put(toJson(it)) } }
+      is Double -> if (value.isNaN() || value.isInfinite()) JSONObject.NULL else value
+      else -> value
+    }
+
+  fun round3(value: Double): Double = Math.round(value * 1000.0) / 1000.0
+}
+
+/** The median of [values], or null when there are none. */
+fun median(values: List<Double>): Double? {
+  if (values.isEmpty()) return null
+  val sorted = values.sorted()
+  val mid = sorted.size / 2
+  return if (sorted.size % 2 == 1) sorted[mid] else (sorted[mid - 1] + sorted[mid]) / 2.0
+}
