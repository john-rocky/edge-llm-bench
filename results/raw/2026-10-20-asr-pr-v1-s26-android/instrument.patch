+      runBlocking(Dispatchers.IO) { processFileAudio(wav, pipeline, times) }
+
+    override fun header(): Map<String, Any?> =
+      linkedMapOf(
+        "num_threads" to LiteRtRunner.CPU_NUM_THREADS,
