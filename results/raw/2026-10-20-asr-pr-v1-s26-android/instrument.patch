+package com.google.ai.edge.examples.asr.bench
+
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.junit.runners.JUnit4
+
+@RunWith(JUnit4::class)
+class BurstTest {
+
+  /** A clock that only moves when the code under test sleeps or a run takes time. */
+  private class FakeClock {
+    var ns = 0L
+
+    fun now() = ns
+
+    fun sleep(ms: Long) {
+      ns += ms * 1_000_000
+    }
+
+    fun advanceMs(ms: Long) = sleep(ms)
+  }
+
+  // The Galaxy S26 (SM8850): policy0 = cpu 0-5, policy6 = cpu 6-7.
+  private val hw = listOf(3_628_800L, 4_742_400L)
+  private val low = listOf(2_496_000L, 2_438_400L)
+
+  private fun pacer(clock: FakeClock, read: () -> List<Long?>) =
+    BurstPacer(hw, read, clock::now, clock::sleep)
+
+  @Test
+  fun pacer_waitsTheMinimumGapWhenEveryCeilingIsAtItsMaximum() {
+    val clock = FakeClock()
+    clock.advanceMs(100) // writing the previous row took 100 ms
+    val wait = pacer(clock) { hw }.await(sinceNs = 0)
+    assertEquals(500.0, wait.waitedMs, 0.0)
+    assertEquals(1, wait.polls)
+    assertFalse(wait.timedOut)
+  }
+
+  @Test
+  fun pacer_pollsEvery200MsUntilEveryPolicyIsBack() {
+    val clock = FakeClock()
+    // policy6 stays capped until 1.3 s after the previous utterance ended.
+    val wait =
+      pacer(clock) { if (clock.ns < 1_300_000_000L) listOf(hw[0], low[1]) else hw }.await(0)
+    assertEquals(1300.0, wait.waitedMs, 0.0)
+    assertEquals(5, wait.polls) // 0.5, 0.7, 0.9, 1.1, 1.3 s
+    assertFalse(wait.timedOut)
+    assertEquals(hw, wait.ceilingsKhz)
+  }
+
+  @Test
+  fun pacer_startsAnywayAfter120SecondsAndMarksIt() {
+    val clock = FakeClock()
+    val wait = pacer(clock) { low }.await(0)
+    assertEquals(120_000.0, wait.waitedMs, 0.0)
+    assertTrue(wait.timedOut)
+    assertEquals(599, wait.polls) // 0.5 s, then every 200 ms to 119.9 s, then the deadline itself
+  }
+
+  @Test
+  fun pacer_ignoresAPolicyItCannotRead() {
+    val clock = FakeClock()
+    assertTrue(BurstPacer(listOf(hw[0], null), { listOf(hw[0], 1L) }, clock::now, clock::sleep).atMax(listOf(hw[0], 1L)))
+    assertTrue(pacer(clock) { hw }.atMax(listOf(null, hw[1])))
+    assertFalse(pacer(clock) { hw }.atMax(listOf(hw[0], hw[1] - 1)))
+  }
+
+  @Test
+  fun capDropPct_isTheLargestFallOverThePoliciesOneDecimal() {
+    // r2's L1 smoke on the S26: policy0 down to 3513600 (-3.2 %), policy6 down to 3974400 (-16.2 %).
+    val min = listOf(3_513_600L, 3_974_400L)
+    assertEquals(16.2, capDropPct(min, hw)!!, 0.0)
+    assertEquals(3.2, capDropPct(min, hw, only = setOf(0))!!, 0.0)
+    assertEquals(0.0, capDropPct(hw, hw)!!, 0.0)
+    assertNull(capDropPct(listOf(null, null), hw))
+    assertEquals(16.2, capDropPct(listOf(null, 3_974_400L), hw)!!, 0.0)
+    // 15.04 % rounds to 15.0, which is not past the line.
+    assertEquals(15.0, capDropPct(listOf(3_398_400L), listOf(4_000_000L))!!, 0.0)
+  }
+
+  @Test
+  fun parseCpuList_readsRangesCommasAndSpaces() {
+    assertEquals((0..5).toSet(), parseCpuList("0-5"))
+    assertEquals(setOf(0, 1, 2, 3, 6), parseCpuList("0-3,6"))
+    assertEquals(setOf(6, 7), parseCpuList("6 7"))
+    assertTrue(parseCpuList("").isEmpty())
+    assertTrue(parseCpuList(null).isEmpty())
+  }
+
+  /** A run that takes [ms] and reads the ceilings [ceilings] once while it runs. */
+  private fun run(clock: FakeClock, ms: Long, ceilings: List<Long?>): (CeilingMin) -> String = { min ->
+    clock.advanceMs(ms / 2)
+    min.add(ceilings)
+    clock.advanceMs(ms - ms / 2)
+    "text"
+  }
+
+  @Test
+  fun rule_keepsAnAttemptAtTheLine() {
+    val clock = FakeClock()
+    val hw4 = listOf(4_000_000L)
+    val rule = BurstRule(BurstPacer(hw4, { hw4 }, clock::now, clock::sleep), hw4, { hw4 }, clock::now, clock::sleep)
+    val outcome = rule.utterance(0, run = run(clock, 800, listOf(3_400_000L))) // exactly -15.0 %
+    assertEquals(1, outcome.attempts.size)
+    assertEquals(15.0, outcome.final.dropPct!!, 0.0)
+    assertFalse(outcome.excluded)
+    assertEquals(3, outcome.final.reads) // at the start, the run's own, at the end
+    assertEquals(500.0, outcome.final.wait.waitedMs, 0.0)
+  }
+
+  @Test
+  fun rule_retakesOnceAfterTheCeilingIsBackAndFiveSecondsMore() {
+    val clock = FakeClock()
+    var firstEndNs = Long.MAX_VALUE
+    // Capped from just after the first attempt ended until 2 s later.
+    val read = { if (clock.ns > firstEndNs && clock.ns < firstEndNs + 2_000_000_000L) low else hw }
+    val rule = BurstRule(pacer(clock, read), hw, read, clock::now, clock::sleep)
+    var calls = 0
+    val outcome =
+      rule.utterance(0) { min ->
+        calls++
+        if (calls == 1) {
+          clock.advanceMs(500)
+          min.add(listOf(hw[0], 3_793_920L)) // policy6 -20 %
+          clock.advanceMs(500)
+          firstEndNs = clock.ns
+          "first"
+        } else {
+          run(clock, 1000, hw)(min)
+          "second"
+        }
+      }
+    assertEquals(2, outcome.attempts.size)
+    assertEquals("first", outcome.attempts[0].value)
+    assertEquals(20.0, outcome.attempts[0].dropPct!!, 0.0)
+    assertEquals("second", outcome.final.value)
+    assertEquals(0.0, outcome.final.dropPct!!, 0.0)
+    assertFalse(outcome.excluded)
+    // Back at 2.1 s after the first attempt (polls at 0.5, 0.7, ..., 2.1 s), then 5 s more.
+    assertEquals(7100.0, outcome.final.wait.waitedMs, 0.0)
+    assertEquals(outcome.attempts[0].endNs + 7_100_000_000L, outcome.final.startNs)
+  }
+
+  @Test
+  fun rule_excludesAnUtteranceWhoseRetakeIsPastTheLineToo() {
+    val clock = FakeClock()
+    val rule = BurstRule(pacer(clock) { hw }, hw, { hw }, clock::now, clock::sleep)
+    val outcome = rule.utterance(0, run = run(clock, 1000, low))
+    assertEquals(2, outcome.attempts.size)
+    assertEquals(48.6, outcome.final.dropPct!!, 0.0)
+    assertTrue(outcome.excluded)
+  }
+
+  @Test
+  fun rule_doesNotRetakeAFailedAttempt() {
+    val clock = FakeClock()
+    val rule = BurstRule(pacer(clock) { hw }, hw, { hw }, clock::now, clock::sleep)
+    val outcome = rule.utterance(0, retakeAllowed = { it != "error" }) { min ->
+      min.add(low)
+      "error"
+    }
+    assertEquals(1, outcome.attempts.size)
+    assertTrue(outcome.excluded)
+  }
+
+  @Test
+  fun s16_isEveryEighthRowOfS4FromTheFirst() {
+    // LibriSpeech test-clean: 2620 rows -> S16 = 164 (index 0, 16, ..., 2608); W = row 1 is outside.
+    val rows = (0 until 2620).map { ManifestRow("utt-$it", "/sets/utt-$it.wav", 1.0) }
+    val s16 = BenchManifest.stride(rows, 16)
+    assertEquals(164, s16.size)
+    assertEquals(listOf("utt-0", "utt-16"), s16.take(2).map { it.id })
+    assertEquals("utt-2608", s16.last().id)
+    assertFalse(s16.any { it.id == "utt-1" })
+    assertTrue(BenchManifest.stride(rows, 4).map { it.id }.containsAll(s16.map { it.id }))
+    assertEquals(10, BenchManifest.stride(rows, 16).take(10).size)
+  }
+
+  @Test
+  fun utteranceRow_carriesTheBurstFields() {
+    val row =
+      JSONObject(
+        BenchJson.utterance(
+          UtteranceResult(
+            id = "1089-134686-0000",
+            text = "he hoped",
+            audioSeconds = 10.435,
+            processingSeconds = 0.61234,
+            extra =
+              linkedMapOf(
+                "wait_s" to 0.5,
+                "wait_timed_out" to false,
+                "cap_drop_pct" to 3.2,
+                "cap_min_khz" to linkedMapOf("policy0" to 3_513_600L, "policy6" to null),
+                "attempts" to 2,
+                "retake" to linkedMapOf("first" to linkedMapOf("cap_drop_pct" to 20.0, "text" to "he hoped")),
+                "excluded" to false,
+                "stage_ms" to linkedMapOf("feature" to 12.5, "decode" to 400.25),
+              ),
+          )
+        )
+      )
+    assertEquals("1089-134686-0000", row.getString("id"))
+    assertEquals(0.612, row.getDouble("processing_seconds"), 0.0)
+    assertEquals(0.5, row.getDouble("wait_s"), 0.0)
+    assertEquals(3_513_600L, row.getJSONObject("cap_min_khz").getLong("policy0"))
+    assertTrue(row.getJSONObject("cap_min_khz").isNull("policy6"))
+    assertEquals(20.0, row.getJSONObject("retake").getJSONObject("first").getDouble("cap_drop_pct"), 0.0)
+    assertEquals(400.25, row.getJSONObject("stage_ms").getDouble("decode"), 0.0)
+    assertFalse(row.getBoolean("excluded"))
+    // The sherpa arm has no windows: the window fields stay, empty.
+    assertEquals(0, row.getInt("windows"))
+    assertEquals(0, row.getJSONArray("mel_ms").length())
+  }
+
+  @Test(expected = IllegalArgumentException::class)
