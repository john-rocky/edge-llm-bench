+        "overlap_ms" to FILE_AUDIO_CHUNK_OVERLAP_DURATION.inWholeMilliseconds,
+        "max_levenshtein_distance" to FILE_MAX_LEVENSHTEIN_DISTANCE,
+        "gpu_precision" to if (modelConfig.gpuEnforceFloat32) "FP32" else "DEFAULT",
+        "gpu_constant_tensor_sharing" to modelConfig.gpuShareConstantTensors,
+        "npu_htp_performance_mode" to
+          if (modelConfig.npuHighPerformance) "HIGH_PERFORMANCE" else "DEFAULT",
+        "tdt_decoder" to modelKey.contains("-tdt"),
+        "tdt_max_symbols_per_step" to TdtDecoder.MAX_SYMBOLS_PER_STEP,
+        "tdt_time_limit" to
+          "TdtDecoder.getTimeLimit: min(maxTimeIndex, ceil(n / 8) + 4), n = floor(v / hop_length), " +
+            "v = getNumOfValidSamples(window)",
+        "hop_length" to pipeline.hopLength,
+        "load_seconds" to pipeline.loadMs / 1000.0,
+        "load_ms" to pipeline.loadMs,
+        "load_scope" to "LiteRtRunner constructor (CompiledModel.create + decoder and I/O buffers)",
+        "tokenizer_ms" to pipeline.tokenizerMs,
+        "preprocessor_ms" to pipeline.preprocessorMs,
+      )
+
+    override fun modelHashes(): Map<String, Any?> = linkedMapOf("model_sha256" to sha256(listOf(modelFile)))
+
+    override fun close() = pipeline.close()
