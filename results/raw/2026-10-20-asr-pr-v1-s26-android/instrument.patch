+  @Test
+  fun transcribeManifest() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val engineName = (args.getString("engine") ?: "litert").lowercase(Locale.ROOT)
+    require(engineName == "litert" || engineName == "sherpa") { "engine must be litert or sherpa" }
+    val pace = (args.getString("pace") ?: "none").lowercase(Locale.ROOT)
+    require(pace == "none" || pace == "burst") { "pace must be none or burst" }
+    val modelKey =
+      args.getString("model") ?: if (engineName == "sherpa") SHERPA_MODEL_DIR else "parakeet-tdt-0.6b-v3"
+    val acceleratorName = (args.getString("accelerator") ?: "cpu").lowercase(Locale.ROOT)
+    require(acceleratorName in setOf("cpu", "gpu", "npu")) { "accelerator must be cpu, gpu or npu" }
+    require(engineName == "litert" || acceleratorName == "cpu") { "the sherpa engine runs on the CPU" }
+    val manifestFile = File(requireNotNull(args.getString("manifest")) { "manifest is required" })
+    val every = args.int("every", 1)
+    val limit = args.int("limit", 0)
+    val startAfter = args.getString("start_after")
+    val failedId = args.getString("failed_id")
+    val warmupId = args.getString("warmup_id")
+    val outDir =
+      File(args.getString("out") ?: File(context.getExternalFilesDir(null), "bench").path).apply {
+        mkdirs()
+      }
+    val tag = args.getString("tag") ?: "$modelKey-$acceleratorName"
+    val foregroundMode =
+      when (val f = args.getString("foreground")) {
+        null,
+        "false" -> null
+        "main" -> "main"
+        "true",
+        "front" -> "front"
+        else -> throw IllegalArgumentException("foreground must be front, main or false, got $f")
+      }
+    val requireTopApp = args.getString("require_top_app") == "true"
+
+    val manifestRows = BenchManifest.parse(manifestFile.readText(), manifestFile.parent)
+    val selection =
+      BenchManifest.stride(manifestRows, every).let { if (limit > 0) it.take(limit) else it }
+    val todo = if (startAfter != null) BenchManifest.after(selection, startAfter) else selection
+    val warmupRow =
+      warmupId?.let { id ->
+        requireNotNull(manifestRows.firstOrNull { it.id == id }) { "warmup_id $id is not in the manifest" }
+      }
+    val jsonl = FileOutputStream(File(outDir, "$tag.jsonl"), true)
+    fun emit(line: String) {
+      jsonl.write((line + "\n").toByteArray())
+      jsonl.flush()
+    }
+
+    val processStart = SystemClock.elapsedRealtimeNanos()
+    val sampler = MemorySampler(File(outDir, "$tag.vmhwm.log"), processStart).start()
+    val processAtStart = processState()
+    var foregroundError: String? = null
+    val scenario =
+      if (foregroundMode != null) {
+        try {
+          launchForeground(foregroundMode)
+        } catch (e: Throwable) {
+          foregroundError = "${e.javaClass.simpleName}: ${e.message}"
+          Log.e(TAG, "foreground activity failed", e)
+          null
+        }
+      } else {
+        null
+      }
+    val foregroundState = scenario?.state?.name
+    // The process moves to the top-app cpuset after its activity resumed: wait for it (at most 3 s).
+    val topAppWaitMs = if (scenario != null) waitForCpuset("top-app", 3000) else null
+    val processAfterForeground = processState()
+    val topApp = (processAfterForeground["cpuset"] as String?)?.contains("top-app") == true
+    val screenStart = screenState(context)
+    val thermalStart = thermalStatus(context)
+    val batteryStart = batteryCelsius(context)
+    val foregroundInfo =
+      linkedMapOf<String, Any?>(
+        "foreground" to foregroundMode,
+        "foreground_state" to foregroundState,
+        "foreground_error" to foregroundError,
+        "foreground_top_app" to topApp,
+        "foreground_top_app_wait_ms" to topAppWaitMs,
+        "require_top_app" to requireTopApp,
+        "screen_start" to screenStart,
+      )
+    Log.i(
+      TAG,
+      "start tag=$tag engine=$engineName model=$modelKey accelerator=$acceleratorName pace=$pace " +
+        "todo=${todo.size} foreground=$foregroundState top_app=$topApp cpuset=${processAfterForeground["cpuset"]}",
+    )
+    if (requireTopApp && !(foregroundState == "RESUMED" && topApp)) {
+      // The run was asked to measure as the resumed top app only: record where it is and stop
+      // before the load (asr-burst-v1 keeps one form for every arm).
+      val reason = "not the resumed top app (state $foregroundState, cpuset ${processAfterForeground["cpuset"]})"
+      emit(
+        BenchJson.header(
+          linkedMapOf<String, Any?>("harness" to BenchJson.BURST_HARNESS, "tag" to tag, "engine" to engineName,
+            "model_name" to modelKey, "backend" to acceleratorName, "aborted" to reason) +
+            foregroundInfo +
+            linkedMapOf("process_state" to linkedMapOf("start" to processAtStart, "after_foreground" to processAfterForeground),
+              "pid" to Process.myPid(), "started_utc" to iso(Date()))
+        )
+      )
+      emit(BenchJson.footer(linkedMapOf("tag" to tag, "aborted" to reason, "utterances_done" to 0, "finished_utc" to iso(Date()))))
+      jsonl.close()
+      scenario?.close()
+      sampler.stop()
+      File(outDir, "$tag.done").writeText("aborted: $reason\n")
+      Log.e(TAG, "aborted tag=$tag: $reason")
+      return
+    }
+
+    if (failedId != null) {
+      // The previous process of this run died on this utterance (watchdog or crash).
+      val row = selection.first { it.id == failedId }
+      emit(
+        BenchJson.utterance(
+          UtteranceResult(
+            row.id,
+            "",
+            row.seconds,
+            0.0,
+            error = args.getString("failed_kind") ?: "crash",
+          )
+        )
+      )
+    }
+
+    val engine: Engine =
+      if (engineName == "sherpa") {
+        SherpaEngine(context, modelKey, args.getString("sherpa_debug") == "true")
+      } else {
+        LiteRtEngine(
+          context,
+          modelKey,
+          when (acceleratorName) {
+            "gpu" -> Accelerator.GPU
+            "npu" -> Accelerator.NPU
+            else -> Accelerator.CPU
+          },
+        )
+      }
+    Log.i(TAG, "loaded in ${engine.loadMs} ms")
+    // This process's log so far = what the runtime logged while it built the model (accelerators, the
+    // delegate that took the graph, sherpa-onnx's config), kept before the merger's per-token lines
+    // wrap the ring buffer.
+    dumpOwnLogcat(File(outDir, "$tag.load-logcat.txt"))
+    val processAfterLoad = processState()
+    val policies = cpufreqPolicies()
+    val hwKhz = policies.map { readLong(File(it, "cpuinfo_max_freq")) }
+    val burst =
+      if (pace == "burst") {
+        BurstSettings(
+          gapMs = args.long("pace_gap_ms", 500),
+          pollMs = args.long("pace_poll_ms", 200),
+          maxWaitS = args.long("pace_max_wait_s", 120),
+          capPollMs = args.long("cap_poll_ms", 100),
+          linePct = args.getString("cap_line_pct")?.toDouble() ?: 15.0,
+          settleS = args.long("retake_settle_s", 5),
+        )
+      } else {
+        null
+      }
+    emit(
+      BenchJson.header(
+        linkedMapOf<String, Any?>(
+          "harness" to if (burst != null) BenchJson.BURST_HARNESS else BenchJson.HARNESS,
+          "tag" to tag,
+          "engine" to engineName,
+          "model_name" to modelKey,
+          "backend" to acceleratorName,
+          "app_commit" to args.getString("app_commit"),
+        ) +
+          engine.header() +
+          linkedMapOf(
+            "load_label" to args.getString("load_label"),
+            "manifest" to manifestFile.path,
+            "every" to every,
+            "limit" to limit,
+            "start_after" to startAfter,
+            "utterances_selected" to selection.size,
+            "utterances_todo" to todo.size,
+            "pace" to pace,
+            "burst" to burst?.asMap(),
+            "warmup_id" to warmupId,
+          ) +
+          foregroundInfo +
+          linkedMapOf(
+            "process_state" to
+              linkedMapOf(
+                "start" to processAtStart,
+                "after_foreground" to processAfterForeground,
+                "after_load" to processAfterLoad,
+              ),
+            "debuggable" to (context.applicationInfo.flags and ApplicationInfo.FLAG_DEBUGGABLE != 0),
+            "dexopt_app" to args.getString("dexopt_app"),
+            "dexopt_test" to args.getString("dexopt_test"),
+            "oat_files_mapped" to mappedFiles(context.packageName) { it.endsWith(".odex") || it.endsWith(".vdex") || it.endsWith(".art") || it.endsWith(".oat") },
+            "cpu_policies" to
+              policies.mapIndexed { i, p ->
+                linkedMapOf("name" to p.name, "cpus" to readText(File(p, "related_cpus")), "hw_khz" to hwKhz[i])
+              },
+            "pid" to Process.myPid(),
+            "started_utc" to iso(Date()),
+            "device" to
+              linkedMapOf(
+                "model" to Build.MODEL,
+                "soc" to Build.SOC_MODEL,
+                "android" to Build.VERSION.RELEASE,
+                "build" to Build.DISPLAY,
+                "security_patch" to Build.VERSION.SECURITY_PATCH,
+              ),
+            "thermal_status_start" to thermalStart,
+            "battery_celsius_start" to batteryStart,
+          )
+      )
+    )
+
+    if (warmupRow != null) {
+      // Outside the timing: the first utterance after the load pays one-time costs (first runs of
+      // the graph, allocator growth); its text is kept here and not scored.
+      val times = WindowTimes()
+      val attempted = attemptOne(engine, warmupRow, times)
+      emit(
+        BenchJson.warmup(
+          linkedMapOf(
+            "warmup_id" to warmupRow.id,
+            "text" to attempted.text,
+            "audio_seconds" to warmupRow.seconds,
+            "processing_seconds" to BenchJson.round3(attempted.seconds),
+            "windows" to times.encodeMs.size,
+            "stage_ms" to times.stageMs.takeIf { it.isNotEmpty() },
+            "error" to attempted.error,
+          ) + times.windowFields()
+        )
+      )
+      Log.i(TAG, "warmup ${warmupRow.id} ${attempted.seconds} s text=${attempted.text}")
+    }
+
+    val totals =
+      if (burst != null) {
+        burstLoop(engine, todo, burst, policies, hwKhz, File(outDir, "$tag.ceil.log"), processStart, ::emit)
+      } else {
+        sustainedLoop(engine, todo, ::emit)
+      }
+
+    val elapsedSeconds = (SystemClock.elapsedRealtimeNanos() - processStart) / 1e9
+    val thermalEnd = thermalStatus(context)
+    val batteryEnd = batteryCelsius(context)
+    val processAtEnd = processState()
+    val foregroundStateEnd = scenario?.state?.name
+    val loadedLibs = mappedFiles(context.applicationInfo.nativeLibraryDir) { it.endsWith(".so") }.map { File(it).name }
+    engine.close()
+    scenario?.close()
+    val memory = sampler.stop()
+    val vmHwmKb = procStatusKb("VmHWM")
+    // Witnesses, read after the measurement: the native libraries the process ran with, the model's
+    // bytes, and the WAVs of the selection in order (the chain of SET-S4.json / SET-S16.json).
+    val nativeLibs =
+      File(context.applicationInfo.nativeLibraryDir)
+        .listFiles { f -> f.name.endsWith(".so") }
+        .orEmpty()
+        .sortedBy { it.name }
+        .associate { it.name to sha256(listOf(it)) }
+    val rtf = if (totals.sumAudio > 0) totals.sumWall / totals.sumAudio else Double.NaN
+    emit(
+      BenchJson.footer(
+        linkedMapOf<String, Any?>(
+          "tag" to tag,
+          "utterances_done" to totals.done,
+          "utterances_failed" to totals.failed,
+          "sum_audio_seconds" to totals.sumAudio,
+          "sum_processing_seconds" to totals.sumWall,
+          "rtf" to rtf,
+          "rtfx" to 1.0 / rtf,
+          "median_utterance_rtf" to median(totals.utteranceRtf),
+        ) +
+          totals.burst +
+          linkedMapOf(
+            "vmhwm_kb" to vmHwmKb,
+            "peak_rss_bytes" to vmHwmKb?.let { it * 1024 },
+            "sampler_max_rss_kb" to memory.first,
+            "sampler_max_hwm_kb" to memory.second,
+            "memory_scope" to "instrumentation process = the app process (ART, test runner, app)",
+            "cpus_allowed_seen" to sampler.cpusAllowedSeen(),
+            "cpuset_seen" to sampler.cpusetSeen(),
+            "cpu_ceilings" to sampler.cpuCeilings(),
+            "process_state_end" to processAtEnd,
+            "foreground_state_end" to foregroundStateEnd,
+            "thermal_status_end" to thermalEnd,
+            "battery_celsius_end" to batteryEnd,
+            "elapsed_seconds" to elapsedSeconds,
+          ) +
+          engine.modelHashes() +
+          linkedMapOf(
+            "selection_wav_sha256_chain" to sha256(selection.map { File(it.wavPath) }),
+            "warmup_wav_sha256" to warmupRow?.let { sha256(listOf(File(it.wavPath))) },
+            "native_libs" to nativeLibs,
+            "native_libs_loaded" to loadedLibs,
+            "finished_utc" to iso(Date()),
+          )
+      )
+    )
+    jsonl.close()
+    File(outDir, "$tag.done").writeText("done=${totals.done} failed=${totals.failed} rtf=$rtf\n")
+    Log.i(TAG, "done tag=$tag done=${totals.done} failed=${totals.failed} rtf=$rtf vmhwm_kb=$vmHwmKb")
+  }
+
+  /** What the loops add up; [burst] = the burst run's own footer fields. */
+  private class Totals {
+    var done = 0
+    var failed = 0
+    var sumAudio = 0.0
+    var sumWall = 0.0
+    val utteranceRtf = ArrayList<Double>()
+    val burst = LinkedHashMap<String, Any?>()
+
+    fun add(row: ManifestRow, attempted: Attempted) {
+      if (attempted.error == null) {
+        done++
+        sumAudio += row.seconds
+        sumWall += attempted.seconds
+        utteranceRtf.add(attempted.seconds / row.seconds)
+      } else {
+        failed++
+      }
+    }
+  }
+
+  private class BurstSettings(
+    val gapMs: Long,
+    val pollMs: Long,
+    val maxWaitS: Long,
+    val capPollMs: Long,
+    val linePct: Double,
+    val settleS: Long,
+  ) {
+    fun asMap(): Map<String, Any?> =
+      linkedMapOf(
+        "min_gap_ms" to gapMs,
+        "ceiling_poll_ms" to pollMs,
+        "max_wait_s" to maxWaitS,
+        "cap_poll_ms" to capPollMs,
+        "cap_line_pct" to linePct,
+        "retake_settle_s" to settleS,
+        "cap_rule" to "max over every cpufreq policy of (1 - min scaling_max_freq / cpuinfo_max_freq) * 100, one decimal",
+      )
+  }
+
+  /** Starts the activity [mode] names and keeps the screen on while it is in front. */
+  @Suppress("UNCHECKED_CAST")
+  private fun launchForeground(mode: String): ActivityScenario<out Activity> =
+    if (mode == "main") {
+      ActivityScenario.launch(MainActivity::class.java).also { s ->
+        s.onActivity { it.window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON) }
+      }
+    } else {
+      // BenchFrontActivity exists in the bench build type only (src/bench), hence by name.
+      ActivityScenario.launch(Class.forName(FRONT_ACTIVITY) as Class<Activity>)
+    }
+
+  private fun attemptOne(engine: Engine, row: ManifestRow, times: WindowTimes): Attempted =
+    try {
+      val (text, seconds) = engine.transcribe(File(row.wavPath), times)
+      Attempted(text, seconds, times, null)
+    } catch (e: Throwable) {
+      Log.e(TAG, "utterance ${row.id} failed", e)
+      Attempted("", 0.0, times, "${e.javaClass.simpleName}: ${e.message}")
+    }
+
+  /** The utterances back to back (asr-litert-app-v1). */
+  private fun sustainedLoop(engine: Engine, todo: List<ManifestRow>, emit: (String) -> Unit): Totals {
+    val totals = Totals()
+    for ((index, row) in todo.withIndex()) {
+      val times = WindowTimes()
+      val attempted = attemptOne(engine, row, times)
+      emit(
+        BenchJson.utterance(
+          UtteranceResult(
+            row.id,
+            attempted.text,
+            row.seconds,
+            attempted.seconds,
+            times.melMs,
+            times.encodeMs,
+            times.decodeMs,
+            times.tokens,
+            attempted.error,
+            extra =
+              times.windowFields() +
+                if (times.stageMs.isEmpty()) emptyMap() else mapOf("stage_ms" to times.stageMs),
+          )
+        )
+      )
+      totals.add(row, attempted)
+      if ((index + 1) % 25 == 0 || index + 1 == todo.size) {
+        Log.i(TAG, "progress ${index + 1}/${todo.size} rtf=${totals.sumWall / totals.sumAudio}")
+      }
+    }
+    return totals
+  }
+
+  /** The burst rule (asr-burst-v1): wait, run, retake once past the line; one row per utterance. */
+  private fun burstLoop(
+    engine: Engine,
+    todo: List<ManifestRow>,
+    settings: BurstSettings,
+    policies: List<File>,
+    hwKhz: List<Long?>,
+    ceilingLog: File,
+    origin: Long,
+    emit: (String) -> Unit,
+  ): Totals {
+    val totals = Totals()
+    val names = policies.map { it.name }
+    val policyCpus = policies.map { parseCpuList(readText(File(it, "related_cpus"))) }
+    val log = CeilingLog(ceilingLog, origin, names, hwKhz)
+    fun read() = policies.map { readLong(File(it, "scaling_max_freq")) }
+    val now = { SystemClock.elapsedRealtimeNanos() }
+    val sleep = { ms: Long -> Thread.sleep(ms) }
+    val pacer =
+      BurstPacer(
+        hwKhz,
+        { read().also { log.add("wait", it) } },
+        now,
+        sleep,
+        settings.gapMs,
+        settings.pollMs,
+        settings.maxWaitS * 1000,
+      )
+    val rule =
+      BurstRule(pacer, hwKhz, { read().also { log.add("edge", it) } }, now, sleep, settings.linePct, settings.settleS * 1000)
+    val counted = ArrayList<Pair<ManifestRow, Attempted>>()
+    val waits = ArrayList<Double>()
+    var excluded = 0
+    var retaken = 0
+    var retakeTextDiffers = 0
+    var waitTimeouts = 0
+    var retakeWaitSum = 0.0
+    var prevEnd = SystemClock.elapsedRealtimeNanos()
+    for ((index, row) in todo.withIndex()) {
+      val cpusAtStart = procStatusText("Cpus_allowed_list")
+      val cpusetAtStart = cpusetOf(readText(File("/proc/self/cgroup")))
+      val engineIdx = policyCpus.indices.filter { policyCpus[it].intersect(parseCpuList(cpusAtStart)).isNotEmpty() }.toSet()
+      var attemptNo = 0
+      val outcome =
+        rule.utterance<Attempted>(prevEnd, retakeAllowed = { it.error == null }) { min ->
+          attemptNo++
+          log.context = "${row.id}\t$attemptNo"
+          val times = WindowTimes()
+          pollCeilings(min, settings.capPollMs, ::read, log) { attemptOne(engine, row, times) }
+        }
+      prevEnd = outcome.final.endNs
+      val first = outcome.attempts.first()
+      val last = outcome.final
+      val extra =
+        linkedMapOf<String, Any?>(
+          "attempts" to outcome.attempts.size,
+          "wait_s" to BenchJson.round3(first.wait.waitedMs / 1000.0),
+          "wait_timed_out" to first.wait.timedOut,
+          "wait_polls" to first.wait.polls,
+          "cap_drop_pct" to last.dropPct,
+          "cap_drop_engine_cpus_pct" to capDropPct(last.minKhz, hwKhz, engineIdx),
+          "cap_min_khz" to names.zip(last.minKhz).toMap(),
+          "cap_reads" to last.reads,
+          "excluded" to outcome.excluded,
+          "cpus_allowed" to cpusAtStart,
+          "cpuset" to cpusetAtStart,
+        )
+      if (outcome.attempts.size > 1) {
+        extra["retake"] =
+          linkedMapOf(
+            "first" to
+              linkedMapOf(
+                "processing_seconds" to BenchJson.round3(first.value.seconds),
+                "cap_drop_pct" to first.dropPct,
+                "cap_min_khz" to names.zip(first.minKhz).toMap(),
+                "cap_reads" to first.reads,
+                "text" to first.value.text,
+                "error" to first.value.error,
+              ),
+            "wait_s" to BenchJson.round3(last.wait.waitedMs / 1000.0),
+            "wait_timed_out" to last.wait.timedOut,
+            "text_same" to (first.value.text == last.value.text),
+          )
+        retaken++
+        retakeWaitSum += last.wait.waitedMs / 1000.0
+        if (first.value.text != last.value.text) retakeTextDiffers++
+      }
+      if (last.value.times.stageMs.isNotEmpty()) extra["stage_ms"] = last.value.times.stageMs
+      extra.putAll(last.value.times.windowFields())
+      val times = last.value.times
+      emit(
+        BenchJson.utterance(
+          UtteranceResult(
+            row.id,
+            last.value.text,
+            row.seconds,
+            last.value.seconds,
+            times.melMs,
+            times.encodeMs,
+            times.decodeMs,
+            times.tokens,
+            last.value.error,
+            extra,
+          )
+        )
+      )
+      log.flush()
+      totals.add(row, last.value)
+      waits.add(first.wait.waitedMs / 1000.0)
+      if (first.wait.timedOut) waitTimeouts++
+      if (outcome.excluded && last.value.error == null) excluded++
+      if (!outcome.excluded && last.value.error == null) counted.add(row to last.value)
+      if ((index + 1) % 25 == 0 || index + 1 == todo.size) {
+        Log.i(TAG, "progress ${index + 1}/${todo.size} excluded=$excluded retaken=$retaken")
+      }
+    }
+    log.close()
+    val audio = counted.sumOf { it.first.seconds }
+    val wall = counted.sumOf { it.second.seconds }
+    totals.burst.putAll(
+      linkedMapOf(
+        "utterances_counted" to counted.size,
+        "utterances_excluded" to excluded,
+        "utterances_retaken" to retaken,
+        "retake_text_differs" to retakeTextDiffers,
+        "counted_audio_seconds" to audio,
+        "counted_processing_seconds" to wall,
+        "rtf_burst" to if (audio > 0) wall / audio else null,
+        "median_utterance_rtf_burst" to median(counted.map { it.second.seconds / it.first.seconds }),
+        "wait_sum_s" to waits.sum(),
+        "wait_median_s" to median(waits),
+        "wait_max_s" to waits.maxOrNull(),
+        "wait_timeouts" to waitTimeouts,
+        "retake_wait_sum_s" to retakeWaitSum,
+      )
+    )
+    return totals
+  }
+
+  /** Runs [block] while a thread adds every policy's ceiling to [min] every [everyMs]. */
+  private fun <T> pollCeilings(
+    min: CeilingMin,
+    everyMs: Long,
+    read: () -> List<Long?>,
+    log: CeilingLog,
+    block: () -> T,
+  ): T {
+    val stop = AtomicBoolean(false)
+    val thread =
+      Thread {
+          while (!stop.get()) {
+            try {
+              Thread.sleep(everyMs)
+            } catch (e: InterruptedException) {
+              break
+            }
+            if (stop.get()) break
+            val ceilings = read()
+            min.add(ceilings)
+            log.add("run", ceilings)
+          }
+        }
+        .apply {
+          isDaemon = true
+          name = "ceiling-poller"
+          start()
+        }
+    try {
+      return block()
+    } finally {
+      stop.set(true)
+      thread.interrupt()
+      thread.join(1000)
+    }
+  }
+
+  /**
+   * `<tag>.ceil.log`: every ceiling read of a burst run while an utterance ran (run), at its start
+   * and end (edge), and the waits' reads that were below the maximum (wait).
+   */
+  private class CeilingLog(file: File, private val origin: Long, names: List<String>, private val hwKhz: List<Long?>) {
+    // Appended: a run resumed in a later process adds its reads after the earlier ones.
+    private val writer = FileOutputStream(file, true).bufferedWriter()
+    @Volatile var context: String = "-\t0"
+
+    init {
+      writer.write("# elapsed_ms\tid\tattempt\tphase" + names.joinToString("") { "\t${it}_scaling_max_kHz" } + "\n")
+      writer.write("# hw_kHz" + hwKhz.joinToString("") { "\t$it" } + "\n")
+    }
+
+    @Synchronized
+    fun add(phase: String, ceilings: List<Long?>) {
+      if (phase == "wait" && hwKhz.indices.all { i -> hwKhz[i] == null || ceilings.getOrNull(i) == null || ceilings[i]!! >= hwKhz[i]!! }) return
+      writer.write(
+        "${(SystemClock.elapsedRealtimeNanos() - origin) / 1_000_000}\t$context\t$phase" +
+          ceilings.joinToString("") { "\t${it ?: "-"}" } +
+          "\n"
+      )
+    }
+
+    @Synchronized fun flush() = writer.flush()
+
+    @Synchronized fun close() = writer.close()
+  }
+
+  // ---- MainActivity.preparePipeline (the PR branch), timed, on the IO dispatcher as in the activity.
+
+  private fun preparePipeline(
+    context: Context,
+    modelKey: String,
+    modelConfig: ModelConfig,
+    accelerator: Accelerator,
+  ): Pipeline {
+    var t = SystemClock.elapsedRealtimeNanos()
+    val logMelSpectro = modelConfig.logMelSpectro
+    val audioPreprocessor =
+      if (logMelSpectro != null) {
+        MelSpectroProcessor(SAMPLING_RATE, logMelSpectro)
+      } else {
+        DummyAudioProcessor()
+      }
+    val preprocessorMs = msSince(t)
+    t = SystemClock.elapsedRealtimeNanos()
+    val tokenizer = HuggingfaceTokenizer(context, modelConfig)
+    val tokenizerMs = msSince(t)
+    val decoderFactory: (CompiledModel, ModelConfig) -> LiteRtRunner.Decoder =
+      when {
+        modelKey.contains("-ctc-") -> { _, _ -> CtcDecoder(tokenizer.vocabSize) }
+        modelKey.contains("-tdt") -> { model, config -> TdtDecoder(model, config) }
+        else -> { model, config -> LiteRtRunner.DefaultDecoder(model, config) }
+      }
+    t = SystemClock.elapsedRealtimeNanos()
+    val speechRecognizer = LiteRtRunner(context, modelConfig, accelerator, decoderFactory)
+    val loadMs = msSince(t)
+    return Pipeline(
+      audioPreprocessor,
+      tokenizer,
+      speechRecognizer,
+      modelConfig.inputMilliseconds.milliseconds,
+      preprocessorMs,
+      tokenizerMs,
+      loadMs,
+      logMelSpectro?.hopLength ?: 0,
+    )
+  }
+
+  // ---- MainActivity.processFileAudio and transcribeAudio (the PR branch) with the wall clock of one
+  // utterance: from opening the WAV until the merger has taken the last token.
+
+  private suspend fun processFileAudio(
+    wav: File,
+    pipeline: Pipeline,
+    times: WindowTimes,
+  ): Pair<String, Double> {
+    val start = SystemClock.elapsedRealtimeNanos()
+    val text =
+      FileInputStream(wav).use { inputStream ->
+        FileAudioSource(
+            inputStream,
+            SAMPLING_RATE,
+            pipeline.modelInputInterval,
+            FILE_AUDIO_CHUNK_OVERLAP_DURATION,
+          )
+          .use { audioSource ->
+            transcribeAudio(
+              audioSource,
+              (FILE_AUDIO_CHUNK_OVERLAP_DURATION / pipeline.modelInputInterval).toFloat(),
+              FILE_MAX_LEVENSHTEIN_DISTANCE,
+              pipeline,
+              times,
+            )
+          }
+      }
+    return Pair(text, (SystemClock.elapsedRealtimeNanos() - start) / 1e9)
+  }
+
+  private suspend fun transcribeAudio(
+    audioSource: AudioSource,
+    overlapRatio: Float,
+    maxLevenshteinDistance: Int,
+    pipeline: Pipeline,
+    times: WindowTimes,
+  ): String {
+    val preprocessedChannel = Channel<Window>(Channel.BUFFERED)
+    val tokenChannel = Channel<Pair<Int, Int>>(Channel.BUFFERED)
+    val transcript = TranscriptAccumulator()
+    LevenshteinTokenMerger(
+        pipeline.tokenizer,
+        overlapRatio,
+        maxLevenshteinDistance = maxLevenshteinDistance,
+      )
+      .use { postprocessor ->
+        coroutineScope {
+          scheduleAudioPreprocessing(
+            audioSource,
+            pipeline.audioPreprocessor,
+            pipeline.hopLength,
+            preprocessedChannel,
+            times,
+          )
+          scheduleSpeechRecognition(pipeline, preprocessedChannel, tokenChannel, times)
+          scheduleTokenPostprocessing(postprocessor, tokenChannel, transcript)
+        }
+      }
+    return transcript.text()
+  }
+
+  private fun CoroutineScope.scheduleAudioPreprocessing(
+    audioSource: AudioSource,
+    audioPreprocessor: AudioPreprocessor,
+    hopLength: Int,
+    preprocessedChannel: Channel<Window>,
+    times: WindowTimes,
+  ) =
+    launch(Dispatchers.IO) {
+      try {
+        for (audioChunk in audioSource.getAudioData()) {
+          // The activity's getNumOfValidSamples(audioChunk), counted before the source refills its
+          // buffer (it hands the same array every window) and outside the mel time.
+          val samples = getNumOfValidSamples(audioChunk)
+          times.validSamples.add(samples)
+          times.validFrames.add(if (hopLength > 0) samples / hopLength else -1)
+          val t = SystemClock.elapsedRealtimeNanos()
+          val preprocessed = audioPreprocessor.process(audioChunk)
+          times.melMs.add(msSince(t))
+          preprocessedChannel.send(Window(preprocessed, samples))
+          yield()
+        }
+      } finally {
+        preprocessedChannel.close()
+      }
+    }
+
+  private fun CoroutineScope.scheduleSpeechRecognition(
+    pipeline: Pipeline,
+    preprocessedChannel: Channel<Window>,
+    tokenChannel: Channel<Pair<Int, Int>>,
+    times: WindowTimes,
+  ) =
+    launch(Dispatchers.IO) {
+      val speechRecognizer = pipeline.speechRecognizer
+      try {
+        for (window in preprocessedChannel) {
+          // recognize() runs the encoder; the decoder runs lazily inside the returned sequence, so
+          // the decode time is the time spent in the iterator's own calls (not in the channel).
+          var t = SystemClock.elapsedRealtimeNanos()
+          // MainActivity's call (the PR branch).
+          val tokenSequence = speechRecognizer.recognize(window.features, window.validSamples)
+          times.encodeMs.add(msSince(t))
+          var decodeNs = 0L
+          var tokens = 0
+          var lastTokenTime = -1
+          val iterator = tokenSequence.iterator()
+          while (true) {
+            t = SystemClock.elapsedRealtimeNanos()
+            val hasNext = iterator.hasNext()
+            val next = if (hasNext) iterator.next() else null
+            decodeNs += SystemClock.elapsedRealtimeNanos() - t
+            if (next == null) break
+            val (tokenId, timestamp) = next
+            if (tokenId != SpeechRecognizer.END_OF_SEQUENCE) {
+              tokens++
+              lastTokenTime = maxOf(lastTokenTime, timestamp)
+            }
+            tokenChannel.send(Pair(tokenId, timestamp))
+            if (tokenId == SpeechRecognizer.END_OF_SEQUENCE) break
+          }
+          times.decodeMs.add(decodeNs / 1e6)
+          times.tokens.add(tokens)
+          times.lastTokenTimes.add(lastTokenTime)
+          yield()
+        }
+      } finally {
+        tokenChannel.close()
+      }
+    }
+
+  private fun CoroutineScope.scheduleTokenPostprocessing(
+    postprocessor: Postprocessor,
+    tokenChannel: Channel<Pair<Int, Int>>,
+    transcript: TranscriptAccumulator,
+  ) =
+    launch(Dispatchers.Default) {
+      // The activity hands every non-null result to updateTranscriptionUI on the main thread;
+      // the accumulator keeps the text that view would show.
+      for ((tokenId, timestamp) in tokenChannel) {
+        transcript.add(postprocessor.decode(tokenId, timestamp))
+      }
+    }
+
+  // ---- Device state and memory.
+
+  /**
+   * Samples VmRSS and VmHWM of this process, the CPUs it may run on, its cpuset and every cpufreq
+   * policy's ceiling (scaling_max_freq, when readable) every second into a log; keeps the maxima,
+   * the lowest ceiling per policy and every Cpus_allowed_list and cpuset seen (edge-llm-bench
+   * cpu-cap-rule).
+   */
+  private class MemorySampler(private val log: File, private val origin: Long) {
+    private val stop = AtomicBoolean(false)
+    private var maxRss = 0L
+    private var maxHwm = 0L
+    private val policies = cpufreqPolicies()
+    private val minCeilingKhz = HashMap<String, Long>()
+    private val cpusAllowed = LinkedHashSet<String>()
+    private val cpusets = LinkedHashSet<String>()
+    private lateinit var thread: Thread
+
+    fun start(): MemorySampler {
+      thread =
+        Thread {
+            log.appendText(
+              "# elapsed_ms\tVmRSS_kB\tVmHWM_kB\tCpus_allowed_list" +
+                policies.joinToString("") { "\t${it.name}_scaling_max_kHz" } +
+                "\tcpuset (pid ${Process.myPid()})\n"
+            )
+            while (!stop.get()) {
+              val rss = procStatusKb("VmRSS") ?: 0L
+              val hwm = procStatusKb("VmHWM") ?: 0L
+              val cpus = procStatusText("Cpus_allowed_list") ?: ""
+              val ceilings = policies.map { readLong(File(it, "scaling_max_freq")) }
+              val cpuset = cpusetOf(readText(File("/proc/self/cgroup"))) ?: ""
+              synchronized(this) {
+                maxRss = maxOf(maxRss, rss)
+                maxHwm = maxOf(maxHwm, hwm)
+                if (cpus.isNotEmpty()) cpusAllowed.add(cpus)
+                if (cpuset.isNotEmpty()) cpusets.add(cpuset)
+                policies.zip(ceilings).forEach { (p, khz) ->
+                  if (khz != null) minCeilingKhz[p.name] = minOf(minCeilingKhz[p.name] ?: khz, khz)
+                }
+              }
+              log.appendText(
+                "${(SystemClock.elapsedRealtimeNanos() - origin) / 1_000_000}\t$rss\t$hwm\t$cpus" +
+                  ceilings.joinToString("") { "\t${it ?: "-"}" } +
+                  "\t$cpuset\n"
+              )
+              try {
+                Thread.sleep(1000)
+              } catch (e: InterruptedException) {
+                break
+              }
+            }
+          }
+          .apply {
+            isDaemon = true
+            name = "vmhwm-sampler"
+            start()
+          }
+      return this
+    }
+
+    /** Returns (max VmRSS kB, max VmHWM kB). */
+    fun stop(): Pair<Long, Long> {
+      stop.set(true)
+      thread.interrupt()
+      thread.join(2000)
+      return synchronized(this) { Pair(maxRss, maxHwm) }
+    }
+
+    /** Per policy: its CPUs, hardware maximum and the lowest ceiling read (null = unreadable). */
+    fun cpuCeilings(): Map<String, Map<String, Any?>> =
+      synchronized(this) {
+        policies.associate {
+          it.name to
+            linkedMapOf(
+              "cpus" to readText(File(it, "related_cpus")),
+              "hw_khz" to readLong(File(it, "cpuinfo_max_freq")),
+              "min_khz" to minCeilingKhz[it.name],
+            )
+        }
+      }
+
+    fun cpusAllowedSeen(): List<String> = synchronized(this) { cpusAllowed.toList() }
+
+    fun cpusetSeen(): List<String> = synchronized(this) { cpusets.toList() }
+  }
+
+  private companion object {
+    const val TAG = "AsrBench"
+    const val MODEL_METADATA_PATH = "model_metadata.json"
+
+    // MainActivity's file-path constants (the PR branch).
+    const val SAMPLING_RATE = 16000
+    val FILE_AUDIO_CHUNK_OVERLAP_DURATION = 2.seconds
+    const val FILE_MAX_LEVENSHTEIN_DISTANCE = 5
+
+    const val FRONT_ACTIVITY = "com.google.ai.edge.examples.asr.BenchFrontActivity"
+
+    // The sherpa-onnx arm: the k2-fsa release model sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8.
+    const val SHERPA_MODEL_DIR = "sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8"
+    val SHERPA_FILES = listOf("encoder.int8.onnx", "decoder.int8.onnx", "joiner.int8.onnx", "tokens.txt")
+    const val SHERPA_NUM_THREADS = 4
+
+    fun Bundle.int(name: String, default: Int) = getString(name)?.toInt() ?: default
+
+    fun Bundle.long(name: String, default: Long) = getString(name)?.toLong() ?: default
+
+    fun msSince(startNs: Long) = (SystemClock.elapsedRealtimeNanos() - startNs) / 1e6
+
+    fun cpufreqPolicies(): List<File> =
+      File("/sys/devices/system/cpu/cpufreq")
+        .listFiles { f -> f.name.startsWith("policy") }
+        .orEmpty()
+        .sortedBy { it.name.removePrefix("policy").toIntOrNull() ?: Int.MAX_VALUE }
+
+    fun procStatusText(key: String): String? =
+      try {
+        File("/proc/self/status").useLines { lines ->
+          lines.firstOrNull { it.startsWith("$key:") }?.substringAfter(':')?.trim()
+        }
+      } catch (e: Exception) {
+        null
+      }
+
+    fun procStatusKb(key: String): Long? =
+      procStatusText(key)?.split(Regex("\\s+"))?.firstOrNull()?.toLongOrNull()
+
+    fun readText(file: File): String? =
+      try {
+        file.readText().trim()
+      } catch (e: Exception) {
+        null
+      }
+
+    fun readLong(file: File): Long? = readText(file)?.toLongOrNull()
+
+    /** The cpuset line of /proc/self/cgroup ("…:cpuset:/top-app"), else the whole text on one line. */
+    fun cpusetOf(cgroup: String?): String? {
+      if (cgroup == null) return null
+      val lines = cgroup.lines().filter { it.isNotBlank() }
+      return lines.firstOrNull { it.contains(":cpuset:") } ?: lines.joinToString(";")
+    }
+
+    /** Polls this process's cpuset until it names [name]: the ms that took, or null after [maxMs]. */
+    fun waitForCpuset(name: String, maxMs: Long): Long? {
+      val t0 = SystemClock.elapsedRealtime()
+      while (true) {
+        if (cpusetOf(readText(File("/proc/self/cgroup")))?.contains(name) == true) {
+          return SystemClock.elapsedRealtime() - t0
+        }
+        if (SystemClock.elapsedRealtime() - t0 >= maxMs) return null
+        Thread.sleep(100)
+      }
+    }
+
+    /** Where the process may run now: Cpus_allowed_list and its cgroup lines. */
+    fun processState(): Map<String, Any?> =
+      linkedMapOf(
+        "cpus_allowed" to procStatusText("Cpus_allowed_list"),
+        "cpuset" to cpusetOf(readText(File("/proc/self/cgroup"))),
+        "cgroup" to readText(File("/proc/self/cgroup"))?.lines()?.filter { it.isNotBlank() },
+      )
+
+    /** The distinct paths in /proc/self/maps that contain [under] and pass [keep]. */
+    fun mappedFiles(under: String, keep: (String) -> Boolean): List<String> =
+      try {
+        File("/proc/self/maps")
+          .readLines()
+          .mapNotNull { line -> line.substringAfter('/', "").takeIf { it.isNotEmpty() }?.let { "/$it" } }
+          .filter { it.contains(under) && keep(it) }
+          .distinct()
+          .sorted()
+      } catch (e: Exception) {
+        emptyList()
+      }
+
+    /** Appends `logcat -d --pid=<this process>` to [file] (an app may read its own log). */
+    fun dumpOwnLogcat(file: File) {
+      try {
+        val process =
+          ProcessBuilder("logcat", "-d", "-v", "threadtime", "--pid=${Process.myPid()}")
+            .redirectErrorStream(true)
+            .start()
+        val text = process.inputStream.bufferedReader().use { it.readText() }
+        process.waitFor()
+        file.appendText("# logcat --pid=${Process.myPid()} at ${iso(Date())}\n$text")
+      } catch (e: Exception) {
+        Log.w(TAG, "logcat dump failed", e)
+      }
+    }
+
+    fun thermalStatus(context: Context): Int =
+      (context.getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus
+
+    /** Whether the screen is on and the keyguard up when the run starts (MainActivity needs both). */
+    fun screenState(context: Context): Map<String, Any?> {
+      val keyguard = context.getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
+      return linkedMapOf(
+        "interactive" to (context.getSystemService(Context.POWER_SERVICE) as PowerManager).isInteractive,
+        "keyguard_locked" to keyguard.isKeyguardLocked,
+        "device_locked" to keyguard.isDeviceLocked,
+      )
+    }
+
+    fun batteryCelsius(context: Context): Double? =
+      context
+        .registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        ?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, Int.MIN_VALUE)
+        ?.takeIf { it != Int.MIN_VALUE }
+        ?.let { it / 10.0 }
+
+    /** SHA-256 over the bytes of [files] in order (one file: its own hash). */
+    fun sha256(files: List<File>): String {
+      val digest = MessageDigest.getInstance("SHA-256")
+      val buffer = ByteArray(1 shl 20)
+      for (file in files) {
+        FileInputStream(file).use { input ->
+          while (true) {
+            val n = input.read(buffer)
+            if (n < 0) break
+            digest.update(buffer, 0, n)
+          }
+        }
+      }
+      return digest.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    fun iso(date: Date): String =
+      SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
+        .apply { timeZone = TimeZone.getTimeZone("UTC") }
+        .format(date)
+  }
+}
