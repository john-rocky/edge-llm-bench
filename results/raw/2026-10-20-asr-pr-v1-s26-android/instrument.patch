+package com.google.ai.edge.examples.asr.bench
+
+private const val NS_PER_MS = 1_000_000L
+
+private fun ceilDiv(a: Long, b: Long) = (a + b - 1) / b
+
+/**
+ * The burst pacing of asr-burst-v1 (edge-llm-bench docs/asr-burst-v1.md): an utterance starts at
+ * least [minGapMs] after the previous one ended, and only once every cpufreq policy's ceiling
+ * (scaling_max_freq) is back at its hardware maximum (cpuinfo_max_freq), read every [pollMs], for at
+ * most [maxWaitMs] (then it starts anyway and the wait is marked). The clock, the sleep and the
+ * ceiling read are passed in, so the JVM tests drive them.
+ */
+class BurstPacer(
+  private val hwKhz: List<Long?>,
+  private val readCeilings: () -> List<Long?>,
+  private val nowNs: () -> Long,
+  private val sleepMs: (Long) -> Unit,
+  val minGapMs: Long = 500,
+  val pollMs: Long = 200,
+  val maxWaitMs: Long = 120_000,
+) {
+  /** One wait: from the end of the previous utterance to the moment this one may start. */
+  data class Wait(
+    val waitedMs: Double,
+    val timedOut: Boolean,
+    val polls: Int,
+    val ceilingsKhz: List<Long?>,
+  )
+
+  /** True when every policy whose maximum and ceiling were both read sits at its maximum. */
+  fun atMax(ceilingsKhz: List<Long?>): Boolean =
+    hwKhz.indices.all { i ->
+      val hw = hwKhz[i]
+      val now = ceilingsKhz.getOrNull(i)
+      hw == null || now == null || now >= hw
+    }
+
+  /** Waits from [sinceNs], the end of the previous utterance. */
+  fun await(sinceNs: Long): Wait {
+    val gapEndNs = sinceNs + minGapMs * NS_PER_MS
+    val deadlineNs = sinceNs + maxWaitMs * NS_PER_MS
+    var t = nowNs()
+    if (t < gapEndNs) sleepMs(ceilDiv(gapEndNs - t, NS_PER_MS))
+    var polls = 0
+    while (true) {
+      val ceilings = readCeilings()
+      polls++
+      t = nowNs()
+      if (atMax(ceilings)) return Wait((t - sinceNs) / 1e6, false, polls, ceilings)
+      if (t >= deadlineNs) return Wait((t - sinceNs) / 1e6, true, polls, ceilings)
+      sleepMs(minOf(pollMs, ceilDiv(deadlineNs - t, NS_PER_MS)))
+    }
+  }
+}
+
+/** The lowest ceiling per policy over the reads taken while one attempt ran (read from two threads). */
+class CeilingMin(private val hwKhz: List<Long?>) {
+  private val minKhz = arrayOfNulls<Long>(hwKhz.size)
+  private var reads = 0
+
+  @Synchronized
+  fun add(ceilingsKhz: List<Long?>) {
+    reads++
+    for (i in minKhz.indices) {
+      val v = ceilingsKhz.getOrNull(i) ?: continue
+      minKhz[i] = minOf(minKhz[i] ?: v, v)
+    }
+  }
+
+  @Synchronized fun reads(): Int = reads
+
+  @Synchronized fun minKhz(): List<Long?> = minKhz.toList()
+
+  fun dropPct(only: Set<Int>? = null): Double? = capDropPct(minKhz(), hwKhz, only)
+}
+
+/**
+ * How far the ceilings fell: the largest (1 - min / hw) * 100 over the policies, one decimal, as
+ * edge-llm-bench's cpu-cap-rule computes cpu_cap_drop_pct; null when no policy was read. [only]
+ * keeps the policies at those indices (e.g. the policies of the CPUs the process may run on).
+ */
+fun capDropPct(minKhz: List<Long?>, hwKhz: List<Long?>, only: Set<Int>? = null): Double? {
+  val drops =
+    minKhz.indices.mapNotNull { i ->
+      if (only != null && i !in only) return@mapNotNull null
+      val min = minKhz[i]
+      val hw = hwKhz.getOrNull(i)
+      if (min == null || hw == null || hw <= 0) null else maxOf(0.0, (1.0 - min.toDouble() / hw) * 100.0)
+    }
+  return drops.maxOrNull()?.let { Math.round(it * 10.0) / 10.0 }
+}
+
+/** The CPUs of a list such as "0-5" or "0-3,6" (Cpus_allowed_list, related_cpus with commas). */
+fun parseCpuList(spec: String?): Set<Int> {
+  if (spec.isNullOrBlank()) return emptySet()
+  return spec
+    .split(',', ' ')
+    .filter { it.isNotBlank() }
+    .flatMap { part ->
+      val bounds = part.trim().split('-')
+      val first = bounds[0].toInt()
+      (first..(bounds.getOrNull(1)?.toInt() ?: first)).toList()
+    }
+    .toSet()
+}
+
+/**
+ * One utterance under the burst rule: wait ([BurstPacer]), run once, and when the ceiling fell
+ * past [linePct] during the run, wait until it is back plus [settleMs], then run once more. The
+ * last attempt's fall decides whether the utterance counts toward RTF_burst; [retakeAllowed] says
+ * no for an attempt that failed (it is recorded, not repeated).
+ */
+class BurstRule(
+  private val pacer: BurstPacer,
+  private val hwKhz: List<Long?>,
+  private val readCeilings: () -> List<Long?>,
+  private val nowNs: () -> Long,
+  private val sleepMs: (Long) -> Unit,
+  val linePct: Double = 15.0,
+  val settleMs: Long = 5_000,
+) {
+  class Attempt<T>(
+    val value: T,
+    val wait: BurstPacer.Wait,
+    val startNs: Long,
+    val endNs: Long,
+    val minKhz: List<Long?>,
+    val reads: Int,
+    val dropPct: Double?,
+  )
+
+  class Outcome<T>(val attempts: List<Attempt<T>>, val excluded: Boolean) {
+    val final: Attempt<T>
+      get() = attempts.last()
+  }
+
+  fun over(dropPct: Double?): Boolean = dropPct != null && dropPct > linePct
+
+  /** [run] performs the attempt; it may add its own ceiling reads to the [CeilingMin] it gets. */
+  fun <T> utterance(
+    prevEndNs: Long,
+    retakeAllowed: (T) -> Boolean = { true },
+    run: (CeilingMin) -> T,
+  ): Outcome<T> {
+    val first = attempt(pacer.await(prevEndNs), run)
+    if (!over(first.dropPct) || !retakeAllowed(first.value)) {
+      return Outcome(listOf(first), excluded = over(first.dropPct))
+    }
+    val back = pacer.await(first.endNs)
+    sleepMs(settleMs)
+    val wait = back.copy(waitedMs = (nowNs() - first.endNs) / 1e6)
+    val second = attempt(wait, run)
+    return Outcome(listOf(first, second), excluded = over(second.dropPct))
+  }
+
+  private fun <T> attempt(wait: BurstPacer.Wait, run: (CeilingMin) -> T): Attempt<T> {
+    val min = CeilingMin(hwKhz)
+    min.add(readCeilings())
+    val start = nowNs()
+    val value = run(min)
+    val end = nowNs()
+    min.add(readCeilings())
+    return Attempt(value, wait, start, end, min.minKhz(), min.reads(), min.dropPct())
+  }
+}
