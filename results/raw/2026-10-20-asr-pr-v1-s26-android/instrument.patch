+/**
+ * Runs one speech recognizer over a manifest of WAV files, one utterance after the other in one
+ * process, and writes one JSONL row per utterance (edge-llm-bench docs/asr-litert-app-v1.md for the
+ * sustained runs, docs/asr-burst-v1.md for the burst runs).
+ *
+ * Engines:
+ * - litert (default): the app's file-transcription pipeline. It is MainActivity's file path on the
+ *   PR branch below this commit (the decoder change: TdtDecoder stops where a window's audio ends
+ *   and caps the tokens per time index), copied below with timing hooks and without the UI:
+ *   FileAudioSource (5 s or 30 s windows, 2 s overlap) -> MelSpectroProcessor -> LiteRtRunner + TdtDecoder ->
+ *   LevenshteinTokenMerger, in the activity's three coroutines and channels. The model is built
+ *   once per process the way preparePipeline builds it. As in the activity, the preprocessing
+ *   coroutine hands each window's getNumOfValidSamples on with its features and the recognition
+ *   coroutine calls recognize(features, numOfValidSamples) (edge-llm-bench asr-pr-v1).
+ * - sherpa: sherpa-onnx's own Kotlin API from its release AAR (OfflineRecognizer, NeMo transducer,
+ *   greedy search, CPU), the whole utterance in one stream: WaveReader.readWave -> createStream ->
+ *   acceptWaveform -> decode -> getResult.
+ *
+ * Pacing:
+ * - none (default): the utterances back to back, as in the sustained runs.
+ * - burst: after the model is built, the warm-up utterance once (outside the timing), then before
+ *   each utterance a wait of at least 0.5 s and until every cpufreq ceiling is at its maximum
+ *   (BurstPacer); the ceilings are read every 100 ms while the utterance runs, and an utterance
+ *   during which one fell more than 15 % is run once more after the ceilings are back and 5 s
+ *   (BurstRule). The last attempt's row is written with its waits, ceilings and attempts.
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - engine: litert or sherpa; default litert
+ * - model: model_metadata.json key (litert), e.g. parakeet-tdt-0.6b-v3 or parakeet-tdt-0.6b-v3-30s;
+ *   the model directory under the files dir (sherpa), default
+ *   sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
+ * - accelerator: cpu, gpu or npu (litert); cpu (sherpa)
+ * - sherpa_debug: true sets OfflineModelConfig.debug (sherpa-onnx logs its config and the model's
+ *   metadata at load); default false
+ * - manifest: manifest TSV on the phone (id, WAV path relative to the manifest, seconds)
+ * - every: keep the rows at index 0, every, 2 * every, ... (4 = S4, 16 = S16); default 1
+ * - limit: keep only the first N rows of that selection; default 0 = all
+ * - start_after: resume after this id (the host restarts the run after a crash or a hang)
+ * - failed_id, failed_kind: the utterance the previous process died on; written as an error row
+ * - pace: none or burst; default none
+ * - warmup_id: a manifest id transcribed once after the load, outside the timing (burst runs)
+ * - pace_gap_ms, pace_poll_ms, pace_max_wait_s, cap_poll_ms, cap_line_pct, retake_settle_s: the
+ *   burst rule; defaults 500, 200, 120, 100, 15, 5
+ * - out: output directory; default <external files dir>/bench
+ * - tag: output file stem; <tag>.jsonl, <tag>.vmhwm.log, <tag>.ceil.log, <tag>.load-logcat.txt,
+ *   <tag>.done
+ * - load_label: cold or warm, copied to the header (the host knows the order of processes)
+ * - foreground: front (or true) keeps BenchFrontActivity in front for the whole run (the bench build
+ *   type's window, shown over the keyguard), main keeps MainActivity in front; default none
+ * - require_top_app: true stops the run before the load unless the activity is resumed and the
+ *   process is in the top-app cpuset (a header and a footer with `aborted`)
+ * - app_commit, dexopt_app, dexopt_test: what the host read (source commit, `dumpsys package`
+ *   compiler filter / reason of the app and of the test package), copied to the header
+ */
+@RunWith(AndroidJUnit4::class)
+class AsrBenchTest {
+
+  /** What MainActivity.preparePipeline builds, plus the time each part took. */
+  private class Pipeline(
+    val audioPreprocessor: AudioPreprocessor,
+    val tokenizer: Tokenizer,
+    val speechRecognizer: SpeechRecognizer,
