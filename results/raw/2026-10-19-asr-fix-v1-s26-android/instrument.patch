+    // A full window (the audio's last sample non-zero) decodes every frame.
+    window.fill(0.03f)
+    assertEquals(375, TdtDecoder.timeLimit(validFeatureFrames(validSamples(window), 160), 375))
+    // Some exact zeros at the end of a full window move the stop by at most the margin.
+    for (i in 479_000 until 480_000) window[i] = 0f
+    assertEquals(375, TdtDecoder.timeLimit(validFeatureFrames(validSamples(window), 160), 375))
+  }
+
+  // (b) The cap: at most 10 non-blank tokens at one time index, then the next one.
+
+  @Test
+  fun symbolCap_movesOnAfterTenAtOneFrame() {
+    // Frames 0 and 1 blank; from frame 2 on, 25 non-blank tokens with duration 0; then blanks.
+    val model = FakeModel(6, 4, byRun { run -> if (run < 2 || run >= 27) Choice(BLANK, 1) else Choice(3, 0) })
+    val stats = TdtGreedyLoop.Stats()
+    val out = loopDecode(model, hasDecode1 = true, maxSymbolsPerStep = 10, stats = stats)
+    assertEquals(
+      List(10) { Pair(3, 2) } + List(10) { Pair(3, 3) } + List(5) { Pair(3, 4) } +
+        Pair(SpeechRecognizer.END_OF_SEQUENCE, 6),
+      out,
+    )
+    assertEquals(2, stats.cappedFrames)
+    // 2 blanks, 25 tokens, the rest of frame 4 is a blank, then frame 5.
+    assertEquals(2 + 25 + 1 + 1, stats.steps)
+    // The first 4 tokens fill the stateless array (decode), the rest go through decode_1.
+    assertEquals(2 + 4, model.calls.count { it.signature == DECODE })
+    assertEquals(listOf(BLANK, 3, 3, 3), model.calls[5].tokenIds)
+    assertEquals(DECODE_1, model.calls[6].signature)
+  }
+
+  @Test
+  fun symbolCap_countsAgainAtANewFrame() {
+    // Frame 2: nine tokens with duration 0 and a tenth with duration 1 (the loop moves on by
+    // itself); frame 3: ten with duration 0 (the cap moves it on); then blanks.
+    val model =
+      FakeModel(
+        6,
+        4,
+        byRun { run ->
+          when {
+            run < 2 -> Choice(BLANK, 1)
+            run < 11 -> Choice(3, 0)
+            run == 11 -> Choice(3, 1)
+            run < 22 -> Choice(4, 0)
+            else -> Choice(BLANK, 1)
+          }
+        },
+      )
+    val stats = TdtGreedyLoop.Stats()
+    val out = loopDecode(model, hasDecode1 = true, maxSymbolsPerStep = 10, stats = stats)
+    assertEquals(
+      List(10) { Pair(3, 2) } + List(10) { Pair(4, 3) } + Pair(SpeechRecognizer.END_OF_SEQUENCE, 6),
+      out,
+    )
+    assertEquals(1, stats.cappedFrames)
+  }
+
+  @Test
+  fun symbolCap_endsTheLoopThatUpstreamNeverEnds() {
+    val choose = byRun { run -> if (run < 2) Choice(BLANK, 1) else Choice(3, 0) }
+    val stats = TdtGreedyLoop.Stats()
+    val model = FakeModel(10, 4, choose)
+    val out = loopDecode(model, hasDecode1 = true, maxSymbolsPerStep = 10, stats = stats)
+    // Frames 2..9 each give 10 tokens, then the cap moves on: 8 frames capped.
+    assertEquals(80, out.size - 1)
+    assertEquals(8, stats.cappedFrames)
+    assertEquals(2 + 80, model.calls.size)
+  }
+
+  @Test
+  fun symbolCap_doesNotChangeADecodeThatNeverReachesIt() {
+    for (seed in 0 until 50) {
+      val choose = randomChoice(seed, pBlank = 0.5, pZero = 0.3)
+      val upstreamModel = FakeModel(375, 4, choose)
+      val model = FakeModel(375, 4, choose)
+      val stats = TdtGreedyLoop.Stats()
+      assertEquals(
+        upstreamDecode(upstreamModel, hasDecode1 = true),
+        loopDecode(model, hasDecode1 = true, maxSymbolsPerStep = 10, stats = stats),
+      )
+      assertEquals(upstreamModel.calls, model.calls)
+      assertEquals(0, stats.cappedFrames)
+    }
+  }
+
+  @Test
+  fun stats_areResetByEachDecode() {
+    val stats = TdtGreedyLoop.Stats()
+    loopDecode(FakeModel(375, 4, byRun { Choice(1, 1) }), hasDecode1 = true, timeLimit = 129, stats = stats)
+    loopDecode(FakeModel(63, 4, byRun { Choice(BLANK, 1) }), hasDecode1 = true, stats = stats)
+    assertEquals(63, stats.timeLimit)
+    assertEquals(63, stats.steps)
+    assertEquals(0, stats.cappedFrames)
+  }
+
+  private companion object {
+    const val DECODE = "decode"
+    const val DECODE_1 = "decode_1"
+    const val NUM_DURATIONS = 5
+
+    // A small vocabulary with the blank last, as in the parakeet export (8192 = blank of 0..8192).
+    const val VOCAB = 9
+    const val BLANK = VOCAB - 1
+    const val LOGITS_PER_TOKEN = VOCAB + NUM_DURATIONS
+  }
+}
