+package com.google.ai.edge.examples.asr
+
+/**
+ * The greedy decoding loop of [TdtDecoder], apart from the model, so that it can run on made-up
+ * logits in tests. With the default [decode] arguments it is the loop TdtDecoder has always run:
+ * every encoder frame of the window, no cap on the symbols emitted at one frame.
+ */
+object TdtGreedyLoop {
+  /** No cap on the non-blank symbols emitted at one time index. */
+  const val NO_SYMBOL_CAP = 0
+
+  /** The decoder network the loop drives. */
+  interface Network {
+    /**
+     * Writes [tokenIds] into the token input of decode ([stateful] false) or decode_1 (true), runs
+     * that signature and returns its logits for every time index and token slot.
+     */
+    fun run(stateful: Boolean, tokenIds: IntArray): FloatArray
+
+    /** Makes the LSTM states the last [run] wrote the input states of the next run. */
+    fun adoptStates()
+  }
+
+  /** What one decode did: the time limit, the network runs, the frames the cap moved past. */
+  class Stats {
+    var timeLimit = 0
+      private set
+
+    var steps = 0
+      private set
+
+    var cappedFrames = 0
+      private set
+
+    internal fun reset(limit: Int) {
+      timeLimit = limit
+      steps = 0
+      cappedFrames = 0
+    }
+
+    internal fun step() {
+      steps++
+    }
+
+    internal fun capped() {
+      cappedFrames++
+    }
+  }
+
+  /**
+   * Decodes one window: yields (token id, time index) for each non-blank token, then
+   * (END_OF_SEQUENCE, [maxTimeIndex]).
+   *
+   * @param timeLimit the loop stops before this time index (at most [maxTimeIndex])
+   * @param maxSymbolsPerStep after this many non-blank tokens at one time index the loop moves to
+   *   the next one, as NeMo's max_symbols does; [NO_SYMBOL_CAP] for no cap
+   * @param stats filled while the sequence is iterated
+   */
+  fun decode(
+    network: Network,
+    maxTimeIndex: Int,
+    numOfTokenIds: Int,
+    numOfLogitsPerToken: Int,
+    numOfDurations: Int,
+    blankTokenId: Int,
+    startTokenId: Int,
+    hasDecode1: Boolean,
+    timeLimit: Int = maxTimeIndex,
+    maxSymbolsPerStep: Int = NO_SYMBOL_CAP,
+    stats: Stats = Stats(),
+  ): Sequence<Pair<Int, Int>> = sequence {
+    val limit = minOf(timeLimit, maxTimeIndex)
+    stats.reset(limit)
+
+    // Start inference with decode signature for better quality in sequence start as stateless
+    // decoding can keep context better than decode_1, stateful decoding.
+    var stateful = false
+    var numOfInferenceTokenIds = numOfTokenIds
+    var inferenceTokenIds = IntArray(numOfTokenIds) { 0 }
+    inferenceTokenIds[0] = startTokenId
+
+    var tokenIndex: Int = 0
+    var timeIndex: Int = 0
+    var symbolsAtTimeIndex = 0
+    var lastTimeIndex = 0
+    while (timeIndex < limit) {
+      if (maxSymbolsPerStep != NO_SYMBOL_CAP) {
+        if (timeIndex != lastTimeIndex) {
+          symbolsAtTimeIndex = 0
+          lastTimeIndex = timeIndex
+        }
+        if (symbolsAtTimeIndex >= maxSymbolsPerStep) {
+          // A non-blank token with duration 0 keeps the loop at one time index: move on.
+          timeIndex++
+          stats.capped()
+          continue
+        }
+      }
+
+      val logits = network.run(stateful, inferenceTokenIds)
+      stats.step()
+
+      val startIndexInCurrentTimeIndex = timeIndex * numOfInferenceTokenIds * numOfLogitsPerToken
+      // Do argmax among the logits of the current token.
+      val startIndexOfTokenId = startIndexInCurrentTimeIndex + tokenIndex * numOfLogitsPerToken
+      val endIndexOfDuration =
+        startIndexInCurrentTimeIndex + (tokenIndex + 1) * numOfLogitsPerToken
+      val endIndexOfTokenId = endIndexOfDuration - numOfDurations
+      val tokenId =
+        ((startIndexOfTokenId until endIndexOfTokenId).maxByOrNull { logits[it] }
+          ?: startIndexOfTokenId) - startIndexOfTokenId
+      if (tokenId != blankTokenId) {
+        symbolsAtTimeIndex++
+        yield(Pair(tokenId, timeIndex))
+        if (numOfInferenceTokenIds > 1) {
+          tokenIndex++
+          if (tokenIndex < numOfInferenceTokenIds) {
+            // Still room in the stateless token array: keep filling it, so the
+            // LSTM states handed to decode_1 below are computed from real
+            // tokens only (an unfilled zero slot skews them).
+          } else if (hasDecode1) { // Switch to decode_1 for stateful decoding.
+            stateful = true
+            numOfInferenceTokenIds = 1
+            inferenceTokenIds = IntArray(1) { 0 }
+            tokenIndex = 0
+          } else { // Stateless decoding reached the max token size.
+            break
+          }
+        }
+        inferenceTokenIds[tokenIndex] = tokenId
+      }
+
+      val duration =
+        ((endIndexOfTokenId until endIndexOfDuration).maxByOrNull { logits[it] }
+          ?: endIndexOfTokenId) - endIndexOfTokenId
+      timeIndex += if (duration == 0 && tokenId == blankTokenId) 1 else duration
+
+      if (numOfInferenceTokenIds == 1 && tokenId != blankTokenId) {
+        // Stateful RNN decoder: adopt the new LSTM states — but only on a non-blank emission.
+        // In RNN-T greedy decoding the prediction network advances only when a token is
+        // emitted; adopting the state on blank steps re-consumes the last token once per blank
+        // and degrades the transcript.
+        network.adoptStates()
+      }
+    }
+
+    yield(Pair(SpeechRecognizer.END_OF_SEQUENCE, maxTimeIndex))
+  }
+}
