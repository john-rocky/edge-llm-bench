+package com.google.ai.edge.examples.asr.bench
+
+/**
+ * The samples of a window that carry audio: up to and including the last non-zero sample.
+ * FileAudioSource hands every window over as a full buffer and fills the part after the audio
+ * with exact zeros, so a short window's audio ends at its last non-zero sample (asr-fix-v1).
+ */
+fun validSamples(window: FloatArray): Int {
+  var n = window.size
+  while (n > 0 && window[n - 1] == 0.0f) n--
+  return n
+}
+
+/** The feature frames of [validSamples] samples, counted as MelSpectroProcessor counts frames. */
+fun validFeatureFrames(validSamples: Int, hopLength: Int): Int = validSamples / hopLength
