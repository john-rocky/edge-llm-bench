+@RunWith(JUnit4::class)
+class TdtGreedyLoopTest {
+
+  /** A token and a duration the decoder network "predicts" at the position the loop reads. */
+  private data class Choice(val token: Int, val duration: Int)
+
+  /** One run of the network: the signature, the token ids written, the input-state buffer used. */
+  private data class Call(val signature: String, val tokenIds: List<Int>, val statesIndex: Int)
+
+  /**
+   * Stands in for the decode / decode_1 signatures: every run returns logits for every time index
+   * and token slot, all 0 except a 1 at the token and at the duration [choose] picks for that run
+   * (by run number, time index and slot, so a loop that reads the wrong position reads another
+   * prediction). It records every run, and gives up after [maxRuns] (the loop has not ended).
+   */
+  private class FakeModel(
+    val maxTimeIndex: Int,
+    val numOfTokenIds: Int,
+    val choose: (run: Int, timeIndex: Int, slot: Int) -> Choice,
+    val maxRuns: Int = 100_000,
+  ) {
+    val calls = ArrayList<Call>()
+    var inputStatesBuffersIndex = 0
+    // Refilled by every run (the loops read a run's logits before the next run).
+    private val decodeLogits = FloatArray(maxTimeIndex * numOfTokenIds * LOGITS_PER_TOKEN)
+    private val decode1Logits = FloatArray(maxTimeIndex * LOGITS_PER_TOKEN)
+
+    fun run(signature: String, tokenIds: IntArray): FloatArray {
+      if (calls.size >= maxRuns) throw LoopDidNotEnd()
+      val run = calls.size
+      calls.add(Call(signature, tokenIds.toList(), inputStatesBuffersIndex))
+      val slots = if (signature == DECODE_1) 1 else numOfTokenIds
+      val logits = if (signature == DECODE_1) decode1Logits else decodeLogits
+      logits.fill(0.0f)
+      for (t in 0 until maxTimeIndex) {
+        for (slot in 0 until slots) {
+          val choice = choose(run, t, slot)
+          val base = (t * slots + slot) * LOGITS_PER_TOKEN
+          logits[base + choice.token] = 1.0f
+          logits[base + VOCAB + choice.duration] = 1.0f
+        }
+      }
+      return logits
+    }
+
+    /** The extracted loop's view of this model. */
+    fun network() =
+      object : TdtGreedyLoop.Network {
+        override fun run(stateful: Boolean, tokenIds: IntArray) =
+          run(if (stateful) DECODE_1 else DECODE, tokenIds)
+
+        override fun adoptStates() {
+          inputStatesBuffersIndex = 1 - inputStatesBuffersIndex
+        }
+      }
+  }
+
+  private class LoopDidNotEnd : RuntimeException()
+
+  /**
+   * TdtDecoder.decode as of 5f23093f (= upstream d15f8ae9, last changed by 8a32fa03), line for
+   * line, with its CompiledModel calls (writeInt, run, readFloat) replaced by [FakeModel.run] and
+   * its state-buffer swap kept: the reference the extracted loop has to match with the fix off.
+   */
+  private fun upstreamDecode(
+    model: FakeModel,
+    hasDecode1: Boolean,
+    maxTimeIndex: Int = model.maxTimeIndex,
+    numOfTokenIds: Int = model.numOfTokenIds,
+    numOfLogitsPerToken: Int = LOGITS_PER_TOKEN,
+    blankTokenId: Int = BLANK,
+    decodeStartTokenId: Int = BLANK,
+  ): List<Pair<Int, Int>> =
+    sequence {
+        var inferenceSignature = DECODE
+        var numOfInferenceTokenIds = numOfTokenIds
+        var inferenceTokenIds = IntArray(numOfTokenIds) { 0 }
+        inferenceTokenIds[0] = decodeStartTokenId
+
+        var tokenIndex: Int = 0
+        var timeIndex: Int = 0
+        while (timeIndex < maxTimeIndex) {
+          val logits = model.run(inferenceSignature, inferenceTokenIds)
+          val startIndexInCurrentTimeIndex = timeIndex * numOfInferenceTokenIds * numOfLogitsPerToken
+          // Do argmax among the logits of the current token.
+          val startIndexOfTokenId = startIndexInCurrentTimeIndex + tokenIndex * numOfLogitsPerToken
+          val endIndexOfDuration =
+            startIndexInCurrentTimeIndex + (tokenIndex + 1) * numOfLogitsPerToken
+          val endIndexOfTokenId = endIndexOfDuration - NUM_DURATIONS
+          val tokenId =
+            ((startIndexOfTokenId until endIndexOfTokenId).maxByOrNull { logits[it] }
+              ?: startIndexOfTokenId) - startIndexOfTokenId
+          if (tokenId != blankTokenId) {
+            yield(Pair(tokenId, timeIndex))
+            if (numOfInferenceTokenIds > 1) {
+              tokenIndex++
+              if (tokenIndex < numOfInferenceTokenIds) {
+                // Still room in the stateless token array.
+              } else if (hasDecode1) { // Switch to decode_1 for stateful decoding.
+                inferenceSignature = DECODE_1
+                numOfInferenceTokenIds = 1
+                inferenceTokenIds = IntArray(1) { 0 }
+                tokenIndex = 0
+              } else { // Stateless decoding reached the max token size.
+                break
+              }
+            }
+            inferenceTokenIds[tokenIndex] = tokenId
+          }
+
+          val duration =
+            ((endIndexOfTokenId until endIndexOfDuration).maxByOrNull { logits[it] }
+              ?: endIndexOfTokenId) - endIndexOfTokenId
+          timeIndex += if (duration == 0 && tokenId == blankTokenId) 1 else duration
+
+          if (numOfInferenceTokenIds == 1 && tokenId != blankTokenId) {
+            model.inputStatesBuffersIndex = 1 - model.inputStatesBuffersIndex
+          }
+        }
+
+        yield(Pair(SpeechRecognizer.END_OF_SEQUENCE, maxTimeIndex))
+      }
+      .toList()
+
+  private fun loopDecode(
+    model: FakeModel,
+    hasDecode1: Boolean,
+    timeLimit: Int = model.maxTimeIndex,
+    maxSymbolsPerStep: Int = TdtGreedyLoop.NO_SYMBOL_CAP,
+    stats: TdtGreedyLoop.Stats = TdtGreedyLoop.Stats(),
+  ): List<Pair<Int, Int>> =
+    TdtGreedyLoop.decode(
+        model.network(),
+        model.maxTimeIndex,
+        model.numOfTokenIds,
+        LOGITS_PER_TOKEN,
+        NUM_DURATIONS,
+        blankTokenId = BLANK,
+        startTokenId = BLANK,
+        hasDecode1 = hasDecode1,
+        timeLimit = timeLimit,
+        maxSymbolsPerStep = maxSymbolsPerStep,
+        stats = stats,
+      )
+      .toList()
+
+  /**
+   * Random predictions, fixed by [seed] and different at every run, time index and slot: blank
+   * with [pBlank], duration 0 with [pZero].
+   */
+  private fun randomChoice(seed: Int, pBlank: Double, pZero: Double) = { run: Int, t: Int, slot: Int ->
+    val h = mix(seed, run, t, slot)
+    val token = if ((h and 0xFFFF) / 65536.0 < pBlank) BLANK else ((h ushr 16) and 0xFFFF).toInt() % BLANK
+    val duration =
+      if (((h ushr 32) and 0xFFFF) / 65536.0 < pZero) 0
+      else 1 + ((h ushr 48) and 0xFFFF).toInt() % (NUM_DURATIONS - 1)
+    Choice(token, duration)
+  }
+
+  /** A 64-bit hash of four ints (SplitMix64's finalizer after each). */
+  private fun mix(a: Int, b: Int, c: Int, d: Int): Long {
+    var h = 0x2545F4914F6CDD1DL
+    for (x in intArrayOf(a, b, c, d)) {
+      h = (h xor x.toLong()) * -0x40a7b892e31b1a47L
+      h = (h xor (h ushr 27)) * -0x6b2fb644ecceee15L
+      h = h xor (h ushr 31)
+    }
+    return h
+  }
+
+  /** The same prediction at every position of a run, by run number. */
+  private fun byRun(script: (run: Int) -> Choice) = { run: Int, _: Int, _: Int -> script(run) }
+
+  // (c) Off: the extracted loop is the app's loop.
+
+  @Test
+  fun fixOff_sameTokensAndSameNetworkRunsAsUpstream() {
+    var cases = 0
+    var tokens = 0
+    var stateful = 0
+    for (maxTimeIndex in listOf(1, 7, 63, 375)) {
+      for (numOfTokenIds in listOf(1, 2, 4)) {
+        for (hasDecode1 in listOf(true, false)) {
+          for ((pBlank, pZero) in listOf(0.5 to 0.3, 0.8 to 0.5, 0.2 to 0.6)) {
+            for (seed in 0 until if (maxTimeIndex == 375) 5 else 25) {
+              val choose = randomChoice(seed, pBlank, pZero)
+              val upstreamModel = FakeModel(maxTimeIndex, numOfTokenIds, choose)
+              val expected = upstreamDecode(upstreamModel, hasDecode1)
+              val model = FakeModel(maxTimeIndex, numOfTokenIds, choose)
+              val actual = loopDecode(model, hasDecode1)
+              assertEquals(expected, actual)
+              assertEquals(upstreamModel.calls, model.calls)
+              assertEquals(upstreamModel.inputStatesBuffersIndex, model.inputStatesBuffersIndex)
+              cases++
+              tokens += expected.size - 1
+              stateful += model.calls.count { it.signature == DECODE_1 }
+            }
+          }
+        }
+      }
+    }
+    // The cases reach both signatures and emit tokens (the comparison is not empty).
+    assertEquals(3 * 3 * 2 * 3 * 25 + 3 * 2 * 3 * 5, cases)
+    assertTrue(tokens > 2_000)
+    assertTrue(stateful > 300)
+  }
