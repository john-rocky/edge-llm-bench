+/**
+ * Runs the app's file-transcription pipeline over a manifest of WAV files, one utterance after the
+ * other in one process, and writes one JSONL row per utterance (edge-llm-bench
+ * docs/asr-litert-app-v1.md).
+ *
+ * The pipeline is MainActivity's file path at d15f8ae9, copied below with timing hooks and without
+ * the UI: FileAudioSource (5 s or 30 s windows, 2 s overlap) -> MelSpectroProcessor ->
+ * LiteRtRunner + TdtDecoder -> LevenshteinTokenMerger, in the activity's three coroutines and
+ * channels. The model is built once per process the way preparePipeline builds it.
+ *
+ * Arguments (am instrument -e <name> <value>):
+ * - model: model_metadata.json key, e.g. parakeet-tdt-0.6b-v3 or parakeet-tdt-0.6b-v3-30s
+ * - accelerator: cpu, gpu or npu
+ * - manifest: manifest TSV on the phone (id, WAV path relative to the manifest, seconds)
+ * - every: keep the rows at index 0, every, 2 * every, ... (4 = S4); default 1
+ * - limit: keep only the first N rows of that selection; default 0 = all
+ * - start_after: resume after this id (the host restarts the run after a crash or a hang)
+ * - failed_id, failed_kind: the utterance the previous process died on; written as an error row
+ * - out: output directory; default <external files dir>/bench
+ * - tag: output file stem; <tag>.jsonl, <tag>.vmhwm.log, <tag>.load-logcat.txt, <tag>.done
+ * - load_label: cold or warm, copied to the header (the host knows the order of processes)
+ * - foreground: true keeps MainActivity in the foreground for the whole run
+ * - app_commit: the source commit the APK was built from, copied to the header
+ */
+@RunWith(AndroidJUnit4::class)
+class AsrBenchTest {
+
+  /** What MainActivity.preparePipeline builds, plus the time each part took. */
+  private class Pipeline(
+    val audioPreprocessor: AudioPreprocessor,
+    val tokenizer: Tokenizer,
+    val speechRecognizer: SpeechRecognizer,
+    val modelInputInterval: Duration,
+    val preprocessorMs: Double,
+    val tokenizerMs: Double,
+    val loadMs: Double,
+  ) : AutoCloseable {
+    override fun close() {
+      audioPreprocessor.close()
+      speechRecognizer.close()
+      tokenizer.close()
+    }
+  }
+
+  /** Per-window times of one utterance; each list is written by one coroutine only. */
+  private class WindowTimes {
+    val melMs = ArrayList<Double>()
+    val encodeMs = ArrayList<Double>()
+    val decodeMs = ArrayList<Double>()
+    val tokens = ArrayList<Int>()
+  }
+
+  @Test
+  fun transcribeManifest() {
+    val context = InstrumentationRegistry.getInstrumentation().targetContext
+    val args = InstrumentationRegistry.getArguments()
+    val modelKey = args.getString("model") ?: "parakeet-tdt-0.6b-v3"
+    val acceleratorName = (args.getString("accelerator") ?: "cpu").lowercase(Locale.ROOT)
+    val accelerator =
+      when (acceleratorName) {
+        "cpu" -> Accelerator.CPU
+        "gpu" -> Accelerator.GPU
+        "npu" -> Accelerator.NPU
+        else -> throw IllegalArgumentException("accelerator must be cpu, gpu or npu")
+      }
+    val manifestFile = File(requireNotNull(args.getString("manifest")) { "manifest is required" })
+    val every = args.int("every", 1)
+    val limit = args.int("limit", 0)
+    val startAfter = args.getString("start_after")
+    val failedId = args.getString("failed_id")
+    val outDir =
+      File(args.getString("out") ?: File(context.getExternalFilesDir(null), "bench").path).apply {
+        mkdirs()
+      }
+    val tag = args.getString("tag") ?: "$modelKey-$acceleratorName"
+    val foreground = args.getString("foreground") == "true"
+
+    val selection =
+      BenchManifest.stride(BenchManifest.parse(manifestFile.readText(), manifestFile.parent), every)
+        .let { if (limit > 0) it.take(limit) else it }
+    val todo = if (startAfter != null) BenchManifest.after(selection, startAfter) else selection
+    val jsonl = FileOutputStream(File(outDir, "$tag.jsonl"), true)
+    fun emit(line: String) {
+      jsonl.write((line + "\n").toByteArray())
+      jsonl.flush()
+    }
+
+    val processStart = SystemClock.elapsedRealtimeNanos()
+    val sampler = MemorySampler(File(outDir, "$tag.vmhwm.log"), processStart).start()
+    val scenario = if (foreground) ActivityScenario.launch(MainActivity::class.java) else null
+    val thermalStart = thermalStatus(context)
+    val batteryStart = batteryCelsius(context)
+    Log.i(TAG, "start tag=$tag model=$modelKey accelerator=$acceleratorName todo=${todo.size}")
+
+    if (failedId != null) {
+      // The previous process of this run died on this utterance (watchdog or crash).
+      val row = selection.first { it.id == failedId }
+      emit(
+        BenchJson.utterance(
+          UtteranceResult(
+            row.id,
+            "",
+            row.seconds,
+            0.0,
+            error = args.getString("failed_kind") ?: "crash",
+          )
+        )
+      )
+    }
+
+    val modelConfig =
+      context.assets.open(MODEL_METADATA_PATH).bufferedReader().use { it.readText() }.let {
+        ModelMetadataManager(it).getModelConfig(modelKey)
+      }
+    val pipeline = runBlocking(Dispatchers.IO) { preparePipeline(context, modelKey, modelConfig, accelerator) }
+    val modelFile =
+      File(
+        context.filesDir,
+        if (accelerator == Accelerator.NPU) modelConfig.npuModelPath else modelConfig.modelPath,
