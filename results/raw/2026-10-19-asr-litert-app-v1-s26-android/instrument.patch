+package com.google.ai.edge.examples.asr.bench
+
+import com.google.ai.edge.examples.asr.Postprocessor
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.junit.runners.JUnit4
+
+@RunWith(JUnit4::class)
+class BenchIoTest {
+
+  private fun rows(n: Int) = (0 until n).map { ManifestRow("utt-$it", "/sets/utt-$it.wav", 1.0 + it) }
+
+  @Test
+  fun parse_readsThreeColumnsAndResolvesRelativePaths() {
+    val text = "a-1\ta-1.wav\t3.5\n\nb-2\t/abs/b-2.wav\t12.25\r\n"
+    val parsed = BenchManifest.parse(text, "/sdcard/sets")
+    assertEquals(
+      listOf(
+        ManifestRow("a-1", "/sdcard/sets/a-1.wav", 3.5),
+        ManifestRow("b-2", "/abs/b-2.wav", 12.25),
+      ),
+      parsed,
+    )
+  }
+
+  @Test(expected = IllegalArgumentException::class)
+  fun parse_rejectsAMissingColumn() {
+    BenchManifest.parse("a-1\ta-1.wav\n")
+  }
+
+  @Test(expected = IllegalArgumentException::class)
+  fun parse_rejectsSecondsThatAreNotANumber() {
+    BenchManifest.parse("a-1\ta-1.wav\tlong\n")
+  }
+
+  @Test
+  fun stride_s4KeepsEveryFourthRowFromTheFirst() {
+    // LibriSpeech test-clean: 2620 utterances -> S4 = 655 (index 0, 4, ..., 2616).
+    val s4 = BenchManifest.stride(rows(2620), 4)
+    assertEquals(655, s4.size)
+    assertEquals("utt-0", s4.first().id)
+    assertEquals("utt-4", s4[1].id)
+    assertEquals("utt-2616", s4.last().id)
+    assertEquals(rows(2620), BenchManifest.stride(rows(2620), 1))
+  }
+
+  @Test(expected = IllegalArgumentException::class)
+  fun stride_rejectsZero() {
+    BenchManifest.stride(rows(3), 0)
+  }
+
+  @Test
+  fun after_resumesBehindTheGivenId() {
+    val s4 = BenchManifest.stride(rows(20), 4)
+    assertEquals(listOf("utt-12", "utt-16"), BenchManifest.after(s4, "utt-8").map { it.id })
+    assertTrue(BenchManifest.after(s4, "utt-16").isEmpty())
+  }
+
+  @Test(expected = IllegalArgumentException::class)
+  fun after_rejectsAnIdOutsideTheSelection() {
+    BenchManifest.after(BenchManifest.stride(rows(20), 4), "utt-1")
+  }
+
+  @Test
+  fun transcript_isWhatTheActivityShowsAtTheEnd() {
+    val t = TranscriptAccumulator()
+    t.add(Postprocessor.DecodedText("", "hello wor"))
+    t.add(null) // "too short" updates leave the text as it is
+    t.add(Postprocessor.DecodedText("hello", "world and"))
+    t.add(Postprocessor.DecodedText("world", "and more"))
+    assertEquals("hello world and more", t.text())
+
+    val silenceAtTheEnd = TranscriptAccumulator()
+    silenceAtTheEnd.add(Postprocessor.DecodedText("", "one two"))
+    silenceAtTheEnd.add(Postprocessor.DecodedText("one two", ""))
+    assertEquals("one two", silenceAtTheEnd.text())
+
+    assertEquals("", TranscriptAccumulator().text())
+  }
+
+  @Test
+  fun utterance_rowHasTheFieldsScorePyReads() {
+    val row =
+      JSONObject(
+        BenchJson.utterance(
+          UtteranceResult(
+            id = "1089-134686-0000",
+            text = "he said \"yes\" — then left",
+            audioSeconds = 10.435,
+            processingSeconds = 0.4567891,
+            melMs = listOf(12.3456, 11.0),
+            encodeMs = listOf(80.0, 79.5),
+            decodeMs = listOf(20.25, 0.5),
+            tokens = listOf(9, 0),
+          )
+        )
+      )
+    assertEquals("utterance", row.getString("type"))
+    assertEquals("1089-134686-0000", row.getString("id"))
+    assertEquals("he said \"yes\" — then left", row.getString("text"))
+    assertEquals(10.435, row.getDouble("audio_seconds"), 0.0)
+    assertEquals(0.457, row.getDouble("processing_seconds"), 0.0)
+    assertEquals(2, row.getInt("windows"))
+    assertEquals(1, row.getInt("empty_windows"))
+    assertEquals(12.346, row.getJSONArray("mel_ms").getDouble(0), 0.0)
+    assertFalse(row.has("error"))
+
+    val failed =
+      JSONObject(BenchJson.utterance(UtteranceResult("x", "", 3.0, 0.0, error = "hang")))
+    assertEquals("hang", failed.getString("error"))
+    assertEquals(0, failed.getInt("windows"))
+  }
+
+  @Test
+  fun headerAndFooter_carryATypeAndNoId() {
+    val header =
+      JSONObject(
+        BenchJson.header(
+          mapOf(
+            "model_name" to "parakeet-tdt-0.6b-v3",
+            "load_seconds" to 1.25,
+            "native_libs" to mapOf("libLiteRt.so" to "abc"),
+            "start_after" to null,
+            "rtf" to Double.NaN,
+          )
+        )
+      )
+    assertEquals("header", header.getString("type"))
+    assertFalse(header.has("id"))
+    assertEquals(1.25, header.getDouble("load_seconds"), 0.0)
+    assertEquals("abc", header.getJSONObject("native_libs").getString("libLiteRt.so"))
+    assertTrue(header.isNull("start_after"))
+    assertTrue(header.isNull("rtf"))
+    assertEquals("footer", JSONObject(BenchJson.footer(mapOf("utterances_done" to 3))).getString("type"))
+  }
+
+  @Test(expected = IllegalArgumentException::class)
+  fun header_rejectsAnId() {
+    BenchJson.header(mapOf("id" to "x"))
+  }
+
+  @Test
+  fun median_oddEvenEmpty() {
+    assertEquals(2.0, median(listOf(3.0, 1.0, 2.0))!!, 0.0)
+    assertEquals(2.5, median(listOf(4.0, 1.0, 2.0, 3.0))!!, 0.0)
+    assertNull(median(emptyList()))
+  }
+}
