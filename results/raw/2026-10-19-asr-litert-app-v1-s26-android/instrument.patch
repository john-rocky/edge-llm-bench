+    // delegate that took the graph), kept before the merger's per-token lines wrap the ring buffer.
+    dumpOwnLogcat(File(outDir, "$tag.load-logcat.txt"))
+    emit(
+      BenchJson.header(
+        linkedMapOf(
+          "harness" to BenchJson.HARNESS,
+          "tag" to tag,
+          "model_name" to modelKey,
+          "backend" to acceleratorName,
+          "num_threads" to LiteRtRunner.CPU_NUM_THREADS,
+          "litert_version" to BuildConfig.LITERT_VERSION,
+          "app_commit" to args.getString("app_commit"),
+          "model_file" to modelFile.path,
+          "model_bytes" to modelFile.length(),
+          "input_ms" to modelConfig.inputMilliseconds,
+          "overlap_ms" to FILE_AUDIO_CHUNK_OVERLAP_DURATION.inWholeMilliseconds,
+          "max_levenshtein_distance" to FILE_MAX_LEVENSHTEIN_DISTANCE,
+          "gpu_precision" to
