+
+  // ---- MainActivity.preparePipeline (d15f8ae9), timed, on the IO dispatcher as in the activity.
+
+  private fun preparePipeline(
+    context: Context,
+    modelKey: String,
+    modelConfig: ModelConfig,
+    accelerator: Accelerator,
+  ): Pipeline {
+    var t = SystemClock.elapsedRealtimeNanos()
+    val logMelSpectro = modelConfig.logMelSpectro
+    val audioPreprocessor =
+      if (logMelSpectro != null) {
+        MelSpectroProcessor(SAMPLING_RATE, logMelSpectro)
+      } else {
+        DummyAudioProcessor()
+      }
+    val preprocessorMs = msSince(t)
+    t = SystemClock.elapsedRealtimeNanos()
+    val tokenizer = HuggingfaceTokenizer(context, modelConfig)
+    val tokenizerMs = msSince(t)
+    val decoderFactory: (CompiledModel, ModelConfig) -> LiteRtRunner.Decoder =
+      when {
+        modelKey.contains("-ctc-") -> { _, _ -> CtcDecoder(tokenizer.vocabSize) }
+        modelKey.contains("-tdt") -> { model, config -> TdtDecoder(model, config) }
+        else -> { model, config -> LiteRtRunner.DefaultDecoder(model, config) }
+      }
+    t = SystemClock.elapsedRealtimeNanos()
+    val speechRecognizer = LiteRtRunner(context, modelConfig, accelerator, decoderFactory)
+    val loadMs = msSince(t)
+    return Pipeline(
+      audioPreprocessor,
+      tokenizer,
+      speechRecognizer,
+      modelConfig.inputMilliseconds.milliseconds,
+      preprocessorMs,
+      tokenizerMs,
+      loadMs,
+    )
+  }
+
+  // ---- MainActivity.processFileAudio and transcribeAudio (d15f8ae9) with the wall clock of one
+  // utterance: from opening the WAV until the merger has taken the last token.
+
+  private suspend fun processFileAudio(
+    wav: File,
+    pipeline: Pipeline,
+    times: WindowTimes,
+  ): Pair<String, Double> {
+    val start = SystemClock.elapsedRealtimeNanos()
+    val text =
+      FileInputStream(wav).use { inputStream ->
+        FileAudioSource(
+            inputStream,
+            SAMPLING_RATE,
+            pipeline.modelInputInterval,
+            FILE_AUDIO_CHUNK_OVERLAP_DURATION,
+          )
+          .use { audioSource ->
+            transcribeAudio(
+              audioSource,
+              (FILE_AUDIO_CHUNK_OVERLAP_DURATION / pipeline.modelInputInterval).toFloat(),
+              FILE_MAX_LEVENSHTEIN_DISTANCE,
+              pipeline,
+              times,
+            )
+          }
+      }
+    return Pair(text, (SystemClock.elapsedRealtimeNanos() - start) / 1e9)
+  }
+
+  private suspend fun transcribeAudio(
+    audioSource: AudioSource,
+    overlapRatio: Float,
+    maxLevenshteinDistance: Int,
+    pipeline: Pipeline,
+    times: WindowTimes,
+  ): String {
+    val preprocessedChannel = Channel<FloatArray>(Channel.BUFFERED)
+    val tokenChannel = Channel<Pair<Int, Int>>(Channel.BUFFERED)
+    val transcript = TranscriptAccumulator()
+    LevenshteinTokenMerger(
+        pipeline.tokenizer,
+        overlapRatio,
+        maxLevenshteinDistance = maxLevenshteinDistance,
+      )
+      .use { postprocessor ->
+        coroutineScope {
+          scheduleAudioPreprocessing(
+            audioSource,
+            pipeline.audioPreprocessor,
+            preprocessedChannel,
+            times,
+          )
+          scheduleSpeechRecognition(pipeline.speechRecognizer, preprocessedChannel, tokenChannel, times)
+          scheduleTokenPostprocessing(postprocessor, tokenChannel, transcript)
+        }
+      }
+    return transcript.text()
+  }
+
+  private fun CoroutineScope.scheduleAudioPreprocessing(
+    audioSource: AudioSource,
+    audioPreprocessor: AudioPreprocessor,
+    preprocessedChannel: Channel<FloatArray>,
+    times: WindowTimes,
+  ) =
+    launch(Dispatchers.IO) {
+      try {
+        for (audioChunk in audioSource.getAudioData()) {
+          val t = SystemClock.elapsedRealtimeNanos()
+          val preprocessed = audioPreprocessor.process(audioChunk)
+          times.melMs.add(msSince(t))
+          preprocessedChannel.send(preprocessed)
+          yield()
+        }
+      } finally {
+        preprocessedChannel.close()
+      }
+    }
+
+  private fun CoroutineScope.scheduleSpeechRecognition(
+    speechRecognizer: SpeechRecognizer,
+    preprocessedChannel: Channel<FloatArray>,
+    tokenChannel: Channel<Pair<Int, Int>>,
+    times: WindowTimes,
+  ) =
+    launch(Dispatchers.IO) {
+      try {
+        for (preprocessed in preprocessedChannel) {
+          // recognize() runs the encoder; the decoder runs lazily inside the returned sequence, so
+          // the decode time is the time spent in the iterator's own calls (not in the channel).
+          var t = SystemClock.elapsedRealtimeNanos()
+          val tokenSequence = speechRecognizer.recognize(preprocessed)
+          times.encodeMs.add(msSince(t))
+          var decodeNs = 0L
+          var tokens = 0
+          val iterator = tokenSequence.iterator()
+          while (true) {
+            t = SystemClock.elapsedRealtimeNanos()
+            val hasNext = iterator.hasNext()
+            val next = if (hasNext) iterator.next() else null
+            decodeNs += SystemClock.elapsedRealtimeNanos() - t
+            if (next == null) break
+            val (tokenId, timestamp) = next
+            if (tokenId != SpeechRecognizer.END_OF_SEQUENCE) tokens++
+            tokenChannel.send(Pair(tokenId, timestamp))
+            if (tokenId == SpeechRecognizer.END_OF_SEQUENCE) break
+          }
+          times.decodeMs.add(decodeNs / 1e6)
+          times.tokens.add(tokens)
+          yield()
+        }
+      } finally {
+        tokenChannel.close()
+      }
+    }
+
+  private fun CoroutineScope.scheduleTokenPostprocessing(
+    postprocessor: Postprocessor,
+    tokenChannel: Channel<Pair<Int, Int>>,
+    transcript: TranscriptAccumulator,
+  ) =
+    launch(Dispatchers.Default) {
+      // The activity hands every non-null result to updateTranscriptionUI on the main thread;
+      // the accumulator keeps the text that view would show.
+      for ((tokenId, timestamp) in tokenChannel) {
+        transcript.add(postprocessor.decode(tokenId, timestamp))
+      }
+    }
+
+  // ---- Device state and memory.
+
+  /**
+   * Samples VmRSS and VmHWM of this process, the CPUs it may run on and every cpufreq policy's
+   * ceiling (scaling_max_freq, when readable) every second into a log; keeps the maxima, the
+   * lowest ceiling per policy and every Cpus_allowed_list seen (edge-llm-bench cpu-cap-rule).
+   */
+  private class MemorySampler(private val log: File, private val origin: Long) {
+    private val stop = AtomicBoolean(false)
+    private var maxRss = 0L
+    private var maxHwm = 0L
+    private val policies =
+      File("/sys/devices/system/cpu/cpufreq")
+        .listFiles { f -> f.name.startsWith("policy") }
+        .orEmpty()
+        .sortedBy { it.name }
+    private val minCeilingKhz = HashMap<String, Long>()
+    private val cpusAllowed = LinkedHashSet<String>()
+    private lateinit var thread: Thread
+
+    fun start(): MemorySampler {
+      thread =
+        Thread {
+            log.appendText(
+              "# elapsed_ms\tVmRSS_kB\tVmHWM_kB\tCpus_allowed_list" +
+                policies.joinToString("") { "\t${it.name}_scaling_max_kHz" } +
+                " (pid ${Process.myPid()})\n"
+            )
+            while (!stop.get()) {
+              val rss = procStatusKb("VmRSS") ?: 0L
+              val hwm = procStatusKb("VmHWM") ?: 0L
+              val cpus = procStatusText("Cpus_allowed_list") ?: ""
+              val ceilings = policies.map { readLong(File(it, "scaling_max_freq")) }
+              synchronized(this) {
+                maxRss = maxOf(maxRss, rss)
+                maxHwm = maxOf(maxHwm, hwm)
+                if (cpus.isNotEmpty()) cpusAllowed.add(cpus)
+                policies.zip(ceilings).forEach { (p, khz) ->
+                  if (khz != null) minCeilingKhz[p.name] = minOf(minCeilingKhz[p.name] ?: khz, khz)
+                }
+              }
+              log.appendText(
+                "${(SystemClock.elapsedRealtimeNanos() - origin) / 1_000_000}\t$rss\t$hwm\t$cpus" +
+                  ceilings.joinToString("") { "\t${it ?: "-"}" } +
+                  "\n"
+              )
+              try {
+                Thread.sleep(1000)
+              } catch (e: InterruptedException) {
+                break
+              }
+            }
+          }
+          .apply {
+            isDaemon = true
+            name = "vmhwm-sampler"
+            start()
+          }
+      return this
+    }
+
+    /** Returns (max VmRSS kB, max VmHWM kB). */
+    fun stop(): Pair<Long, Long> {
+      stop.set(true)
+      thread.interrupt()
+      thread.join(2000)
+      return synchronized(this) { Pair(maxRss, maxHwm) }
+    }
+
+    /** Per policy: its CPUs, hardware maximum and the lowest ceiling read (null = unreadable). */
+    fun cpuCeilings(): Map<String, Map<String, Any?>> =
+      synchronized(this) {
+        policies.associate {
+          it.name to
+            linkedMapOf(
+              "cpus" to readText(File(it, "related_cpus")),
+              "hw_khz" to readLong(File(it, "cpuinfo_max_freq")),
+              "min_khz" to minCeilingKhz[it.name],
+            )
+        }
+      }
+
+    fun cpusAllowedSeen(): List<String> = synchronized(this) { cpusAllowed.toList() }
+  }
+
+  private companion object {
+    const val TAG = "AsrBench"
+    const val MODEL_METADATA_PATH = "model_metadata.json"
+
+    // MainActivity's file-path constants (d15f8ae9).
+    const val SAMPLING_RATE = 16000
+    val FILE_AUDIO_CHUNK_OVERLAP_DURATION = 2.seconds
+    const val FILE_MAX_LEVENSHTEIN_DISTANCE = 5
+
+    fun Bundle.int(name: String, default: Int) = getString(name)?.toInt() ?: default
+
+    fun msSince(startNs: Long) = (SystemClock.elapsedRealtimeNanos() - startNs) / 1e6
+
+    fun procStatusText(key: String): String? =
+      try {
+        File("/proc/self/status").useLines { lines ->
+          lines.firstOrNull { it.startsWith("$key:") }?.substringAfter(':')?.trim()
+        }
+      } catch (e: Exception) {
+        null
+      }
+
+    fun procStatusKb(key: String): Long? =
+      procStatusText(key)?.split(Regex("\\s+"))?.firstOrNull()?.toLongOrNull()
+
+    fun readText(file: File): String? =
+      try {
+        file.readText().trim()
+      } catch (e: Exception) {
+        null
+      }
+
+    fun readLong(file: File): Long? = readText(file)?.toLongOrNull()
+
+    /** Appends `logcat -d --pid=<this process>` to [file] (an app may read its own log). */
+    fun dumpOwnLogcat(file: File) {
+      try {
+        val process =
+          ProcessBuilder("logcat", "-d", "-v", "threadtime", "--pid=${Process.myPid()}")
+            .redirectErrorStream(true)
+            .start()
+        val text = process.inputStream.bufferedReader().use { it.readText() }
+        process.waitFor()
+        file.appendText("# logcat --pid=${Process.myPid()} at ${iso(Date())}\n$text")
+      } catch (e: Exception) {
+        Log.w(TAG, "logcat dump failed", e)
+      }
+    }
+
+    fun thermalStatus(context: Context): Int =
+      (context.getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus
+
+    fun batteryCelsius(context: Context): Double? =
+      context
+        .registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+        ?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, Int.MIN_VALUE)
+        ?.takeIf { it != Int.MIN_VALUE }
+        ?.let { it / 10.0 }
+
+    /** SHA-256 over the bytes of [files] in order (one file: its own hash). */
+    fun sha256(files: List<File>): String {
+      val digest = MessageDigest.getInstance("SHA-256")
+      val buffer = ByteArray(1 shl 20)
+      for (file in files) {
+        FileInputStream(file).use { input ->
+          while (true) {
+            val n = input.read(buffer)
+            if (n < 0) break
+            digest.update(buffer, 0, n)
+          }
+        }
+      }
+      return digest.digest().joinToString("") { "%02x".format(it) }
+    }
+
+    fun iso(date: Date): String =
+      SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US)
+        .apply { timeZone = TimeZone.getTimeZone("UTC") }
+        .format(date)
+  }
+}
