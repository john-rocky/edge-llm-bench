<plist version="1.0">
<!-- No entitlements: for a wildcard development profile (e.g. a lab Mac's), which cannot carry
     BenchmarkApp.entitlements' memory entitlements. build_xctest.sh selects it for ENTITLEMENTS="";
     an empty CODE_SIGN_ENTITLEMENTS does not drop them. Models under ~1.5 GB do not need them. -->
<dict/>
</plist>
