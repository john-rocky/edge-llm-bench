#!/usr/bin/env python3
"""bench — the operations entrypoint for the standing matrix.

  ./bench matrix  <cells-file> [--platform mac|iphone|android] [--campaign NAME]
  ./bench matrix  <cells-file> --ddp <DDP device id> [--campaign NAME] [--dry-run]   # android/ddp/run_ddp.py
                  [--project <Cloud project>] [--bucket gs://<bucket>]   # default: $BENCH_DDP_PROJECT /
                                                                         # $BENCH_DDP_BUCKET, else run_ddp.py's
                  [--engine-build <label>]   # a litert-lm pins entry instead of android_pins' tag
  ./bench autopilot --ddp <DDP device id> [--project <p>] [--bucket gs://<b>] [--cells FILE] [--runs N]
                  [--dry-run] [--no-commit]   # one lab-unit sitting by hand, end to end (scripts/autopilot.py)
  ./bench regress <cells-file> --engine <arm> [--version vX] --baseline <selector>
                  [--platform ...] [--campaign NAME]
  ./bench profile <cells-file> [--campaign NAME] [--max-num-tokens A,B,C] [--allow-large-context]
                  # LiteRT-LM per-op profiling: control + --enable_profiling pair per cell
                  # -> <campaign>/profiles/PROFILE.md (android/bench/run_profile.py)
  ./bench release-watch
  ./bench dashboard                         # render DASHBOARD.md (local) from results/summary
  ./bench dashboard-job <device-key|auto>   # one slot of the recurring job (docs/dashboard-recurring-job-v1.md)

(The archive repo's `./reproduce` is the backward-looking "published table ->
pinned command" registry; this file is the forward-looking driver.) matrix =
validate -> platform runners -> build_summary -> render_results ->
render_leaderboard. regress = matrix into a fresh campaign, then
regression_report (exit 1 on REGRESSION). manual=1 cells (energy) are never
run here — the unplug discipline is a human step (docs/OPERATIONS.md).
dashboard-job = preflight -> anchors -> session admission -> matrix ->
SESSION.json -> dashboard render; exit codes in scripts/dashboard_job.py.
autopilot = a Developer Device Platform lab unit's sitting (the job's own) ->
check and local commit (scripts/dashboard_post.py) -> DASHBOARD.md -> the
team page's red points -> the retake / bisect requests, on a host with no
phone; docs/dashboard-autopilot-v1.md section 10.
"""
import argparse
import datetime
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable

RUNNERS = {  # platform -> (runner argv builder)
    "mac": lambda cells: [os.path.join(ROOT, "scripts", "bench_matrix_mac.sh"), "run", cells],
    "iphone": lambda cells: [os.path.join(ROOT, "scripts", "bench_matrix_iphone.sh"), "run", cells],
    "android": lambda cells: [PY, os.path.join(ROOT, "android", "bench", "run_campaign.py"), cells],
}
# cells-file platform tokens -> runner names (ios cells run on the iphone runner)
PLATFORM_TOKEN = {"mac": "mac", "iphone": "ios", "android": "android"}


def run(cmd, env=None):
    print(f"\n$ {' '.join(cmd)}")
    e = dict(os.environ)
    if env:
        e.update(env)
    return subprocess.call(cmd, env=e)


def cells_platforms(cells_file):
    """Which platform tokens actually appear in the file (comments stripped)."""
    toks = set()
    for raw in open(cells_file):
        line = raw.split("#", 1)[0].strip()
        if line:
            toks.add(line.split()[0])
    return toks


def postprocess():
    rc = run([PY, os.path.join(ROOT, "scripts", "build_summary.py")])
    rr = os.path.join(ROOT, "scripts", "render_results.py")
    if os.path.exists(rr):  # archive repo only; the harness repo has no RESULTS.md
        rc |= run([PY, rr])
    rc |= run([PY, os.path.join(ROOT, "scripts", "render_leaderboard.py")])
    return rc


def do_ddp(args):
    """matrix --ddp: the file's Android LiteRT-LM rows as Developer Device Platform sessions
    (android/ddp/run_ddp.py); --dry-run prints the plan, calls no network and builds no summary."""
    sys.stdout.reconfigure(line_buffering=True)  # the `$ cmd` lines before the runner's output in a file
    if run([PY, os.path.join(ROOT, "scripts", "validate_cells.py"), args.cells]):
        return 2
    if args.platform and set(args.platform) != {"android"}:
        print("error: --ddp runs android rows only (drop --platform)", file=sys.stderr)
        return 2
    present = cells_platforms(args.cells)
    for token in sorted(present - {"android"}):
        print(f"skip: {token} rows are not run on DDP")
    if "android" not in present:
        print(f"error: no android cells in {args.cells} — nothing to run on DDP", file=sys.stderr)
        return 2
    campaign = f"{args.campaign or datetime.date.today().isoformat() + '-ddp-' + args.ddp}-android"
    cmd = [PY, os.path.join(ROOT, "android", "ddp", "run_ddp.py"), args.cells, "--device", args.ddp,
           "--campaign", campaign] + (["--dry-run"] if args.dry_run else [])
    # a caller that cannot pass the flags (scripts/autopilot.py, through dashboard_job.py) sets them in
    # the environment; the plan's summary line names the project and bucket the run uses
    project = args.project or os.environ.get("BENCH_DDP_PROJECT")
    bucket = args.bucket or os.environ.get("BENCH_DDP_BUCKET")
    cmd += (["--project", project] if project else []) + (["--bucket", bucket] if bucket else [])
    cmd += ["--engine-build", args.engine_build] if args.engine_build else []
    rc = run(cmd, env={"CAMPAIGN": campaign})
    if args.dry_run:
        return rc
    rc |= postprocess()
    return rc


def do_matrix(args):
    if getattr(args, "ddp", None):
        return do_ddp(args)
    if getattr(args, "dry_run", False):
        print("error: matrix --dry-run is for --ddp only", file=sys.stderr)
        return 2
    if getattr(args, "project", None) or getattr(args, "bucket", None):
        print("error: matrix --project / --bucket are for --ddp only", file=sys.stderr)
        return 2
    if getattr(args, "engine_build", None):
        print("error: matrix --engine-build is for --ddp only (an attached phone runs android_pins' tag: "
              "android/README.md, \"Build from head or a PR\")", file=sys.stderr)
        return 2
    if run([PY, os.path.join(ROOT, "scripts", "validate_cells.py"), args.cells]):
        return 2
    present = cells_platforms(args.cells)
    campaign = args.campaign or f"{datetime.date.today().isoformat()}-matrix"
    rc = 0
    ran = []
    for runner_name in (args.platform or ["mac", "iphone", "android"]):
        token = PLATFORM_TOKEN[runner_name]
        if token not in present:
            continue
        # serialized on purpose: one queue per session; never overlap device work
        rc |= run(RUNNERS[runner_name](args.cells),
                  env={"CAMPAIGN": f"{campaign}-{token}"})
        ran.append(runner_name)
    if not ran:
        # Without this, a platform/cells mismatch still rebuilt the summary and
        # LEADERBOARD from existing raw and exited 0 — looking exactly like a
        # successful capture (2026-08-26 fresh-clone rehearsal, stumble #1).
        want = ", ".join(args.platform or sorted(RUNNERS))
        print(f"error: no cells for platform(s) [{want}] in {args.cells} — "
              f"nothing was measured (file has: {', '.join(sorted(present))})",
              file=sys.stderr)
        return 2
    rc |= postprocess()
    return rc


def do_regress(args):
    campaign = args.campaign or f"{datetime.date.today().isoformat()}-regress-{args.engine}"
    m = argparse.Namespace(cells=args.cells, platform=args.platform, campaign=campaign)
    rc = do_matrix(m)
    if rc:
        print(f"capture finished with rc={rc} — diff runs anyway (failed cells "
              "stay visible; failed-runs-stay)", file=sys.stderr)
    report_cmd = [PY, os.path.join(ROOT, "scripts", "regression_report.py"),
                  "--engine", args.engine, "--version", args.version or "current",
                  "device",
                  "--baseline", args.baseline,
                  "--candidate", f"campaign:{campaign}",
                  "--anchors", os.path.join(ROOT, "matrices", "anchors.cells")]
    return run(report_cmd)


def do_profile(args):
    if run([PY, os.path.join(ROOT, "scripts", "validate_cells.py"), args.cells]):
        return 2
    if "android" not in cells_platforms(args.cells):
        print(f"error: no android cells in {args.cells} — profiling runs on the Android "
              "CLI today (docs/profiling-subcommand-design.md lists the Mac and iPhone routes)",
              file=sys.stderr)
        return 2
    campaign = args.campaign or f"{datetime.date.today().isoformat()}-profile"
    cmd = [PY, os.path.join(ROOT, "android", "bench", "run_profile.py"), args.cells]
    if args.max_num_tokens:
        cmd += ["--max-num-tokens", args.max_num_tokens]
    if args.allow_large_context:
        cmd.append("--allow-large-context")
    rc = run(cmd, env={"CAMPAIGN": f"{campaign}-android"})
    if rc in (2, 3):  # bad cells / device held by another driver: nothing was measured
        return rc
    rc |= postprocess()  # the control runs are ordinary speed rows
    return rc


def main():
    ap = argparse.ArgumentParser(prog="bench", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    m = sub.add_parser("matrix", help="run a cells file end to end")
    m.add_argument("cells")
    m.add_argument("--platform", action="append", choices=list(RUNNERS))
    m.add_argument("--campaign")
    m.add_argument("--ddp", metavar="DEVICE_ID",
                   help="run the android LiteRT-LM rows on a DDP lab phone (android/ddp/devices.json)")
    m.add_argument("--dry-run", action="store_true",
                   help="with --ddp: print jobs, sessions, pushes, args, timeouts and the estimate; no network")
    m.add_argument("--project", help="with --ddp: the Cloud project the sessions run in "
                                     "(default: $BENCH_DDP_PROJECT, else run_ddp.py's)")
    m.add_argument("--bucket", help="with --ddp: gs://<bucket> for the inputs and session outputs "
                                    "(default: $BENCH_DDP_BUCKET, else run_ddp.py's)")
    m.add_argument("--engine-build", metavar="LABEL",
                   help="with --ddp: the LiteRT-LM build android/engine-pins.json names litert-lm.LABEL, from "
                        "$BENCH_ANDROID_BIN_DIR/LABEL/, instead of android_pins' tag (android/scripts/pins_add.py)")

    p = sub.add_parser("profile", help="LiteRT-LM per-op profiling: a control + --enable_profiling "
                                       "pair per android native-benchmark cell -> profiles/PROFILE.md")
    p.add_argument("cells")
    p.add_argument("--campaign")
    p.add_argument("--max-num-tokens", help="comma-separated context sizes, one pair per size")
    p.add_argument("--allow-large-context", action="store_true",
                   help="permit sizes above 8192 on a phone (a 32771-token GPU profile rebooted the S26)")

    r = sub.add_parser("regress", help="re-capture a cells file and diff vs a baseline")
    r.add_argument("cells")
    r.add_argument("--engine", required=True, help="arm under test (report naming + anchor confound check)")
    r.add_argument("--version", help="candidate engine version label")
    r.add_argument("--baseline", required=True, help="campaign:<substr> or engine:<prefix>")
    r.add_argument("--platform", action="append", choices=list(RUNNERS))
    r.add_argument("--campaign")

    sub.add_parser("release-watch", help="compare upstream releases vs environment.lock.json pins")

    d = sub.add_parser("doctor", help="preflight: what is missing, with the fix command")
    d.add_argument("--platform", action="append", choices=list(RUNNERS) + ["ddp"])

    db = sub.add_parser("dashboard", help="render DASHBOARD.md + .dashboard/ (local, gitignored)")
    db.add_argument("--cells", help="cells file (default: matrices/dashboard-text-v1.cells)")
    db.add_argument("--stale-days", type=int)

    dj = sub.add_parser("dashboard-job", help="one device slot of the recurring job")
    dj.add_argument("device", help="key in ops/dashboard-v1/schedule.json, or 'auto'")
    dj.add_argument("--dry-run", action="store_true", help="preflight + plan only")
    dj.add_argument("--once", action="store_true", help="no busy polling / abort retry")
    dj.add_argument("--cells", help="override the cells file")
    dj.add_argument("--suffix", help="campaign-name suffix for a same-day retake (e.g. -retake)")
    dj.add_argument("--no-post", action="store_true",
                    help="print the post command, run nothing after the sitting (a person runs it after review)")

    au = sub.add_parser("autopilot", help="one DDP lab-unit sitting by hand, end to end: the sitting, the "
                                          "check and local commit, DASHBOARD.md, the red points, the requests")
    au.add_argument("--ddp", required=True, metavar="DEVICE_ID", help="a DDP catalog id (android/ddp/devices.json)")
    au.add_argument("--project", help="the Cloud project the sessions are billed to (default: run_ddp.py's)")
    au.add_argument("--bucket", help="gs://<bucket> for the inputs and session outputs (default: run_ddp.py's)")
    au.add_argument("--cells", help="the cells file (default: the lab unit's weekly file, else "
                                    "matrices/ddp-first-run.cells)")
    au.add_argument("--runs", type=int, help="runs= of every row (a copy of the cells file)")
    au.add_argument("--suffix", help="campaign-name suffix for a second sitting the same day")
    au.add_argument("--dry-run", action="store_true", help="print every step's plan; no network, nothing billed")
    au.add_argument("--no-commit", action="store_true", help="the sitting and the check; nothing committed")

    args = ap.parse_args()
    if args.cmd == "matrix":
        return do_matrix(args)
    if args.cmd == "regress":
        return do_regress(args)
    if args.cmd == "profile":
        return do_profile(args)
    if args.cmd == "doctor":
        cmd = [PY, os.path.join(ROOT, "scripts", "doctor.py")]
        for p in args.platform or []:
            cmd += ["--platform", p]
        return run(cmd)
    if args.cmd == "dashboard":
        cmd = [PY, os.path.join(ROOT, "scripts", "render_dashboard.py")]
        if args.cells:
            cmd += ["--cells", args.cells]
        if args.stale_days is not None:
            cmd += ["--stale-days", str(args.stale_days)]
        return run(cmd)
    if args.cmd == "dashboard-job":
        cmd = [PY, os.path.join(ROOT, "scripts", "dashboard_job.py"), args.device]
        if args.dry_run:
            cmd.append("--dry-run")
        if args.once:
            cmd.append("--once")
        if args.cells:
            cmd += ["--cells", args.cells]
        if args.suffix:
            cmd.append(f"--suffix={args.suffix}")   # `=` form: a suffix may start with '-'
        if args.no_post:
            cmd.append("--no-post")

        return run(cmd)
    if args.cmd == "autopilot":
        sys.stdout.reconfigure(line_buffering=True)  # the `$ cmd` line before the steps' output in a file
        cmd = [PY, os.path.join(ROOT, "scripts", "autopilot.py"), "--ddp", args.ddp]
        for flag in ("project", "bucket", "cells", "suffix"):
            if getattr(args, flag):
                cmd.append(f"--{flag}={getattr(args, flag)}")
        if args.runs is not None:
            cmd += ["--runs", str(args.runs)]
        cmd += (["--dry-run"] if args.dry_run else []) + (["--no-commit"] if args.no_commit else [])
        return run(cmd)
    return run([PY, os.path.join(ROOT, "scripts", "release_watch.py")])


if __name__ == "__main__":
    sys.exit(main())
