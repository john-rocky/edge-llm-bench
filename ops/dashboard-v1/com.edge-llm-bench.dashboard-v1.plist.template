<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd LaunchAgent for the dashboard v1 recurring job (docs/dashboard-recurring-job-v1.md).
  NOT installed by anything in this repo — enabling the scheduler is an owner decision:

    sed "s#__REPO__#$PWD#g; s#__HOME__#$HOME#g" ops/dashboard-v1/com.edge-llm-bench.dashboard-v1.plist.template \
        > ~/Library/LaunchAgents/com.edge-llm-bench.dashboard-v1.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.edge-llm-bench.dashboard-v1.plist
    launchctl print gui/$(id -u)/com.edge-llm-bench.dashboard-v1 | head      # loaded?
    launchctl bootout gui/$(id -u)/com.edge-llm-bench.dashboard-v1           # disable

  Every night at 02:00 and 05:30 local (ops/dashboard-v1/schedule.json "slots")
  a firing runs `./bench dashboard-job auto`, which measures the first free device
  that has no admitted dashboard session this week (Monday 00:00 local), oldest
  last-admitted first; the iPhone is a candidate only in the 05:30 firing
  (auto_window 05:00-08:00). One device per firing. launchd does not start a
  second instance while the 02:00 job is still running, so a long phone session
  simply absorbs the 05:30 firing. If the Mac is asleep at the time, launchd runs
  the job on the next wake (the bench Mac has sleep 0).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.edge-llm-bench.dashboard-v1</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>export PATH="__HOME__/Library/Android/sdk/platform-tools:/opt/homebrew/bin:/usr/local/bin:$PATH"; cd __REPO__ &amp;&amp; ./bench dashboard-job auto</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key><integer>2</integer>
			<key>Minute</key><integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key><integer>5</integer>
			<key>Minute</key><integer>30</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__REPO__/logs/dashboard-job/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>__REPO__/logs/dashboard-job/launchd.err</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
